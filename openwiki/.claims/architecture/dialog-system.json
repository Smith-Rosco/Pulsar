    {
      "id": "claim_cb05d5fa04da452980b6672d2f64dc07",
      "statement": "DialogService is the single host for every dialog in Pulsar: each public method marshals to the UI thread via RunOnUi, builds a DialogHostViewModel, opens one DialogHostWindow (a Wpf.Ui FluentWindow), and returns the DialogResult produced by the content view model's RequestClose callback.",
      "evidence": [
        {
          "resource": "repo://Pulsar/Pulsar/Services/DialogService.cs#L347-L373",
          "version": "repo-lines-v1:sha256:1eb7843f8196b0b48ed73984c33c1548af20789d3b59272636c3b534d835228b:"
        },
