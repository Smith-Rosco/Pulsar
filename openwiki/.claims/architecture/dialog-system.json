    {
      "id": "claim_897ee3198ea8462d8d61a2464ff7d89e",
      "statement": "DialogHostWindow is a borderless FluentWindow (WindowStyle None, ExtendsContentIntoTitleBar, Mica backdrop, ShowInTaskbar False) with a three-row grid: TitleBar bound to Title and ShowMaximizeButton, a ContentPresenter bound to Content, and a footer with tertiary (danger-styled), secondary, and primary buttons; the primary button is IsDefault and binds WizardPrimaryCommand.",
