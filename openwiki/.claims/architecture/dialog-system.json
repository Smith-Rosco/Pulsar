    {
      "id": "claim_3c98d3fe913a42a0b941b30f1e4906c9",
      "statement": "DialogService.ShowCustomAsync wires content.RequestClose to the host's CloseCommand when the content implements IDialogViewModel; the unparameterized ShowCustomAsync overload defaults to DialogSizeConstraints.Medium, and the architecture docs require callers to pass explicit constraints for custom dialogs.",
