# Repository-wide text policy: store and check out text as LF.
# This is explicit so Windows core.autocrlf settings cannot reintroduce
# CRLF-only working-tree files and recurring add/commit warnings.
* text=auto eol=lf

# Scripts are explicitly LF for cross-platform execution.
*.sh text eol=lf
*.bash text eol=lf

# Binary files - never modify
*.dll binary
*.exe binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.7z binary
