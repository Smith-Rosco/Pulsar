<?xml version="1.0" encoding="utf-8"?>
<!-- Portable NuGet sources for the Pulsar solution. This file is committed and
     must stay machine-agnostic: it deliberately references only nuget.org,
     which is what the CI runner (and any other machine) restores from.

     Machine-specific overrides (e.g. a local feed or mirror needed on a
     restricted network) must live in the user-level NuGet.Config
     (%APPDATA%\NuGet\NuGet.Config), which is NOT committed.

     History: commit b4d7e48 pinned a machine-local feed
     (C:\Users\milo\.workbuddy\tmp\nuget-feed3) and disabled nuget.org as a
     network workaround; that made every CI restore fail with NU1301 on
     runners that lack the path. The workaround moved to the user-level config
     on 2026-09-05. -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
