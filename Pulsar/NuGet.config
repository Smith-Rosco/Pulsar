<?xml version="1.0" encoding="utf-8"?>
<!-- Local package sources for the Pulsar solution. The default nuget.org
     endpoint is transparently redirected in this network and the NuGet
     client cannot complete restore against it (broken repository-signatures
     resource on the mirror), so the E2E packages are served from a local
     feed pre-populated with the full dependency closure. -->
<configuration>
  <packageSources>
    <add key="local-feed" value="C:\Users\milo\.workbuddy\tmp\nuget-feed3" />
    <add key="nuget.azure.cn" value="https://nuget.azure.cn/v3/index.json" />
  </packageSources>
  <disabledPackageSources>
    <add key="nuget.org" value="true" />
  </disabledPackageSources>
</configuration>
