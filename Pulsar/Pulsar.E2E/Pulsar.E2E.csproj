<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Pulsar.E2E</RootNamespace>
    <AssemblyName>Pulsar.E2E</AssemblyName>
    <!-- ScreenRecorderLib requires an explicit CPU platform (no AnyCPU). -->
    <PlatformTarget>x64</PlatformTarget>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <Version>1.0.0</Version>
    <Description>External E2E driver and visual-AI iteration loop for Pulsar (deterministic UIA verification ground truth).</Description>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
    <PackageReference Include="ScreenRecorderLib" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Canonical workflows and fixtures ship next to the driver binary so the
         canonical E2E run works from any working directory. -->
    <None Include="Workflows\**\*.json;Fixtures\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
