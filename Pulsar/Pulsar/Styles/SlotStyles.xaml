<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 数值令牌自给自足：本字典可能被脱离 Application 加载（单元测试手工构造
         资源树、设计器预览）。ControlTemplate 内的 StaticResource 在模板加载时
         即解析，届时若 Tokens.xaml 不在作用域会抛 XamlParseException ——
         与 SlotOrb / IconSelector 等控件自带合并是同一条规则。 -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Pulsar;component/Styles/Tokens.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Thickness x:Key="SlotChipPadding">8,3</Thickness>
    <CornerRadius x:Key="SlotChipCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="SlotBadgeCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="SlotPanelCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="SlotOrbContainerCornerRadius">10</CornerRadius>

    <Style x:Key="SlotChipBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource SlotChipCornerRadius}"/>
        <Setter Property="Padding" Value="{StaticResource SlotChipPadding}"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SlotValueChipTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Pulsar.Type.Caption}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SlotCaptionChipTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Pulsar.Type.Caption}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SlotSummaryTokenBorderStyle" TargetType="Border" BasedOn="{StaticResource SlotChipBorderStyle}">
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="MaxWidth" Value="280"/>
    </Style>

    <Style x:Key="SlotSummaryTokenTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SlotValueChipTextStyle}">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="MaxWidth" Value="248"/>
    </Style>

    <Style x:Key="SlotBadgeBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource SlotBadgeCornerRadius}"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SlotOrbContainerStyle" TargetType="Border">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="CornerRadius" Value="{StaticResource SlotOrbContainerCornerRadius}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SlotPreviewPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource SlotPanelCornerRadius}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Margin" Value="0,10,0,0"/>
    </Style>

    <!-- ==================== Slot Wheel Editor ==================== -->

    <Style x:Key="SlotPositionBadgeStyle" TargetType="Border">
        <Setter Property="MinWidth" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="-2,-2,0,0"/>
        <Setter Property="Panel.ZIndex" Value="120"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style x:Key="SlotPositionBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Pulsar.Type.Caption}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SlotEmptyRingStyle" TargetType="Ellipse">
        <Setter Property="Stroke" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
        <Setter Property="StrokeDashArray" Value="3 3"/>
        <Setter Property="Opacity" Value="0.55"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style x:Key="SlotGuideRingStyle" TargetType="Ellipse">
        <Setter Property="Stroke" Value="{DynamicResource SurfaceStrokeColorDefaultBrush}"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
        <Setter Property="StrokeDashArray" Value="4 4"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Opacity" Value="0.5"/>
    </Style>


</ResourceDictionary>
