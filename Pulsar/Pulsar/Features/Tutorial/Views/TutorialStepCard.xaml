<!-- [Path]: Pulsar/Pulsar/Views/Tutorial/TutorialStepCard.xaml -->

<UserControl x:Class="Pulsar.Features.Tutorial.Views.TutorialStepCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:lex="clr-namespace:Pulsar.Core.Localization"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="400">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Pulsar;component/Styles/ButtonStyles.xaml"/>
                <!-- 动画时长统一引用令牌；本控件可能脱离 Application 实例化，故自带 Tokens -->
                <ResourceDictionary Source="pack://application:,,,/Pulsar;component/Styles/Tokens.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 教程卡片是覆盖在暗色遮罩之上的固定浅色浮层（不跟随应用主题），
                 故颜色定义为本地令牌而非 Fluent 动态令牌 —— Fluent 令牌会随主题
                 切换而变，破坏教程的固定对比度。 -->
            <SolidColorBrush x:Key="TutorialCard.Background" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TutorialCard.Border" Color="#E0E0E0"/>
            <SolidColorBrush x:Key="TutorialCard.Title" Color="#1A1A1A"/>
            <SolidColorBrush x:Key="TutorialCard.Body" Color="#4A4A4A"/>
            <SolidColorBrush x:Key="TutorialCard.Muted" Color="#666666"/>
            <SolidColorBrush x:Key="TutorialCard.MutedLight" Color="#6A6A6A"/>
            <!-- ColorAnimation 需要纯色值，与 BorderBrush 分开定义 -->
            <Color x:Key="TutorialCard.SuccessColor">#27AE60</Color>
            <Color x:Key="TutorialCard.BorderColor">#E0E0E0</Color>

            <!-- Card entrance animation -->
            <Storyboard x:Key="CardEntranceAnimation">
                <DoubleAnimation Storyboard.TargetName="CardBorder"
                                Storyboard.TargetProperty="Opacity"
                                From="0" To="1"
                                Duration="{StaticResource Pulsar.Duration.Slow}">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                Storyboard.TargetProperty="ScaleX"
                                From="0.9" To="1"
                                Duration="{StaticResource Pulsar.Duration.Slow}">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                Storyboard.TargetProperty="ScaleY"
                                From="0.9" To="1"
                                Duration="{StaticResource Pulsar.Duration.Slow}">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <!-- Card crossfade-out animation -->
            <Storyboard x:Key="CardCrossfadeOutAnimation">
                <DoubleAnimation Storyboard.TargetName="CardBorder"
                                Storyboard.TargetProperty="Opacity"
                                From="1" To="0"
                                Duration="{StaticResource Pulsar.Duration.Normal}">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <!-- Success border flash animation -->
            <Storyboard x:Key="SuccessBorderFlashAnimation">
                <!-- 零时长 = 立即变绿（刻意为之，非疏漏） -->
                <ColorAnimation Storyboard.TargetName="CardBorder"
                               Storyboard.TargetProperty="BorderBrush.Color"
                               To="{StaticResource TutorialCard.SuccessColor}"
                               Duration="0:0:0"/>
                <ColorAnimation Storyboard.TargetName="CardBorder"
                               Storyboard.TargetProperty="BorderBrush.Color"
                               To="{StaticResource TutorialCard.BorderColor}"
                               Duration="{StaticResource Pulsar.Duration.Slow}"
                               BeginTime="0:0:0.15"/>
            </Storyboard>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid>
        <Border x:Name="CardBorder"
                Background="{StaticResource TutorialCard.Background}"
                BorderBrush="{StaticResource TutorialCard.Border}"
                BorderThickness="1"
                CornerRadius="{StaticResource Pulsar.Radius.XL}"
                MaxWidth="540"
                Padding="{StaticResource Pulsar.Pad.XL}"
                RenderTransformOrigin="0.5,0.5">
            
            <Border.Effect>
                <DropShadowEffect Color="Black" 
                                Opacity="0.3" 
                                BlurRadius="32" 
                                ShadowDepth="8"
                                Direction="270"/>
            </Border.Effect>
            
            <Border.RenderTransform>
                <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Step counter -->
                <TextBlock x:Name="StepCounter"
                          Grid.Row="0"
                          Text="Step 1/9"
                          FontSize="{StaticResource Pulsar.Type.Body}"
                          FontWeight="Medium"
                          Foreground="{StaticResource TutorialCard.Muted}"
                          Margin="{StaticResource Pulsar.Gap.Bottom.XS}"/>
                
                <!-- Progress bar -->
                <ProgressBar x:Name="StepProgressBar"
                            Grid.Row="1"
                            Minimum="0"
                            Maximum="1"
                            Value="0"
                            Height="3"
                            Margin="{StaticResource Pulsar.Gap.Bottom.SM}"
                            Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                            Background="Transparent"
                            BorderThickness="0"
                            IsIndeterminate="False"/>
                
                <!-- Title -->
                <TextBlock x:Name="TitleText"
                          Grid.Row="2"
                          Text="{lex:Locale Tutorial.Welcome}"
                          FontSize="{StaticResource Pulsar.Type.Title}"
                          FontWeight="SemiBold"
                          Foreground="{StaticResource TutorialCard.Title}"
                          TextWrapping="Wrap"
                          Margin="{StaticResource Pulsar.Gap.Bottom.MD}"/>
                
                <!-- Description with ScrollViewer -->
                <ScrollViewer Grid.Row="3"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="{StaticResource Pulsar.Gap.Bottom.XL}">
                    <TextBlock x:Name="DescriptionText"
                              Text="{lex:Locale Tutorial.DescriptionPlaceholder}"
                              FontSize="{StaticResource Pulsar.Type.Subtitle}"
                              Foreground="{StaticResource TutorialCard.Body}"
                              TextWrapping="Wrap"
                              LineHeight="20"/>
                </ScrollViewer>

                <!-- Wait-for-action helper text -->
                <TextBlock x:Name="WaitHintText"
                           Grid.Row="4"
                           Text="{lex:Locale Tutorial.AutoContinue}"
                           FontSize="{StaticResource Pulsar.Type.Body}"
                           Foreground="{StaticResource TutorialCard.MutedLight}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Margin="{StaticResource Pulsar.Gap.Bottom.LG}"/>
                 
                <!-- Action buttons -->
                <Grid Grid.Row="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ui:Button x:Name="BackButton"
                                Grid.Column="0"
                                Content="{lex:Locale Tutorial.Previous}"
                                Style="{StaticResource PulsarSecondaryButtonStyle}"
                                Click="OnBackButtonClick"
                                Margin="{StaticResource Pulsar.Gap.Right.MD}"/>

                    <StackPanel x:Name="ButtonPanel"
                               Grid.Column="2"
                               Orientation="Horizontal"
                               HorizontalAlignment="Right">
                    
                    <ui:Button x:Name="SkipButton"
                              Content="{lex:Locale Tutorial.SkipTutorial}"
                              Style="{StaticResource PulsarSecondaryButtonStyle}"
                              Click="OnSkipButtonClick"
                              Margin="{StaticResource Pulsar.Gap.Right.MD}"/>
                    
                     <ui:Button x:Name="ContinueButton"
                               Content="{lex:Locale Tutorial.Continue}"
                               Style="{StaticResource PulsarPrimaryButtonStyle}"
                               Click="OnContinueButtonClick"
                               Visibility="Collapsed"
                               Margin="{StaticResource Pulsar.Gap.Right.MD}"/>

                     <ui:Button x:Name="NextButton"
                                 Content="{lex:Locale Tutorial.Next}"
                                 Style="{StaticResource PulsarPrimaryButtonStyle}"
                                 Click="OnNextButtonClick"/>
                     </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
