<!-- [Path]: Pulsar/Pulsar/Views/Tutorial/TutorialOverlayWindow.xaml -->

<Window x:Class="Pulsar.Features.Tutorial.Views.TutorialOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lex="clr-namespace:Pulsar.Core.Localization"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="{lex:Locale Tutorial.OverlayTitle}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowState="Maximized"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- 教程遮罩是固定深色浮层（不跟随应用主题），颜色定义为本地令牌。 -->
        <SolidColorBrush x:Key="Tutorial.Overlay.Scrim" Color="#B4000000"/>
        <SolidColorBrush x:Key="Tutorial.Toast.Background" Color="#27AE60"/>
        <SolidColorBrush x:Key="Tutorial.Toast.Foreground" Color="#FFFFFF"/>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <!-- Semi-transparent overlay background -->
        <Rectangle x:Name="OverlayBackground" 
                   Fill="{StaticResource Tutorial.Overlay.Scrim}"
                   IsHitTestVisible="False"/>
        
        <!-- Content container for tutorial card (centered) -->
        <ContentPresenter x:Name="CardPresenter"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>

        <!-- Confetti overlay layer -->
        <Rectangle x:Name="ConfettiLayer"
                   IsHitTestVisible="False"
                   Visibility="Collapsed"/>

        <!-- Toast notification overlay -->
        <Border x:Name="ToastNotification"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="{StaticResource Pulsar.Gap.Top.Hero}"
                Background="{StaticResource Tutorial.Toast.Background}"
                CornerRadius="{StaticResource Pulsar.Radius.XXL}"
                Padding="{StaticResource Pulsar.Thk.L16T12R20B12}"
                BorderThickness="0"
                Opacity="0">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="16" ShadowDepth="4" Direction="270"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <!-- Emoji ✓ 是彩色位图，与 Fluent 单色矢量图标渲染口径不一致，
                     改为 SymbolIcon（Checkmark20）。 -->
                <ui:SymbolIcon x:Name="ToastIcon"
                               Symbol="Checkmark20"
                               FontSize="{StaticResource Pulsar.Type.Subtitle}"
                               Foreground="{StaticResource Tutorial.Toast.Foreground}"
                               VerticalAlignment="Center"
                               Margin="{StaticResource Pulsar.Gap.Right.SM}"/>
                <TextBlock x:Name="ToastMessage"
                           Text=""
                           FontSize="{StaticResource Pulsar.Type.Subtitle}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Tutorial.Toast.Foreground}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
