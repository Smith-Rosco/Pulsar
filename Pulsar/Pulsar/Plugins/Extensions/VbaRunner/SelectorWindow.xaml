<Window x:Class="Pulsar.Plugins.Extensions.VbaRunner.SelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lex="clr-namespace:Pulsar.Core.Localization"
        Title="{lex:Locale VbaRunner.SelectorTitle}" Height="180" Width="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Topmost="True">
    <Window.Resources>
        <!-- 选择器是覆盖在工作区上的固定浅色浮层（不跟随应用主题），颜色定义为本地令牌。 -->
        <SolidColorBrush x:Key="VbaSelector.Panel.Background" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="VbaSelector.Panel.Border" Color="#DDDDDD"/>
        <SolidColorBrush x:Key="VbaSelector.Text.Primary" Color="#333333"/>
        <SolidColorBrush x:Key="VbaSelector.Text.Muted" Color="#666666"/>
        <SolidColorBrush x:Key="VbaSelector.Input.Border" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="VbaSelector.Button.Primary" Color="#007ACC"/>
        <SolidColorBrush x:Key="VbaSelector.Button.PrimaryText" Color="#FFFFFF"/>
    </Window.Resources>
    <Border Background="{StaticResource VbaSelector.Panel.Background}"
            CornerRadius="{StaticResource Pulsar.Radius.LG}"
            BorderThickness="1"
            BorderBrush="{StaticResource VbaSelector.Panel.Border}"
            Padding="{StaticResource Pulsar.Pad.XL}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.2" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="{lex:Locale VbaRunner.SelectTargetWorksheet}"
                       FontWeight="SemiBold"
                       Margin="{StaticResource Pulsar.Gap.Bottom.LG}"
                       Foreground="{StaticResource VbaSelector.Text.Primary}"
                       FontSize="{StaticResource Pulsar.Type.Subtitle}"/>
            <ComboBox x:Name="SheetCombo"
                      FontSize="{StaticResource Pulsar.Type.Subtitle}"
                      Padding="{StaticResource Pulsar.Pad.H8V4}"
                      Margin="{StaticResource Pulsar.Gap.Bottom.XXL}"
                      Height="35"
                      Background="{StaticResource VbaSelector.Panel.Background}"
                      BorderBrush="{StaticResource VbaSelector.Input.Border}"
                      Foreground="{StaticResource VbaSelector.Text.Primary}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{lex:Locale Dialog.AddSlot.Cancel}"
                        Click="Cancel_Click"
                        IsCancel="True"
                        Margin="{StaticResource Pulsar.Gap.Right.MD}"
                        Padding="{StaticResource Pulsar.Pad.H16V8}"
                        Background="Transparent"
                        Foreground="{StaticResource VbaSelector.Text.Muted}"
                        BorderBrush="{StaticResource VbaSelector.Panel.Border}"
                        BorderThickness="1"/>
                <Button Content="{lex:Locale Dialog.AddSlot.RunScript}"
                        Click="Run_Click"
                        IsDefault="True"
                        Background="{StaticResource VbaSelector.Button.Primary}"
                        Foreground="{StaticResource VbaSelector.Button.PrimaryText}"
                        Padding="{StaticResource Pulsar.Pad.H20V8}"
                        BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>