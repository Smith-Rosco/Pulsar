<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    
    <ApplicationIcon>Pulsar.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationId>com.pulsar.redux</ApplicationId>
    <Authors>Pulsar Developer</Authors>
    <Company>Pulsar Lab</Company>
    <Product>Pulsar Redux</Product>
    <Description>A high-performance radial menu for productivity.</Description>
    <Copyright>Copyright © 2026</Copyright>
    <Version>1.12.0</Version>
    <FileVersion>1.12.0.0</FileVersion>
    <AssemblyVersion>1.12.0.0</AssemblyVersion>
  </PropertyGroup>

  <!--
    Publish/packaging properties (ADR-026, change 2026-09-05-installer-and-portable-packaging).
    Conditioned on RuntimeIdentifier so day-to-day builds are unaffected; they only kick in
    for `dotnet publish -r win-x64` (dev.ps1 publish).
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Why no trim: the plugin system loads plugin assemblies via reflection
         (LocalPluginScanner + collectible ALC); trimming breaks reflection-based
         discovery and is explicitly forbidden for Pulsar. -->
    <PublishTrimmed>false</PublishTrimmed>
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>


  <ItemGroup>
    <None Remove="Pulsar.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Theme-aware tray icons (white/black backgrounds) + transparent mark for in-app surfaces -->
    <Resource Include="Assets\Icons\pulsar-light.ico" />
    <Resource Include="Assets\Icons\pulsar-dark.ico" />
    <Resource Include="Assets\Icons\pulsar-mark-256.png" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Resources\Tutorial\TutorialSteps.json">
      <Link>Assets\TutorialSteps.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Resources\Tutorial\TutorialSteps.notepad.json">
      <Link>Assets\TutorialSteps.notepad.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Resources\Tutorial\TutorialSteps.excel.json">
      <Link>Assets\TutorialSteps.excel.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Resources\Tutorial\TutorialSteps.browser.json">
      <Link>Assets\TutorialSteps.browser.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Resources\Tutorial\TutorialSteps.webscript.json">
      <Link>Assets\TutorialSteps.webscript.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Plugins\Extensions\VbaRunner\DemoScripts\excel_demo.txt">
      <Link>Assets\Scripts\Demo\excel_demo.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Plugins\Extensions\BookmarkletRunner\DemoScripts\browser_demo.js">
      <Link>Assets\Scripts\Demo\browser_demo.js</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Plugins\Extensions\BookmarkletRunner\DemoScripts\form_fill_demo.js">
      <Link>Assets\Scripts\Demo\form_fill_demo.js</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Plugins\Extensions\BookmarkletRunner\DemoScripts\data_extract_demo.js">
      <Link>Assets\Scripts\Demo\data_extract_demo.js</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Plugins\Extensions\BookmarkletRunner\DemoScripts\link_traverse_demo.js">
      <Link>Assets\Scripts\Demo\link_traverse_demo.js</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\Presets\macro\excel_macro.txt">
      <Link>Assets\Presets\macro\excel_macro.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\Presets\form-fill\form_fill.js">
      <Link>Assets\Presets\form-fill\form_fill.js</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\Presets\sign-in\sign_in.js">
      <Link>Assets\Presets\sign-in\sign_in.js</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="gong-wpf-dragdrop" Version="4.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Sinks.Map" Version="2.0.0" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.287">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Pulsar.ico" />
  </ItemGroup>

</Project>
