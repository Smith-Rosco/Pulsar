<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:dialogs="clr-namespace:Pulsar.ViewModels.Dialogs"
                    xmlns:contents="clr-namespace:Pulsar.Views.Dialogs.Contents">

    <!-- Default String Template -->
    <DataTemplate DataType="{x:Type sys:String}">
        <!-- ScrollViewer: message bodies grow with the window (AutoHeight cap) and
             scroll beyond it instead of clipping at the window edge. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="{StaticResource Pulsar.Type.Subtitle}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
        </ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="{x:Type dialogs:ProcessBlacklistViewModel}">
        <contents:ProcessBlacklistContent/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type dialogs:ColorPickerViewModel}">
        <contents:ColorPickerContent/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type dialogs:IconPickerViewModel}">
        <contents:IconPickerContent/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type dialogs:InputDialogViewModel}">
        <contents:InputDialogContent/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type dialogs:InputProfileViewModel}">
        <contents:InputProfileContent/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type dialogs:EditProfileViewModel}">
        <contents:EditProfileContent/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type dialogs:PluginLogViewerViewModel}">
        <contents:PluginLogViewerContentHost/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type dialogs:PluginAnalyticsDetailViewModel}">
        <contents:PluginAnalyticsDetailContentHost/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type dialogs:ProcessPickerViewModel}">
        <contents:ProcessPickerContent/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type dialogs:QuickSecretsViewModel}">
        <contents:QuickSecretsContent/>
    </DataTemplate>

    <!-- [P3 4.1] SlotEditorViewModel 模态模板已退役：slot 编辑统一走 transient tab
         （SettingsSlotEditorPage 直接实例化 AddSlotContent / SlotConfigurationDialogContent，
         不经 VM→DataTemplate 模态查找）。 -->
    <DataTemplate DataType="{x:Type dialogs:SecretPickerViewModel}">
        <contents:SecretPickerContent/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type dialogs:PluginSettingsDialogViewModel}">
        <contents:PluginSettingsDialogContent/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type dialogs:WindowInspectorViewModel}">
        <contents:WindowInspectorContent/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type dialogs:FirstLaunchSetupWizardViewModel}">
        <contents:FirstLaunchSetupWizardContent/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type dialogs:ConfigBackupOptionsViewModel}">
        <contents:ConfigBackupOptionsContent/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type dialogs:BookmarkletScriptEditorViewModel}">
        <contents:BookmarkletScriptEditorContent/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type dialogs:ExampleLibraryViewModel}">
        <contents:ExampleLibraryContent/>
    </DataTemplate>
</ResourceDictionary>
