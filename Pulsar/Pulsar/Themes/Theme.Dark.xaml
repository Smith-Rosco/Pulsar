<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============================================================
         Pulsar 深色主题 —— ui-ux-pro-max 设计系统「Code dark + run green」
         ============================================================
         调色板：Slate 色阶（背景 #0F172A / 表面 #334155 / 前景 #F8FAFC /
         边框 #475569），语义色：success 绿 #4ADE80 · warning 琥珀 #FBBF24 ·
         critical 红 #F87171。完整设计系统见
         Docs/design-system/pulsar/MASTER.md。

         架构不变（键名即契约，禁止改名）：
         · 通用界面颜色由 WPF.Ui Fluent 令牌承担（跟随系统主题），
           本文件仅保留径向菜单专用 + 渲染器需要的令牌。
         · 键名被 RadialThemeTokenSet / SlotBrushConverter /
           SlotPresentation 按键读取，Pulsar.Tests 断言其存在性。
         分组顺序与 Theme.Light.xaml 一一对应，便于对照维护。
         ============================================================ -->

    <!-- 强调色三元组：径向菜单渲染器（ClassicRing / Glassmorphism）读取。
         运行态由 ModeToneTokenDecorator 按模式覆盖（Task=冷色蓝 #0078D7，
         默认=暖橙 #C04100），故此处保持冷色蓝系；
         绿色留给「运行/成功」语义（SlotHealthBrushReady / SlotTypeBrushCommand）。 -->
    <SolidColorBrush x:Key="Theme.Accent" Color="#0078D7"/>
    <SolidColorBrush x:Key="Theme.Accent.Hover" Color="#1084E3"/>
    <SolidColorBrush x:Key="Theme.Accent.Foreground" Color="#FFFFFF"/>

    <!-- 危险操作 hover：Fluent 无 critical hover 变体（ButtonStyles.xaml:301 依赖本键）。
         取设计系统 destructive red-500 #EF4444 —— 比深色基态更亮（hover 可辨），
         白字对比度 3.76:1（优于旧值 #FF5C2B 的 3.08）。 -->
    <SolidColorBrush x:Key="Theme.Destructive.Hover" Color="#FFEF4444"/>

    <!-- 槽位类型色（徽标身份色，色相即语义；深色取 400 档亮色） -->
    <SolidColorBrush x:Key="SlotTypeBrushDefault" Color="#FF94A3B8"/>   <!-- slate-400 -->
    <SolidColorBrush x:Key="SlotTypeBrushSecret" Color="#FFF2C14E"/>    <!-- gold：密钥/凭据 -->
    <SolidColorBrush x:Key="SlotTypeBrushApp" Color="#FF38BDF8"/>       <!-- sky-400：应用/窗口 -->
    <SolidColorBrush x:Key="SlotTypeBrushCommand" Color="#FF4ADE80"/>   <!-- green-400：命令 -->
    <SolidColorBrush x:Key="SlotTypeBrushScript" Color="#FFF87171"/>    <!-- red-400：脚本 -->
    <SolidColorBrush x:Key="SlotTypeBrushVba" Color="#FFF59E0B"/>       <!-- amber-500：VBA 宏 -->

    <!-- 槽位健康色（同 400 档，与类型色同一色系语言） -->
    <SolidColorBrush x:Key="SlotHealthBrushReady" Color="#FF4ADE80"/>
    <SolidColorBrush x:Key="SlotHealthBrushWarning" Color="#FFFBBF24"/>
    <SolidColorBrush x:Key="SlotHealthBrushError" Color="#FFF87171"/>

    <!-- Orb 表面：slate-700 冷灰，替代原中性灰 #2D2D2D ——
         与代码深色气质一致，且在明暗桌面背景上均清晰可见。 -->
    <SolidColorBrush x:Key="Theme.Orb.Fill" Color="#FF334155"/>
    <SolidColorBrush x:Key="Theme.Orb.Stroke" Color="#44FFFFFF"/>
    <SolidColorBrush x:Key="Theme.Orb.Text" Color="#FFF8FAFC"/>

    <!-- 激活态三通道：填充提亮 + 描边加亮 + 外圈环。
         冷色 sky 系（与 Task 模式冷色强调呼应），均不依赖 BlurEffect。 -->
    <SolidColorBrush x:Key="Theme.Orb.Active.Fill" Color="#CC38BDF8"/>
    <SolidColorBrush x:Key="Theme.Orb.Active.Stroke" Color="#FF7DD3FC"/>
    <SolidColorBrush x:Key="Theme.Orb.Active.Ring" Color="#9938BDF8"/>
    <SolidColorBrush x:Key="Theme.Orb.Active.Glow" Color="#CC38BDF8"/>
    <!-- 推荐态光晕：金色语义（「推荐」高于「激活」） -->
    <SolidColorBrush x:Key="Theme.Orb.Recommended" Color="#FFFFD700"/>

    <!-- 文字型 Slot 标题可读性：半透明 slate-900 底衬，
         保证任意桌面像素上文字对比度。 -->
    <SolidColorBrush x:Key="Theme.Orb.Label.Background" Color="#CC0F172A"/>
    <SolidColorBrush x:Key="Theme.Orb.Label.Foreground" Color="#FFF8FAFC"/>

    <!-- 动态标题条：黑 70% scrim 隔离桌面像素，白字 + 黑投影。
         类型徽标底衬：slate-900 70%。 -->
    <SolidColorBrush x:Key="Theme.Radial.Title.Foreground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Theme.Radial.Title.Shadow" Color="#FF000000"/>
    <SolidColorBrush x:Key="Theme.Radial.Title.Scrim" Color="#B2000000"/>
    <SolidColorBrush x:Key="Theme.Orb.Chip.Background" Color="#B20F172A"/>

    <!-- 数值令牌（排版 / 时长 / 间距 / 圆角 / 缓动）在 Styles/Tokens.xaml，
         App.xaml 全局加载；主题色令牌必须在 ThemeService 中按窗口手动注入，
         否则会污染径向菜单的透明画布（见 App.xaml GLOBAL STYLE ISOLATION）。

         历史：Theme.Orb.BlurOpacity（Dark=1.0 / Light=0.0）已删除 ——
         激活反馈改为三通道（填充/描边/外环），浅色主题不再「关掉能力」。 -->

</ResourceDictionary>
