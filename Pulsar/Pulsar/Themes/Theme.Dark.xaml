<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============================================================
         仅保留径向菜单专用 + 渲染器需要的令牌。
         通用颜色已全部迁移至 WPF.Ui Fluent 令牌（跟随系统主题）：
         AccentFillColorDefaultBrush / TextFillColorPrimaryBrush /
         ControlFillColorDefaultBrush / SystemFillColorCriticalBrush 等。
         曾经的 Theme.Window/Text/Accent/Control/Input/ScrollBar 系列
         已清理 —— 界面层已零引用（此前与 Fluent 并存形成"两套产品观感"）。
         ============================================================ -->

    <!-- 强调色三元组：RadialThemeTokenSet 渲染器按键读取（菜单绘制用）。
         界面按钮请用 Fluent 的 AccentFillColorDefaultBrush，勿用此键。 -->
    <SolidColorBrush x:Key="Theme.Accent" Color="#0078D7"/>
    <SolidColorBrush x:Key="Theme.Accent.Hover" Color="#1084E3"/>
    <SolidColorBrush x:Key="Theme.Accent.Foreground" Color="#FFFFFF"/>

    <!-- 危险操作：Fluent 无 critical 的 hover 变体，ButtonStyles 依赖本键。
         与 Theme.Orb.* 同属有意保留的例外。 -->
    <SolidColorBrush x:Key="Theme.Destructive" Color="#E81123"/>
    <SolidColorBrush x:Key="Theme.Destructive.Hover" Color="#FF5C2B"/>

    <SolidColorBrush x:Key="SlotTypeBrushDefault" Color="#FF9CA3AF"/>
    <SolidColorBrush x:Key="SlotTypeBrushSecret" Color="#FFF2C14E"/>
    <SolidColorBrush x:Key="SlotTypeBrushApp" Color="#FF4FB3FF"/>
    <SolidColorBrush x:Key="SlotTypeBrushCommand" Color="#FF4ADE80"/>
    <SolidColorBrush x:Key="SlotTypeBrushScript" Color="#FFF87171"/>
    <SolidColorBrush x:Key="SlotTypeBrushVba" Color="#FFF59E0B"/>

    <SolidColorBrush x:Key="SlotHealthBrushReady" Color="#FF4ADE80"/>
    <SolidColorBrush x:Key="SlotHealthBrushWarning" Color="#FFFBBF24"/>
    <SolidColorBrush x:Key="SlotHealthBrushError" Color="#FFF87171"/>

    <SolidColorBrush x:Key="Theme.Orb.Fill" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="Theme.Orb.Stroke" Color="#44FFFFFF"/>
    <SolidColorBrush x:Key="Theme.Orb.Text" Color="#FFFFFF"/>

    <!-- 激活态三通道：填充提亮 + 描边加亮 + 外圈环。
         与浅色主题使用同一组令牌键，保证明暗主题对等实现。 -->
    <SolidColorBrush x:Key="Theme.Orb.Active.Fill" Color="#CC00BFFF"/>
    <SolidColorBrush x:Key="Theme.Orb.Active.Stroke" Color="#FF4CC8FF"/>
    <SolidColorBrush x:Key="Theme.Orb.Active.Ring" Color="#9900BFFF"/>
    <!-- 保留以兼容旧引用 -->
    <SolidColorBrush x:Key="Theme.Orb.Active.Glow" Color="#CC00BFFF"/>

    <!-- Slot title (text-only orb) readability tokens: local semi-opaque backplate -->
    <SolidColorBrush x:Key="Theme.Orb.Label.Background" Color="#CC1F1F1F"/>
    <SolidColorBrush x:Key="Theme.Orb.Label.Foreground" Color="#FFFFFFFF"/>

    <SolidColorBrush x:Key="Theme.Radial.Scrim" Color="#26000000"/>
    <RadialGradientBrush x:Key="Theme.Radial.ScrimBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#40000000" Offset="0.0"/>
        <GradientStop Color="#2E000000" Offset="0.62"/>
        <GradientStop Color="#1F000000" Offset="0.82"/>
        <GradientStop Color="#00000000" Offset="0.96"/>
    </RadialGradientBrush>
    <SolidColorBrush x:Key="Theme.Radial.Title.Foreground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Theme.Radial.Title.Shadow" Color="#FF000000"/>
    <SolidColorBrush x:Key="Theme.Radial.Title.Scrim" Color="#B2000000"/>
    <SolidColorBrush x:Key="Theme.Orb.Chip.Background" Color="#B20B1220"/>

    <!-- 数值令牌（排版 / 时长 / 间距 / 圆角 / 缓动）已迁移至 Styles/Tokens.xaml，
         并在 App.xaml 全局加载。此前在此处定义但从未被任何界面引用 ——
         令牌若未接入，等于不存在。
         曾存在 Theme.Orb.BlurOpacity（Dark=1.0 / Light=0.0）—— 激活反馈已改
         为三通道（填充/描边/外环，见 Theme.Orb.Active.*），该键已零引用，已删除：
         它曾让浅色主题"关掉能力"，正是 P0 缺陷的根源。 -->

</ResourceDictionary>
