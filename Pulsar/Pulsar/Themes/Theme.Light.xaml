<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============================================================
         仅保留径向菜单专用 + 渲染器需要的令牌。
         通用颜色已全部迁移至 WPF.Ui Fluent 令牌（跟随系统主题）：
         AccentFillColorDefaultBrush / TextFillColorPrimaryBrush /
         ControlFillColorDefaultBrush / SystemFillColorCriticalBrush 等。
         曾经的 Theme.Window/Text/Accent/Control/Input/ScrollBar 系列
         已清理 —— 界面层已零引用（此前与 Fluent 并存形成"两套产品观感"）。
         ============================================================ -->

    <!-- 强调色三元组：RadialThemeTokenSet 渲染器按键读取（菜单绘制用）。
         界面按钮请用 Fluent 的 AccentFillColorDefaultBrush，勿用此键。 -->
    <SolidColorBrush x:Key="Theme.Accent" Color="#0067C0"/>
    <SolidColorBrush x:Key="Theme.Accent.Hover" Color="#197CCB"/>
    <SolidColorBrush x:Key="Theme.Accent.Foreground" Color="#FFFFFF"/>

    <!-- 危险操作：Fluent 无 critical 的 hover 变体，ButtonStyles 依赖本键。
         与 Theme.Orb.* 同属有意保留的例外。 -->
    <SolidColorBrush x:Key="Theme.Destructive" Color="#C42B1C"/>
    <SolidColorBrush x:Key="Theme.Destructive.Hover" Color="#D83B2A"/>

    <SolidColorBrush x:Key="SlotTypeBrushDefault" Color="#FF4B5563"/>
    <SolidColorBrush x:Key="SlotTypeBrushSecret" Color="#FFD4A017"/>
    <SolidColorBrush x:Key="SlotTypeBrushApp" Color="#FF0284C7"/>
    <SolidColorBrush x:Key="SlotTypeBrushCommand" Color="#FF15803D"/>
    <SolidColorBrush x:Key="SlotTypeBrushScript" Color="#FFDC2626"/>
    <SolidColorBrush x:Key="SlotTypeBrushVba" Color="#FFB45309"/>

    <SolidColorBrush x:Key="SlotHealthBrushReady" Color="#FF15803D"/>
    <SolidColorBrush x:Key="SlotHealthBrushWarning" Color="#FFD97706"/>
    <SolidColorBrush x:Key="SlotHealthBrushError" Color="#FFDC2626"/>

    <SolidColorBrush x:Key="Theme.Orb.Fill" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Theme.Orb.Stroke" Color="#D1D1D1"/>
    <SolidColorBrush x:Key="Theme.Orb.Text" Color="#1A1A1A"/>

    <!-- 激活态三通道 —— 浅色主题不使用发光。
         半透明辉光在浅底上几乎不可见，曾导致 Theme.Orb.Active.Glow
         被设为全透明 #00FFFFFF，使径向菜单的激活反馈彻底消失。
         改为：填充提亮 + 描边加深 + 外圈环，三者均不依赖 BlurEffect。 -->
    <SolidColorBrush x:Key="Theme.Orb.Active.Fill" Color="#FFD6E9F8"/>
    <SolidColorBrush x:Key="Theme.Orb.Active.Stroke" Color="#FF0067C0"/>
    <SolidColorBrush x:Key="Theme.Orb.Active.Ring" Color="#990067C0"/>
    <!-- 保留以兼容旧引用，但浅色下已不作为激活反馈通道 -->
    <SolidColorBrush x:Key="Theme.Orb.Active.Glow" Color="#00FFFFFF"/>

    <!-- Slot title (text-only orb) readability tokens: local semi-opaque backplate -->
    <SolidColorBrush x:Key="Theme.Orb.Label.Background" Color="#E6FFFFFF"/>
    <SolidColorBrush x:Key="Theme.Orb.Label.Foreground" Color="#FF1A1A1A"/>

    <SolidColorBrush x:Key="Theme.Radial.Scrim" Color="#1A000000"/>
    <RadialGradientBrush x:Key="Theme.Radial.ScrimBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#3D000000" Offset="0.0"/>
        <GradientStop Color="#2B000000" Offset="0.62"/>
        <GradientStop Color="#1C000000" Offset="0.82"/>
        <GradientStop Color="#00000000" Offset="0.96"/>
    </RadialGradientBrush>
    <SolidColorBrush x:Key="Theme.Radial.Title.Foreground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Theme.Radial.Title.Shadow" Color="#FF000000"/>
    <SolidColorBrush x:Key="Theme.Radial.Title.Scrim" Color="#B2000000"/>
    <SolidColorBrush x:Key="Theme.Orb.Chip.Background" Color="#CCFFFFFF"/>

    <!-- 数值令牌（排版 / 时长 / 间距 / 圆角 / 缓动）已迁移至 Styles/Tokens.xaml，
         并在 App.xaml 全局加载。此前在此处定义但从未被任何界面引用 ——
         令牌若未接入，等于不存在。
         曾存在 Theme.Orb.BlurOpacity（Dark=1.0 / Light=0.0）—— 激活反馈已改
         为三通道（填充/描边/外环，见 Theme.Orb.Active.*），该键已零引用，已删除：
         它曾让浅色主题"关掉能力"，正是 P0 缺陷的根源。 -->

</ResourceDictionary>
