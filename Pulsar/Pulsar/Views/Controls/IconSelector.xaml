<UserControl x:Class="Pulsar.Views.Controls.IconSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:Pulsar.Views.Controls"
             xmlns:lex="clr-namespace:Pulsar.Core.Localization"
             mc:Ignorable="d"
             x:Name="Root"
             Focusable="True"
             Cursor="Hand"
             MouseLeftButtonDown="Root_MouseLeftButtonDown"
             ToolTip="{lex:Locale Dialog.IconPicker.ChangeIcon}"
             d:DesignHeight="42" d:DesignWidth="280">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 自带数值令牌：SlotIconPreviewTests 在无 Application 上下文中
                     直接实例化本控件（其内嵌 SlotOrb 亦如此）。 -->
                <ResourceDictionary Source="pack://application:,,,/Pulsar;component/Styles/Tokens.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <controls:SlotOrb Grid.Column="0"
                          Size="40"
                          IsActive="False"
                          ShowActiveGlow="False"
                          IsHitTestVisible="False"
                          IconKey="{Binding IconKey, ElementName=Root}"/>

        <TextBlock Grid.Column="1"
                   Text="{Binding DisplayText, ElementName=Root}"
                   VerticalAlignment="Center"
                   Margin="{StaticResource Pulsar.Gap.Left.MD}"
                   FontSize="{StaticResource Pulsar.Type.Body}"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   TextTrimming="CharacterEllipsis"/>
    </Grid>
</UserControl>
