<UserControl x:Class="Pulsar.Views.Controls.SlotOrb"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Pulsar.Views.Controls"
             xmlns:converters="clr-namespace:Pulsar.Core.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="60" d:DesignWidth="60"
             x:Name="OrbRoot"
             RenderTransformOrigin="0.5,0.5">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 自带数值令牌：使本控件可脱离 Application 上下文独立实例化
                     （单元测试、XAML 设计器）。若仅依赖 App.xaml 的全局资源，
                     StaticResource 在无 Application 时会抛 XamlParseException ——
                     IconSelector 内嵌了本控件，曾因此导致 SlotIconPreviewTests 失败。 -->
                <ResourceDictionary Source="pack://application:,,,/Pulsar;component/Styles/Tokens.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <converters:StringEmptyToVisibilityConverter x:Key="StringEmptyToVisibilityConverter"/>
            <converters:DoubleMultiplyConverter x:Key="SizeFactor"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.RenderTransform>
        <TransformGroup>
            <ScaleTransform x:Name="OrbScale" ScaleX="1.0" ScaleY="1.0"/>
            <TranslateTransform x:Name="OrbTranslate" X="0" Y="0"/>
        </TransformGroup>
    </UserControl.RenderTransform>

    <Grid Width="{Binding Size, ElementName=OrbRoot}" 
          Height="{Binding Size, ElementName=OrbRoot}">

        <!-- 推荐态：进入时淡入一次后保持静态。
             原实现是 RepeatBehavior="Forever" 的呼吸脉冲 —— 对主打肌肉记忆与
             空间定位的工具而言，常驻动画是纯粹的注意力污染（用户靠位置找目标，
             不需要闪烁提示），且 BlurEffect 每帧重绘，与高性能定位冲突。 -->
        <Ellipse x:Name="RecommendedShape" Fill="{DynamicResource Theme.Orb.Recommended}" Opacity="0">
            <Ellipse.Effect>
                <BlurEffect Radius="20"/>
            </Ellipse.Effect>
            <Ellipse.Style>
                <Style TargetType="Ellipse">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRecommended, ElementName=OrbRoot}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         To="0.45"
                                                         Duration="{StaticResource Pulsar.Duration.Normal}"
                                                         EasingFunction="{StaticResource Pulsar.Easing.Standard}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="{StaticResource Pulsar.Duration.Fast}"
                                                         EasingFunction="{StaticResource Pulsar.Easing.Standard}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <!-- 激活时压低推荐光晕，避免与激活反馈争夺注意力 -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRecommended, ElementName=OrbRoot}" Value="True"/>
                                <Condition Binding="{Binding IsActive, ElementName=OrbRoot}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         To="0.2"
                                                         Duration="{StaticResource Pulsar.Duration.Fast}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         To="0.45"
                                                         Duration="{StaticResource Pulsar.Duration.Fast}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Ellipse.Style>
        </Ellipse>

        <!-- 激活反馈通道一（填充提亮）与通道二（描边加粗）。
             已移除原先每个圆球挂一个 DropShadowEffect 的做法：N 个扇区即 N 次
             模糊重绘，与本项目的高性能定位直接冲突 —— RadialMenuWindow 的标题
             层早已因同样理由移除了阴影（见该文件 [Optimized] 注释）。
             描边加粗是明暗主题下都可靠的最强通道。 -->
        <Ellipse x:Name="OrbFill"
                 StrokeThickness="1.5">
            <Ellipse.Style>
                <Style TargetType="Ellipse">
                    <!-- Default: Use Custom Bindings -->
                    <Setter Property="Fill" Value="{Binding CustomFill, ElementName=OrbRoot}"/>
                    <Setter Property="Stroke" Value="{Binding CustomStroke, ElementName=OrbRoot}"/>

                    <Style.Triggers>
                        <!-- Fallback: If CustomFill is Null, use Theme Resource -->
                        <DataTrigger Binding="{Binding CustomFill, ElementName=OrbRoot}" Value="{x:Null}">
                            <Setter Property="Fill" Value="{DynamicResource Theme.Orb.Fill}"/>
                            <Setter Property="Stroke" Value="{DynamicResource Theme.Orb.Stroke}"/>
                        </DataTrigger>

                        <!-- 通道一：填充提亮（仅默认配色；自定义色扇区保留用户选色） -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding CustomFill, ElementName=OrbRoot}" Value="{x:Null}"/>
                                <Condition Binding="{Binding IsActive, ElementName=OrbRoot}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Fill" Value="{DynamicResource Theme.Orb.Active.Fill}"/>
                            <Setter Property="Stroke" Value="{DynamicResource Theme.Orb.Active.Stroke}"/>
                        </MultiDataTrigger>

                        <!-- 通道二：描边加粗（对自定义色扇区同样生效） -->
                        <DataTrigger Binding="{Binding IsActive, ElementName=OrbRoot}" Value="True">
                            <Setter Property="StrokeThickness" Value="2.5"/>
                        </DataTrigger>

                        <!-- Transparent Override (Highest Priority) -->
                        <DataTrigger Binding="{Binding IsTransparent, ElementName=OrbRoot}" Value="True">
                            <Setter Property="Fill" Value="Transparent"/>
                            <Setter Property="Stroke" Value="Transparent"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Ellipse.Style>
        </Ellipse>

        <!-- 激活通道三：外圈同心环。
             原实现用 Fill + Theme.Orb.Active.Glow 做辉光，而该键在浅色主题下
             被设为 #00FFFFFF（全透明），导致浅色模式中激活反馈彻底消失 ——
             径向菜单的整个交互契约因此断裂。改为描边环：不依赖发光，
             明暗主题均可见。 -->
        <Ellipse x:Name="ActiveShape" StrokeThickness="2">
            <Ellipse.Style>
                <Style TargetType="Ellipse">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="Fill" Value="Transparent"/>
                    <Setter Property="Margin" Value="-8"/>
                    <Setter Property="Stroke" Value="{DynamicResource Theme.Orb.Active.Ring}"/>

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive, ElementName=OrbRoot}" Value="True">
                            <Setter Property="Opacity" Value="1"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsTransparent, ElementName=OrbRoot}" Value="True">
                            <Setter Property="Opacity" Value="0"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Ellipse.Style>
        </Ellipse>

        <!-- [Architectural Fix] Use Viewbox for Scale-Agnostic Rendering -->
        <!-- We define a fixed "Design Coordinate System" (24x24) inside the Viewbox. -->
        <!-- The Viewbox then scales this entire visual tree to fit whatever 'Size' is set externally. -->
        <!-- 24x24 是「设计坐标系」，由 Viewbox 统一缩放到实际 Size。
             因此内部的 FontSize（14 / 11 / 8）是设计单位而非屏幕像素 ——
             请勿套用 Styles/Tokens.xaml 的排版令牌（那些是屏幕像素值），
             否则会破坏跨尺寸的等比缩放。 -->
        <Viewbox Stretch="Uniform">
            <Grid Width="24" Height="24">
                
                <!-- [New] Opacity Binding for IsContentVisible -->
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                             <DataTrigger Binding="{Binding IsContentVisible, ElementName=OrbRoot}" Value="False">
                                 <Setter Property="Opacity" Value="0"/>
                                 <Setter Property="Visibility" Value="Collapsed"/> 
                             </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
    
            <!-- [Architectural Fix] Reduced Image Size to 16x16 to create Padding/Safe Area -->
            <!-- This ensures square icons never pierce the 24x24 circle boundary -->
            <Image Source="{Binding RenderImage, ElementName=OrbRoot, NotifyOnTargetUpdated=True}"
                   Width="16" Height="16"
                   RenderTransformOrigin="0.5, 0.5"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Visibility="{Binding ShowImage, ElementName=OrbRoot, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Image.Triggers>
                    <EventTrigger RoutedEvent="Binding.TargetUpdated">
                        <BeginStoryboard>
                            <Storyboard>
                                <!-- 回弹缓动（BackEase）会推迟抵达终态的感知时间 ——
                                     用户已经知道答案了，动画不该还在晃。
                                     本项目主打肌肉记忆与空间定位，一律改用指数缓动。 -->
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1"
                                                 Duration="{StaticResource Pulsar.Duration.Normal}"
                                                 EasingFunction="{StaticResource Pulsar.Easing.Standard}"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.5" To="1"
                                                 Duration="{StaticResource Pulsar.Duration.Normal}"
                                                 EasingFunction="{StaticResource Pulsar.Easing.Standard}"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.5" To="1"
                                                 Duration="{StaticResource Pulsar.Duration.Normal}"
                                                 EasingFunction="{StaticResource Pulsar.Easing.Standard}"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Image.Triggers>
                <Image.RenderTransform>
                    <!-- [Refactor] Removed hardcoded CenterX/Y. Origin handled by RenderTransformOrigin -->
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Image.RenderTransform>
            </Image>

            <!-- [Architectural Fix] Reduced Font Size to 14 to match Image scale -->
            <TextBlock Text="{Binding RenderGlyph, ElementName=OrbRoot, NotifyOnTargetUpdated=True}"
                       FontFamily="{Binding GlyphFontFamily, ElementName=OrbRoot}"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                <TextBlock.Triggers>
                    <EventTrigger RoutedEvent="Binding.TargetUpdated">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1"
                                                 Duration="{StaticResource Pulsar.Duration.Normal}"
                                                 EasingFunction="{StaticResource Pulsar.Easing.Standard}"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </TextBlock.Triggers>
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <!-- Default: Use Custom Foreground -->
                        <Setter Property="Foreground" Value="{Binding CustomForeground, ElementName=OrbRoot}"/>
                        
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowImage, ElementName=OrbRoot}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <!-- Fallback: If CustomForeground is Null, use Theme Resource -->
                            <DataTrigger Binding="{Binding CustomForeground, ElementName=OrbRoot}" Value="{x:Null}">
                                <Setter Property="Foreground" Value="{DynamicResource Theme.Orb.Text}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- [Architectural Fix] Reduced Badge Size to fit Safe Area -->
            <!-- Previous: MinWidth=18, Height=18, Margin="0,-10,-10,0" (Too large for 24px container) -->
            <!-- New: MinWidth=12, Height=12, Margin="0,-2,-2,0" (Tightly integrated) -->
            <!-- 徽章改跟随系统强调色，替代硬编码 #FF0078D7 ——
                 该值与浅色主题的 Theme.Accent(#0067C0) 并不一致，
                 导致同一个「强调色」在系统里存在两个值。 -->
            <!-- 光学对齐负值:徽章贴齐 24x24 圆球右上角,不进间距刻度 -->
            <Border Background="{DynamicResource AccentFillColorDefaultBrush}" 
                    CornerRadius="{StaticResource Pulsar.Radius.MD}" 
                    MinWidth="12" Height="12"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,-2,-2,0"
                    Padding="{StaticResource Pulsar.Gap.Horizontal.XXS}"
                    Panel.ZIndex="100">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <!-- Only show if BadgeCount > 1 -->
                            <DataTrigger Binding="{Binding BadgeCount, ElementName=OrbRoot}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding BadgeCount, ElementName=OrbRoot}" Value="1">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding BadgeCount, ElementName=OrbRoot}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding BadgeCount, ElementName=OrbRoot}" 
                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" 
                           FontSize="8" 
                           FontWeight="Bold"
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"/>
            </Border>
    
            <!-- [UX] Text-only slot title: keep a local semi-opaque backplate behind the
                 text so it stays readable over any orb color or desktop background.
                 The Viewbox is sized proportionally to the orb itself (0.64x), so the
                 larger center slot gets a larger label while small ring slots stay
                 compact. MaxWidth=40 in design units keeps "取消" (22 units at FontSize
                 11) and short labels such as "Cancel"/"Back"/"Pulsar" fully visible; only very
                 long window/process titles are ellipsized before scaling. -->
            <Viewbox Stretch="Uniform"
                     StretchDirection="Both"
                     MaxWidth="{Binding Size, ElementName=OrbRoot, Converter={StaticResource SizeFactor}, ConverterParameter=0.64}"
                     MaxHeight="{Binding Size, ElementName=OrbRoot, Converter={StaticResource SizeFactor}, ConverterParameter=0.64}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center">
                <Border CornerRadius="{StaticResource Pulsar.Radius.MD}"
                        Padding="{StaticResource Pulsar.Pad.H2V2}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Background" Value="{DynamicResource Theme.Orb.Label.Background}"/>

                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding RenderGlyph, ElementName=OrbRoot}" Value=""/>
                                        <Condition Binding="{Binding ShowImage, ElementName=OrbRoot}" Value="False"/>
                                        <Condition Binding="{Binding Label, ElementName=OrbRoot, Converter={StaticResource StringEmptyToVisibilityConverter}}" Value="Visible"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <TextBlock Text="{Binding Label, ElementName=OrbRoot}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.Orb.Label.Foreground}"
                               MaxWidth="40"
                               TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </Viewbox>
            </Grid>
        </Viewbox>
    </Grid>

    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Opacity" Value="0.8"/>
            <Setter Property="Panel.ZIndex" Value="0"/>

            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.3"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <BlurEffect Radius="2"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>

                <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Panel.ZIndex" Value="99"/>
                    <!-- Scale/opacity enter & exit are driven in code-behind
                         (OnIsActiveChanged) so rapid hover flips can glide from
                         the current value instead of snapping to hard-coded
                         From values. -->
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
</UserControl>
