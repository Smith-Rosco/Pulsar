<UserControl x:Class="Pulsar.Views.Controls.SlotWheelEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Pulsar.Views.Controls"
             xmlns:converters="clr-namespace:Pulsar.Core.Converters"
             xmlns:lex="clr-namespace:Pulsar.Core.Localization"
             mc:Ignorable="d"
             d:DesignHeight="460" d:DesignWidth="360">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 自带数值令牌：使本控件可脱离 Application 上下文独立实例化
                     （SlotWheelEditorSmokeTests 直接 new SlotWheelEditor()）。
                     动画时长统一引用 Pulsar.Duration.*，禁止裸 Duration。 -->
                <ResourceDictionary Source="pack://application:,,,/Pulsar;component/Styles/Tokens.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Pulsar;component/Styles/ButtonStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Pulsar;component/Styles/SlotStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:DoubleMultiplyConverter x:Key="Multiply"/>
            <converters:NullableHexToBrushConverter x:Key="HexToBrush"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Wheel Host -->
        <Grid x:Name="WheelHost"
              Grid.Row="0"
              Width="{Binding CanvasSize, Mode=OneWay}"
              Height="{Binding CanvasSize, Mode=OneWay}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">

            <!-- Guide Ring -->
            <Ellipse Width="{Binding Radius, Mode=OneWay, Converter={StaticResource Multiply}, ConverterParameter=2}"
                     Height="{Binding Radius, Mode=OneWay, Converter={StaticResource Multiply}, ConverterParameter=2}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Style="{StaticResource SlotGuideRingStyle}"/>

            <!-- Center State (non-interactive: MRU/back area is not editable in settings) -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Opacity" Value="0.75"/>
                    </Style>
                </StackPanel.Style>
                <Border Width="44" Height="44"
                        CornerRadius="22"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="DialPad24"
                                   FontSize="{StaticResource Pulsar.Type.Title}"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{lex:Locale Settings.Slots.Wheel.CenterHint}"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"
                           FontSize="{StaticResource Pulsar.Type.Caption}"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
            </StackPanel>

            <!-- Slots -->
            <ItemsControl x:Name="WheelItems"
                          ItemsSource="{Binding Items}"
                          Focusable="True"
                          MouseMove="WheelItems_MouseMove"
                          MouseUp="WheelItems_MouseUp"
                          PreviewKeyDown="WheelItems_PreviewKeyDown"
                          ContextMenuOpening="WheelItems_ContextMenuOpening">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding ContainerX}"/>
                        <Setter Property="Canvas.Top" Value="{Binding ContainerY}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid x:Name="ItemRoot"
                              Tag="{Binding}"
                              Focusable="True"
                              Width="{Binding ContainerSize, Mode=OneWay}"
                              Height="{Binding ContainerSize, Mode=OneWay}"
                              RenderTransformOrigin="0.5,0.5"
                              MouseLeftButtonDown="Item_MouseLeftButtonDown"
                              ToolTip="{Binding Tooltip}">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="ItemScale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                            <Setter Property="Opacity" Value="0.35"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                         To="1.08" Duration="{StaticResource Pulsar.Duration.Fast}">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                         To="1.08" Duration="{StaticResource Pulsar.Duration.Fast}">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                         To="1" Duration="{StaticResource Pulsar.Duration.Normal}">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                         To="1" Duration="{StaticResource Pulsar.Duration.Normal}">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <!-- Position Badge + Orb + Actions (centered inner Size grid) -->
                            <Grid Width="{Binding Size, Mode=OneWay}"
                                  Height="{Binding Size, Mode=OneWay}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">

                                <!-- Position Badge (always visible, top-left) -->
                                <Border Style="{StaticResource SlotPositionBadgeStyle}">
                                    <TextBlock Text="{Binding Position}"
                                               Style="{StaticResource SlotPositionBadgeTextStyle}"/>
                                </Border>

                                <!-- Slot Orb -->
                                <controls:SlotOrb x:Name="Orb"
                                                  IconKey="{Binding IconKey}"
                                                  Label="{Binding Label}"
                                                  Size="{Binding Size, Mode=OneWay}"
                                                  Width="{Binding Size, Mode=OneWay}"
                                                  Height="{Binding Size, Mode=OneWay}"
                                                  IsTransparent="{Binding IsEmpty}"
                                                  CustomFill="{Binding ColorHex, Converter={StaticResource HexToBrush}}"
                                                  CustomStroke="{Binding ColorHex, Converter={StaticResource HexToBrush}}"
                                                  ShowActiveGlow="False"
                                                  ToolTip="{Binding Tooltip}"/>

                                <!-- Hover Edit/Delete Buttons (overlaid, do not affect slot layout) -->
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,0,-26">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True"/>
                                                        <Condition Binding="{Binding IsEmpty}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <ui:Button Style="{StaticResource PulsarIconButtonStyle}"
                                               Icon="{ui:SymbolIcon Edit24}"
                                               Tag="{Binding}"
                                               Click="HoverEdit_Click"
                                               Margin="0,0,4,0"
                                               ToolTip="{lex:Locale Settings.Slots.EditSlot}"/>
                                    <ui:Button Style="{StaticResource PulsarIconButtonStyle}"
                                               Icon="{ui:SymbolIcon Delete24}"
                                               Tag="{Binding}"
                                               Click="HoverDelete_Click"
                                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                               ToolTip="{lex:Locale Settings.Slots.RemoveSlot}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Empty Placeholder: dashed ring, accent on hover -->
                            <Ellipse Width="{Binding Size, Mode=OneWay, Converter={StaticResource Multiply}, ConverterParameter=1.3}"
                                     Height="{Binding Size, Mode=OneWay, Converter={StaticResource Multiply}, ConverterParameter=1.3}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse" BasedOn="{StaticResource SlotEmptyRingStyle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsEmpty}" Value="True"/>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <MultiDataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Pulsar.Duration.Fast}"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.EnterActions>
                                                <MultiDataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.55" Duration="{StaticResource Pulsar.Duration.Normal}"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.ExitActions>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>

                            <!-- Empty Placeholder Add Hint (plus glyph) -->
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ui:SymbolIcon Symbol="Add24"
                                               FontSize="{Binding Size, Mode=OneWay, Converter={StaticResource Multiply}, ConverterParameter=0.5}"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsEmpty}" Value="True"/>
                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                            </StackPanel>

                            <!-- Drop Target Ring -->
                            <Ellipse Width="{Binding Size, Mode=OneWay, Converter={StaticResource Multiply}, ConverterParameter=1.3}"
                                     Height="{Binding Size, Mode=OneWay, Converter={StaticResource Multiply}, ConverterParameter=1.3}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Stroke="{DynamicResource AccentFillColorDefaultBrush}"
                                     StrokeThickness="2"
                                     StrokeDashArray="4 3"
                                     IsHitTestVisible="False">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Opacity" Value="0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                                <Setter Property="Opacity" Value="0.85"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>

                            <!-- Hover Ring (occupied slots, accent on mouse-over) -->
                            <Ellipse Width="{Binding Size, Mode=OneWay, Converter={StaticResource Multiply}, ConverterParameter=1.3}"
                                     Height="{Binding Size, Mode=OneWay, Converter={StaticResource Multiply}, ConverterParameter=1.3}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Stroke="{DynamicResource AccentFillColorDefaultBrush}"
                                     StrokeThickness="2"
                                     IsHitTestVisible="False">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Opacity" Value="0"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsEmpty}" Value="False"/>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <MultiDataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.75" Duration="{StaticResource Pulsar.Duration.Fast}"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.EnterActions>
                                                <MultiDataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Pulsar.Duration.Normal}"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.ExitActions>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>

                            <!-- Highlight Ring (transient, pulse on/off) -->
                            <Ellipse Width="{Binding Size, Mode=OneWay, Converter={StaticResource Multiply}, ConverterParameter=1.35}"
                                     Height="{Binding Size, Mode=OneWay, Converter={StaticResource Multiply}, ConverterParameter=1.35}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Stroke="{DynamicResource AccentFillColorDefaultBrush}"
                                     StrokeThickness="2.5"
                                     IsHitTestVisible="False">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Opacity" Value="0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Pulsar.Duration.Fast}"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Pulsar.Duration.Slow}"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Drag Ghost Layer -->
            <Canvas x:Name="DragLayer" IsHitTestVisible="False"/>
        </Grid>

        <!-- Drag / Reorder Hint -->
        <TextBlock Grid.Row="1"
                   Text="{lex:Locale Settings.Slots.Wheel.DragDropHint}"
                   HorizontalAlignment="Center"
                   Margin="0,6,0,0"
                   FontSize="{StaticResource Pulsar.Type.Caption}"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>

        <!-- Pager -->
        <Border Grid.Row="2"
                Margin="0,10,0,0"
                Padding="12,6"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Style="{StaticResource PulsarIconButtonStyle}"
                           Icon="{ui:SymbolIcon ArrowLeft24}"
                           Command="{Binding GoPreviousPageCommand}"
                           IsEnabled="{Binding HasPreviousPage}"
                           ToolTip="{lex:Locale Settings.Slots.Wheel.PreviousPage}"/>
                <TextBlock VerticalAlignment="Center"
                           Margin="10,0,6,0"
                           FontSize="{StaticResource Pulsar.Type.Body}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <Run Text="{lex:Locale Settings.Slots.Wheel.PageLabel}"/>
                </TextBlock>
                <TextBlock VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           FontWeight="SemiBold"
                           FontSize="{StaticResource Pulsar.Type.Subtitle}"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                    <Run Text="{Binding PageDisplayText, Mode=OneWay}"/>
                </TextBlock>
                <ui:Button Style="{StaticResource PulsarIconButtonStyle}"
                           Icon="{ui:SymbolIcon ArrowRight24}"
                           Command="{Binding GoNextPageCommand}"
                           IsEnabled="{Binding HasNextPage}"
                           ToolTip="{lex:Locale Settings.Slots.Wheel.NextPage}"/>
                <Rectangle Width="1" Height="16"
                           Fill="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                           Margin="12,0"
                           VerticalAlignment="Center"/>
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <Run Text="{Binding TotalSlots, Mode=OneWay}"/>
                    <Run Text="{lex:Locale Settings.Slots.Wheel.SlotsUnit}"/>
                </TextBlock>
                <TextBlock VerticalAlignment="Center"
                           Margin="10,0,0,0"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                    <Run Text="{Binding SlotsPerPage, Mode=OneWay}"/>
                    <Run Text="{lex:Locale Settings.Slots.Wheel.PerPage}"/>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
