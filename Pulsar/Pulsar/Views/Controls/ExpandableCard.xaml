<UserControl x:Class="Pulsar.Views.Controls.ExpandableCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Pulsar.Views.Controls"
             xmlns:converters="clr-namespace:Pulsar.Core.Converters"
             mc:Ignorable="d" 
             x:Name="Root">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Pulsar;component/Styles/ButtonStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Pulsar;component/Styles/SlotStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:StringEmptyToVisibilityConverter x:Key="StringEmptyToVisibilityConverter"/>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <ui:CardExpander IsExpanded="{Binding IsExpanded, ElementName=Root, Mode=TwoWay}"
                     ContextMenu="{Binding CardContextMenu, ElementName=Root}"
                     Margin="{StaticResource Pulsar.Gap.Bottom.SM}"
                     HorizontalContentAlignment="Stretch">
        <ui:CardExpander.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon (slot orb) -->
                <Border Grid.Column="0"
                        Style="{StaticResource SlotOrbContainerStyle}"
                        Margin="{StaticResource Pulsar.Gap.Right.MD}"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}">
                    <controls:SlotOrb IconKey="{Binding IconKey, ElementName=Root}"
                                       Size="28"
                                       Width="28"
                                       Height="28"
                                       Margin="{StaticResource Pulsar.Pad.XS}"
                                       IsTransparent="True"
                                       ShowActiveGlow="False"/>
                </Border>

                <!-- Title Area -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <!-- Title -->
                    <TextBlock Text="{Binding Title, ElementName=Root}" 
                               FontSize="{StaticResource Pulsar.Type.Subtitle}" 
                               FontWeight="SemiBold"/>
                    
                    <!-- Subtitle + HeaderContent on same row -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Subtitle, ElementName=Root}" 
                                   FontSize="{StaticResource Pulsar.Type.Body}" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding Subtitle, ElementName=Root, Converter={StaticResource StringEmptyToVisibilityConverter}}"/>
                        
                        <!-- Header Content (e.g. position badge, chips) -->
                        <ContentPresenter Content="{Binding HeaderContent, ElementName=Root}"
                                          ContentTemplate="{Binding HeaderContentTemplate, ElementName=Root}"
                                          Margin="{StaticResource Pulsar.Gap.Left.SM}"
                                          VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                
                <!-- Primary Action Button -->
                <ui:Button Grid.Column="2"
                           Style="{StaticResource PulsarIconButtonStyle}"
                           Command="{Binding PrimaryActionCommand, ElementName=Root}"
                           CommandParameter="{Binding PrimaryActionCommandParameter, ElementName=Root}"
                           ToolTip="{Binding PrimaryActionTooltip, ElementName=Root}"
                           AutomationProperties.Name="{Binding PrimaryActionTooltip, ElementName=Root}"
                           Visibility="{Binding PrimaryActionVisibility, ElementName=Root}"
                           VerticalAlignment="Center"
                           Margin="{StaticResource Pulsar.Gap.Right.XS}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="{Binding PrimaryActionIcon, ElementName=Root, FallbackValue=Settings24, TargetNullValue=Settings24}" FontSize="{StaticResource Pulsar.Type.Subtitle}"/>
                    </ui:Button.Icon>
                </ui:Button>
                
                <!-- Secondary Action Button -->
                <ui:Button Grid.Column="3"
                           Style="{StaticResource PulsarIconButtonStyle}"
                           Command="{Binding SecondaryActionCommand, ElementName=Root}"
                           ToolTip="{Binding SecondaryActionTooltip, ElementName=Root}"
                           AutomationProperties.Name="{Binding SecondaryActionTooltip, ElementName=Root}"
                           Visibility="{Binding SecondaryActionVisibility, ElementName=Root}"
                           VerticalAlignment="Center"
                           Margin="{StaticResource Pulsar.Gap.Right.XS}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="{Binding SecondaryActionIcon, ElementName=Root, FallbackValue=DocumentText24, TargetNullValue=DocumentText24}" FontSize="{StaticResource Pulsar.Type.Subtitle}"/>
                    </ui:Button.Icon>
                </ui:Button>

                <!-- Toggle Switch -->
                <ui:ToggleSwitch Grid.Column="4" 
                                 IsChecked="{Binding IsToggleEnabled, ElementName=Root, Mode=TwoWay}" 
                                 IsEnabled="{Binding CanToggle, ElementName=Root}"
                                 Visibility="{Binding IsToggleVisible, ElementName=Root, Converter={StaticResource BoolToVis}}"
                                 Content=""
                                 VerticalAlignment="Center"
                                 Margin="{StaticResource Pulsar.Gap.Left.SM}"
                                 MinWidth="40"/>
            </Grid>
        </ui:CardExpander.Header>

        <!-- Expanded Content -->
        <Grid Tag="{Binding PageDataContext, ElementName=Root}">
            <ContentPresenter Content="{Binding ExpandedContent, ElementName=Root}"
                              ContentTemplate="{Binding ExpandedContentTemplate, ElementName=Root}"
                              Margin="{StaticResource Pulsar.Gap.Top.SM}"/>
        </Grid>
    </ui:CardExpander>
</UserControl>
