<Page x:Class="Pulsar.Views.Pages.SettingsExternalPluginsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:Pulsar.ViewModels.Settings"
      xmlns:lex="clr-namespace:Pulsar.Core.Localization"
      xmlns:converters="clr-namespace:Pulsar.Core.Converters"
      xmlns:controls="clr-namespace:Pulsar.Views.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="900"
      d:DataContext="{d:DesignInstance Type=vm:ExternalPluginManagerViewModel}"
      Title="SettingsExternalPluginsPage">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Pulsar;component/Styles/ButtonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisConverter"/>
            <converters:CollectionEmptyToVisibilityConverter x:Key="CollectionEmptyToVisibilityConverter"/>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- External Plugin Card Style -->
            <Style x:Key="ExternalPluginCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource SurfaceStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <controls:SettingsPageHeader Grid.Row="0"
                                     Title="{lex:Locale Settings.ExternalPlugins.Title}"
                                     Description="{lex:Locale Settings.ExternalPlugins.Description}">
            <controls:SettingsPageHeader.ActionsContent>
                <ui:Button Content="{lex:Locale Settings.ExternalPlugins.InstallFromFile}"
                           Command="{Binding InstallFromFileCommand}"
                           Icon="{ui:SymbolIcon FolderOpen24}"
                           Style="{StaticResource PulsarPrimaryButtonStyle}"
                           ToolTip="{lex:Locale Settings.ExternalPlugins.InstallFromFileTooltip}"/>
            </controls:SettingsPageHeader.ActionsContent>
        </controls:SettingsPageHeader>

        <!-- Main Content Area -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="{StaticResource Pulsar.Thk.T16R16}">
            <StackPanel>
                <!-- Loading Indicator -->
                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="{StaticResource Pulsar.Gap.Top.Hero}">
                    <ui:ProgressRing IsIndeterminate="True" Width="48" Height="48"/>
                    <TextBlock Text="{lex:Locale Settings.ExternalPlugins.LoadingPlugins}"
                               FontSize="{StaticResource Pulsar.Type.Subtitle}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="{StaticResource Pulsar.Gap.Top.LG}"/>
                </StackPanel>

                <!-- Installed External Plugins List -->
                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisConverter}}">
                    <!-- Section Header -->
                    <StackPanel Orientation="Horizontal" Margin="{StaticResource Pulsar.Gap.Bottom.LG}">
                        <TextBlock Text="{lex:Locale Settings.ExternalPlugins.InstalledPluginsHeader}"
                                   FontSize="{StaticResource Pulsar.Type.Subtitle}"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding InstalledPlugins.Count}"
                                   FontSize="{StaticResource Pulsar.Type.Subtitle}"
                                   FontWeight="SemiBold"
                                   Margin="{StaticResource Pulsar.Gap.Left.SM}"/>
                    </StackPanel>

                    <!-- Plugin Cards -->
                    <ItemsControl ItemsSource="{Binding InstalledPlugins}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ExternalPluginCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Plugin Icon -->
                                        <controls:SlotOrb Grid.Column="0"
                                                           IconKey="{Binding Icon}"
                                                           Size="48"
                                                           Width="48" Height="48"
                                                           IsTransparent="True"
                                                           ShowActiveGlow="False"
                                                           Margin="{StaticResource Pulsar.Gap.Right.LG}"
                                                           VerticalAlignment="Top"/>

                                        <!-- Plugin Info -->
                                        <StackPanel Grid.Column="1">
                                            <!-- Title and Version -->
                                            <StackPanel Orientation="Horizontal" Margin="{StaticResource Pulsar.Gap.Bottom.XS}">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="{StaticResource Pulsar.Type.Subtitle}"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                                
                                                <TextBlock Text="{Binding Version, StringFormat='v{0}'}"
                                                           FontSize="{StaticResource Pulsar.Type.Body}"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="{StaticResource Pulsar.Gap.Left.SM}"/>

                                                <!-- Installed Badge -->
                                                <Border Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                                                        CornerRadius="{StaticResource Pulsar.Radius.SM}"
                                                        Padding="{StaticResource Pulsar.Pad.H8V2}"
                                                        Margin="{StaticResource Pulsar.Gap.Left.SM}">
                                                    <TextBlock Text="{lex:Locale Settings.ExternalPlugins.Installed}"
                                                               FontSize="{StaticResource Pulsar.Type.Caption}"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Author -->
                                            <TextBlock FontSize="{StaticResource Pulsar.Type.Body}"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Margin="{StaticResource Pulsar.Gap.Bottom.SM}">
                                                <Run Text="{lex:Locale Settings.ExternalPlugins.ByAuthor}"/>
                                                <Run Text="{Binding Author, Mode=OneWay}"/>
                                            </TextBlock>

                                            <!-- Description -->
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="{StaticResource Pulsar.Type.Body}"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="{StaticResource Pulsar.Gap.Bottom.SM}"/>

                                            <!-- Installation Path -->
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Folder24" FontSize="{StaticResource Pulsar.Type.Body}" Margin="{StaticResource Pulsar.Gap.Right.SM}"/>
                                                <TextBlock Text="{Binding LocalPath}"
                                                           FontSize="{StaticResource Pulsar.Type.Caption}"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Action Buttons -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <!-- Grant Permissions (idempotent for installed plugins) -->
                                            <ui:Button Content="{lex:Locale Settings.ExternalPlugins.GrantPermissions}"
                                                       Command="{Binding DataContext.ApprovePluginPermissionsCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                       CommandParameter="{Binding}"
                                                       Icon="{ui:SymbolIcon Key24}"
                                                       Style="{StaticResource PulsarSecondaryButtonStyle}"
                                                       MinWidth="140"
                                                       Visibility="{Binding HasPermissions, Converter={StaticResource BoolToVis}}"/>
                                            <!-- Uninstall Button -->
                                            <ui:Button Content="{lex:Locale Settings.ExternalPlugins.Uninstall}"
                                                       Command="{Binding DataContext.UninstallPluginCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                       CommandParameter="{Binding}"
                                                       Icon="{ui:SymbolIcon Delete24}"
                                                       Style="{StaticResource PulsarDangerButtonStyle}"
                                                       MinWidth="140"
                                                       Margin="{StaticResource Pulsar.Gap.Top.SM}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty State -->
                    <controls:EmptyState Icon="Apps24"
                                         Title="{lex:Locale Settings.ExternalPlugins.NoPlugins}"
                                         Hint="{lex:Locale Settings.ExternalPlugins.InstallHint}"
                                         ActionText="{lex:Locale Settings.ExternalPlugins.InstallFromFile}"
                                         ActionIcon="FolderOpen24"
                                         ActionButtonStyle="{StaticResource PulsarPrimaryButtonStyle}"
                                         ActionCommand="{Binding InstallFromFileCommand}"
                                         HasBorder="True"
                                         Visibility="{Binding InstalledPlugins.Count, Converter={StaticResource CollectionEmptyToVisibilityConverter}}"/>

                    <!-- Info Note -->
                    <Border Background="{DynamicResource ControlFillColorDisabledBrush}"
                            BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Pulsar.Radius.LG}"
                            Padding="{StaticResource Pulsar.Pad.LG}"
                            Margin="{StaticResource Pulsar.Gap.Top.XXL}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="{StaticResource Pulsar.Gap.Bottom.SM}">
                                <ui:SymbolIcon Symbol="Info24" 
                                               FontSize="{StaticResource Pulsar.Type.Subtitle}" 
                                               Foreground="{DynamicResource SystemAccentBrush}"
                                               Margin="{StaticResource Pulsar.Gap.Right.SM}"/>
                                <TextBlock Text="{lex:Locale Settings.ExternalPlugins.AboutTitle}" 
                                           FontWeight="SemiBold"
                                           FontSize="{StaticResource Pulsar.Type.Subtitle}"/>
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       FontSize="{StaticResource Pulsar.Type.Body}"
                                       LineHeight="18">
                                <Run Text="{lex:Locale Settings.ExternalPlugins.AboutLine1}"/>
                                <LineBreak/>
                                <Run Text="{lex:Locale Settings.ExternalPlugins.AboutLine2}"/>
                                <Run Text="{lex:Locale Settings.ExternalPlugins.AboutLine3}" FontWeight="SemiBold"/>
                                <Run Text="{lex:Locale Settings.ExternalPlugins.AboutLine4}"/>
                                <LineBreak/>
                                <Run Text="{lex:Locale Settings.ExternalPlugins.AboutLine5}"/>
                                <LineBreak/>
                                <Run Text="{lex:Locale Settings.ExternalPlugins.AboutLine6}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Status Bar -->
        <Border Grid.Row="2"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="{StaticResource Pulsar.Pad.H16V8}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status Message -->
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           FontSize="{StaticResource Pulsar.Type.Body}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>

                <!-- Plugin Count -->
                <TextBlock Grid.Column="1"
                           FontSize="{StaticResource Pulsar.Type.Body}"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center">
                    <Run Text="{Binding InstalledPlugins.Count, Mode=OneWay}"/>
                    <Run Text="{lex:Locale Settings.ExternalPlugins.StatusCount}"/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Page>
