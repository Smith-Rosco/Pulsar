<Page x:Class="Pulsar.Views.Pages.SettingsAboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:Pulsar.ViewModels"
      xmlns:controls="clr-namespace:Pulsar.Views.Controls"
      xmlns:lex="clr-namespace:Pulsar.Core.Localization"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="{lex:Locale Settings.About.Title}">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Pulsar;component/Styles/ButtonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:SettingsPageHeader Grid.Row="0"
                                     Title="{lex:Locale Settings.About.Title}"
                                     Description="{lex:Locale Settings.About.Description}"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="{StaticResource Pulsar.Gap.Right.XL}" MaxWidth="700" HorizontalAlignment="Left">

                <!-- App Identity Card -->
                <ui:CardControl Margin="{StaticResource Pulsar.Gap.Bottom.LG}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" 
                                Width="80" 
                                Height="80" 
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Pulsar.Radius.XXL}"
                                Margin="{StaticResource Pulsar.Gap.Right.XL}">
                            <Image Width="52"
                                   Height="52"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Source="pack://application:,,,/Pulsar;component/Assets/Icons/pulsar-mark-256.png"
                                   Stretch="Uniform" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ProductName}"
                                       FontSize="{StaticResource Pulsar.Type.Body}" 
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Margin="{StaticResource Pulsar.Gap.Bottom.SM}"/>
                            <TextBlock Text="{Binding AppVersion}" 
                                       FontSize="{StaticResource Pulsar.Type.Subtitle}" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="{StaticResource Pulsar.Gap.Bottom.SM}"/>
                            <TextBlock Text="{Binding AppDescription}" 
                                       FontSize="{StaticResource Pulsar.Type.Body}" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       MaxWidth="500"
                                       HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Grid>
                </ui:CardControl>

                <!-- Software Update (ADR-025) -->
                <ui:CardExpander Icon="ArrowCircleUp24" Header="{lex:Locale Settings.About.UpdateTitle}" Margin="{StaticResource Pulsar.Gap.Bottom.MD}" IsExpanded="True">
                    <StackPanel>
                        <Grid Margin="{StaticResource Pulsar.Gap.Bottom.MD}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AppVersion}"
                                           FontSize="{StaticResource Pulsar.Type.Body}"
                                           FontWeight="Medium"
                                           Margin="{StaticResource Pulsar.Gap.Bottom.XS}"/>

                                <!-- UpToDate badge -->
                                <TextBlock Text="{lex:Locale Settings.About.UpdateStatusUpToDate}"
                                           Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                           FontSize="{StaticResource Pulsar.Type.Caption}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UpdateState}" Value="UpToDate">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- UpdateAvailable badge -->
                                <TextBlock Text="{Binding UpdateLatestTag, StringFormat={}{0} available}"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                           FontSize="{StaticResource Pulsar.Type.Caption}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UpdateState}" Value="UpdateAvailable">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Checking badge -->
                                <TextBlock Text="{lex:Locale Settings.About.UpdateStatusChecking}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="{StaticResource Pulsar.Type.Caption}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UpdateState}" Value="Checking">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Failed badge -->
                                <TextBlock Text="{Binding UpdateErrorMessage}"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                           FontSize="{StaticResource Pulsar.Type.Caption}"
                                           TextWrapping="Wrap"
                                           MaxWidth="400">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UpdateState}" Value="Failed">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <!-- Check button (visible when not checking/downloading) -->
                            <ui:Button Grid.Column="1"
                                       Content="{lex:Locale Settings.About.CheckForUpdates}"
                                       Icon="{ui:SymbolIcon ArrowClockwise24}"
                                       Command="{Binding CheckForUpdatesCommand}"
                                       VerticalAlignment="Center">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource PulsarSecondaryButtonStyle}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UpdateState}" Value="Checking">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding UpdateState}" Value="Downloading">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding UpdateState}" Value="ReadyToInstall">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                        </Grid>

                        <!-- Download progress (visible when Downloading) -->
                        <StackPanel Margin="{StaticResource Pulsar.Gap.Bottom.MD}">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UpdateState}" Value="Downloading">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{lex:Locale Settings.About.Downloading}"
                                       FontSize="{StaticResource Pulsar.Type.Caption}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="{StaticResource Pulsar.Gap.Bottom.XS}"/>
                            <ProgressBar Value="{Binding UpdateDownloadProgress}"
                                         Minimum="0" Maximum="1"
                                         Height="4"/>
                        </StackPanel>

                        <!-- Download button (visible when UpdateAvailable) -->
                        <ui:Button Content="{lex:Locale Settings.About.DownloadUpdate}"
                                   Icon="{ui:SymbolIcon ArrowDownload24}"
                                   Command="{Binding DownloadUpdateCommand}"
                                   HorizontalAlignment="Left"
                                   Margin="{StaticResource Pulsar.Gap.Bottom.SM}">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource PulsarPrimaryButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UpdateState}" Value="UpdateAvailable">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>

                        <!-- Install button (visible when ReadyToInstall) -->
                        <ui:Button Content="{lex:Locale Settings.About.InstallUpdate}"
                                   Icon="{ui:SymbolIcon Play24}"
                                   Command="{Binding InstallUpdateCommand}"
                                   HorizontalAlignment="Left">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource PulsarPrimaryButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UpdateState}" Value="ReadyToInstall">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                    </StackPanel>
                </ui:CardExpander>

                <!-- Configuration Backup -->
                <ui:CardExpander Icon="Archive24" Header="{lex:Locale Settings.About.ConfigBackupTitle}" Margin="{StaticResource Pulsar.Gap.Bottom.MD}" IsExpanded="True">
                    <StackPanel>
                        <TextBlock Text="{lex:Locale Settings.About.ConfigBackupDescription}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="{StaticResource Pulsar.Type.Body}"
                                   TextWrapping="Wrap"
                                   Margin="{StaticResource Pulsar.Gap.Bottom.MD}"/>
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="{lex:Locale Settings.About.ExportConfig}"
                                       Icon="{ui:SymbolIcon SaveArrowRight24}"
                                       Command="{Binding ExportConfigCommand}"
                                       Style="{StaticResource PulsarPrimaryButtonStyle}"
                                       Margin="{StaticResource Pulsar.Gap.Right.SM}"/>
                            <ui:Button Content="{lex:Locale Settings.About.ImportConfig}"
                                       Icon="{ui:SymbolIcon FolderOpen24}"
                                       Command="{Binding ImportConfigCommand}"
                                       Style="{StaticResource PulsarSecondaryButtonStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </ui:CardExpander>

                <!-- Links -->
                <ui:CardExpander Icon="Link24" Header="{lex:Locale Settings.About.Links}" Margin="{StaticResource Pulsar.Gap.Bottom.MD}" IsExpanded="True">
                    <StackPanel>
                        <controls:SettingsRow Title="{lex:Locale Settings.About.GitHub}"
                                              Description="{lex:Locale Settings.About.GitHubDescription}">
                            <ui:Button Content="{lex:Locale Settings.About.Open}"
                                       Icon="{ui:SymbolIcon Open24}"
                                       Command="{Binding OpenGitHubCommand}"
                                       Style="{StaticResource PulsarSecondaryButtonStyle}"
                                       AutomationProperties.Name="{lex:Locale Settings.About.GitHub}"/>
                        </controls:SettingsRow>

                        <controls:SettingsRow Title="{lex:Locale Settings.About.Documentation}"
                                              Description="{lex:Locale Settings.About.DocumentationDescription}">
                            <ui:Button Content="{lex:Locale Settings.About.Open}"
                                       Icon="{ui:SymbolIcon Book24}"
                                       Command="{Binding OpenDocumentationCommand}"
                                       Style="{StaticResource PulsarSecondaryButtonStyle}"
                                       AutomationProperties.Name="{lex:Locale Settings.About.Documentation}"/>
                        </controls:SettingsRow>

                        <controls:SettingsRow Title="{lex:Locale Settings.About.UserManual}"
                                              Description="{lex:Locale Settings.About.UserManualDescription}">
                            <ui:Button Content="{lex:Locale Settings.About.Open}"
                                       Icon="{ui:SymbolIcon ReadingList20}"
                                       Command="{Binding OpenUserManualCommand}"
                                       Style="{StaticResource PulsarSecondaryButtonStyle}"
                                       AutomationProperties.Name="{lex:Locale Settings.About.UserManual}"/>
                        </controls:SettingsRow>

                        <controls:SettingsRow Title="{lex:Locale Settings.About.License}"
                                              Description="{lex:Locale Settings.About.LicenseDescription}">
                            <ui:Button Content="{lex:Locale Settings.About.Open}"
                                       Icon="{ui:SymbolIcon Document24}"
                                       Command="{Binding OpenLicenseCommand}"
                                       Style="{StaticResource PulsarSecondaryButtonStyle}"
                                       AutomationProperties.Name="{lex:Locale Settings.About.License}"/>
                        </controls:SettingsRow>
                    </StackPanel>
                </ui:CardExpander>

                <!-- System Information -->
                <ui:CardExpander Icon="Info24" Header="{lex:Locale Settings.About.SystemInfo}" Margin="{StaticResource Pulsar.Gap.Bottom.MD}" IsExpanded="False">
                    <StackPanel>
                        <Grid Margin="{StaticResource Pulsar.Gap.Bottom.MD}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{lex:Locale Settings.About.Framework}" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                       FontSize="{StaticResource Pulsar.Type.Body}"/>
                            <TextBlock Grid.Column="1" 
                                       Text="{Binding Framework}" 
                                       FontWeight="Medium"
                                       FontSize="{StaticResource Pulsar.Type.Body}"/>
                        </Grid>

                        <Grid Margin="{StaticResource Pulsar.Gap.Bottom.MD}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{lex:Locale Settings.About.RuntimeVersion}" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                       FontSize="{StaticResource Pulsar.Type.Body}"/>
                            <TextBlock Grid.Column="1" 
                                       Text="{Binding RuntimeVersion}" 
                                       FontWeight="Medium"
                                       FontSize="{StaticResource Pulsar.Type.Body}"/>
                        </Grid>

                        <Grid Margin="{StaticResource Pulsar.Gap.Bottom.MD}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{lex:Locale Settings.About.Architecture}" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                       FontSize="{StaticResource Pulsar.Type.Body}"/>
                            <TextBlock Grid.Column="1" 
                                       Text="{Binding Architecture}" 
                                       FontWeight="Medium"
                                       FontSize="{StaticResource Pulsar.Type.Body}"/>
                        </Grid>

                        <Grid Margin="{StaticResource Pulsar.Gap.Bottom.MD}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{lex:Locale Settings.About.Build}" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                       FontSize="{StaticResource Pulsar.Type.Body}"/>
                            <TextBlock Grid.Column="1" 
                                       Text="{Binding BuildConfiguration}" 
                                       FontWeight="Medium"
                                       FontSize="{StaticResource Pulsar.Type.Body}"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{lex:Locale Settings.About.Copyright}" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                       FontSize="{StaticResource Pulsar.Type.Body}"/>
                            <TextBlock Grid.Column="1" 
                                       Text="{Binding Copyright}" 
                                       FontWeight="Medium"
                                       FontSize="{StaticResource Pulsar.Type.Body}"/>
                        </Grid>

                        <Separator Margin="{StaticResource Pulsar.Gap.Vertical.LG}"/>

                        <ui:Button Content="{lex:Locale Settings.About.CopySystemInfo}"
                                   Icon="{ui:SymbolIcon Copy24}"
                                   Command="{Binding CopySystemInfoCommand}"
                                   Style="{StaticResource PulsarSecondaryButtonStyle}"
                                   HorizontalAlignment="Left"/>
                    </StackPanel>
                </ui:CardExpander>

                <!-- Credits -->
                <ui:CardExpander Icon="People24" Header="{lex:Locale Settings.About.Credits}" Margin="{StaticResource Pulsar.Gap.Bottom.MD}" IsExpanded="False">
                    <StackPanel>
                        <TextBlock Text="{lex:Locale Settings.About.BuiltWith}" 
                                   FontSize="{StaticResource Pulsar.Type.Body}" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="{StaticResource Pulsar.Gap.Bottom.MD}"/>

                        <!-- UI & Input -->
                        <TextBlock Text="{lex:Locale Settings.About.CreditsGroupUi}" 
                                   FontSize="{StaticResource Pulsar.Type.Caption}" 
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="{StaticResource Pulsar.Gap.Bottom.XS}"/>
                        <StackPanel Margin="{StaticResource Pulsar.Thk.L16B8}">
                            <StackPanel Orientation="Horizontal" Margin="{StaticResource Pulsar.Gap.Bottom.XXS}">
                                <TextBlock Text="•" Margin="{StaticResource Pulsar.Gap.Right.SM}" FontSize="{StaticResource Pulsar.Type.Body}"/>
                                <TextBlock Text="{lex:Locale Settings.About.WpfUi}" FontWeight="Medium" FontSize="{StaticResource Pulsar.Type.Body}" Margin="{StaticResource Pulsar.Gap.Right.XS}"/>
                                <TextBlock Text="{lex:Locale Settings.About.WpfUiDescription}" FontSize="{StaticResource Pulsar.Type.Body}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="{StaticResource Pulsar.Gap.Bottom.XXS}">
                                <TextBlock Text="•" Margin="{StaticResource Pulsar.Gap.Right.SM}" FontSize="{StaticResource Pulsar.Type.Body}"/>
                                <TextBlock Text="{lex:Locale Settings.About.HardcodetNotifyIcon}" FontWeight="Medium" FontSize="{StaticResource Pulsar.Type.Body}" Margin="{StaticResource Pulsar.Gap.Right.XS}"/>
                                <TextBlock Text="{lex:Locale Settings.About.HardcodetNotifyIconDescription}" FontSize="{StaticResource Pulsar.Type.Body}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="•" Margin="{StaticResource Pulsar.Gap.Right.SM}" FontSize="{StaticResource Pulsar.Type.Body}"/>
                                <TextBlock Text="{lex:Locale Settings.About.GongDragDrop}" FontWeight="Medium" FontSize="{StaticResource Pulsar.Type.Body}" Margin="{StaticResource Pulsar.Gap.Right.XS}"/>
                                <TextBlock Text="{lex:Locale Settings.About.GongDragDropDescription}" FontSize="{StaticResource Pulsar.Type.Body}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- MVVM & DI -->
                        <TextBlock Text="{lex:Locale Settings.About.CreditsGroupMvvm}" 
                                   FontSize="{StaticResource Pulsar.Type.Caption}" 
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="{StaticResource Pulsar.Thk.T8B4}"/>
                        <StackPanel Margin="{StaticResource Pulsar.Thk.L16B8}">
                            <StackPanel Orientation="Horizontal" Margin="{StaticResource Pulsar.Gap.Bottom.XXS}">
                                <TextBlock Text="•" Margin="{StaticResource Pulsar.Gap.Right.SM}" FontSize="{StaticResource Pulsar.Type.Body}"/>
                                <TextBlock Text="{lex:Locale Settings.About.CommunityToolkit}" FontWeight="Medium" FontSize="{StaticResource Pulsar.Type.Body}" Margin="{StaticResource Pulsar.Gap.Right.XS}"/>
                                <TextBlock Text="{lex:Locale Settings.About.CommunityToolkitDescription}" FontSize="{StaticResource Pulsar.Type.Body}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="•" Margin="{StaticResource Pulsar.Gap.Right.SM}" FontSize="{StaticResource Pulsar.Type.Body}"/>
                                <TextBlock Text="{lex:Locale Settings.About.MsDi}" FontWeight="Medium" FontSize="{StaticResource Pulsar.Type.Body}" Margin="{StaticResource Pulsar.Gap.Right.XS}"/>
                                <TextBlock Text="{lex:Locale Settings.About.MsDiDescription}" FontSize="{StaticResource Pulsar.Type.Body}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Logging & Telemetry -->
                        <TextBlock Text="{lex:Locale Settings.About.CreditsGroupLogging}" 
                                   FontSize="{StaticResource Pulsar.Type.Caption}" 
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="{StaticResource Pulsar.Thk.T8B4}"/>
                        <StackPanel Margin="{StaticResource Pulsar.Thk.L16B8}">
                            <StackPanel Orientation="Horizontal" Margin="{StaticResource Pulsar.Gap.Bottom.XXS}">
                                <TextBlock Text="•" Margin="{StaticResource Pulsar.Gap.Right.SM}" FontSize="{StaticResource Pulsar.Type.Body}"/>
                                <TextBlock Text="{lex:Locale Settings.About.Serilog}" FontWeight="Medium" FontSize="{StaticResource Pulsar.Type.Body}" Margin="{StaticResource Pulsar.Gap.Right.XS}"/>
                                <TextBlock Text="{lex:Locale Settings.About.SerilogDescription}" FontSize="{StaticResource Pulsar.Type.Body}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="•" Margin="{StaticResource Pulsar.Gap.Right.SM}" FontSize="{StaticResource Pulsar.Type.Body}"/>
                                <TextBlock Text="{lex:Locale Settings.About.OpenTelemetry}" FontWeight="Medium" FontSize="{StaticResource Pulsar.Type.Body}" Margin="{StaticResource Pulsar.Gap.Right.XS}"/>
                                <TextBlock Text="{lex:Locale Settings.About.OpenTelemetryDescription}" FontSize="{StaticResource Pulsar.Type.Body}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Data & Configuration -->
                        <TextBlock Text="{lex:Locale Settings.About.CreditsGroupData}" 
                                   FontSize="{StaticResource Pulsar.Type.Caption}" 
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="{StaticResource Pulsar.Thk.T8B4}"/>
                        <StackPanel Margin="{StaticResource Pulsar.Thk.L16B8}">
                            <StackPanel Orientation="Horizontal" Margin="{StaticResource Pulsar.Gap.Bottom.XXS}">
                                <TextBlock Text="•" Margin="{StaticResource Pulsar.Gap.Right.SM}" FontSize="{StaticResource Pulsar.Type.Body}"/>
                                <TextBlock Text="{lex:Locale Settings.About.DataSqlite}" FontWeight="Medium" FontSize="{StaticResource Pulsar.Type.Body}" Margin="{StaticResource Pulsar.Gap.Right.XS}"/>
                                <TextBlock Text="{lex:Locale Settings.About.DataSqliteDescription}" FontSize="{StaticResource Pulsar.Type.Body}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="{StaticResource Pulsar.Gap.Bottom.XXS}">
                                <TextBlock Text="•" Margin="{StaticResource Pulsar.Gap.Right.SM}" FontSize="{StaticResource Pulsar.Type.Body}"/>
                                <TextBlock Text="{lex:Locale Settings.About.Tomlyn}" FontWeight="Medium" FontSize="{StaticResource Pulsar.Type.Body}" Margin="{StaticResource Pulsar.Gap.Right.XS}"/>
                                <TextBlock Text="{lex:Locale Settings.About.TomlynDescription}" FontSize="{StaticResource Pulsar.Type.Body}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="{StaticResource Pulsar.Gap.Bottom.XXS}">
                                <TextBlock Text="•" Margin="{StaticResource Pulsar.Gap.Right.SM}" FontSize="{StaticResource Pulsar.Type.Body}"/>
                                <TextBlock Text="{lex:Locale Settings.About.NUglify}" FontWeight="Medium" FontSize="{StaticResource Pulsar.Type.Body}" Margin="{StaticResource Pulsar.Gap.Right.XS}"/>
                                <TextBlock Text="{lex:Locale Settings.About.NUglifyDescription}" FontSize="{StaticResource Pulsar.Type.Body}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="•" Margin="{StaticResource Pulsar.Gap.Right.SM}" FontSize="{StaticResource Pulsar.Type.Body}"/>
                                <TextBlock Text="{lex:Locale Settings.About.NuGetVersioning}" FontWeight="Medium" FontSize="{StaticResource Pulsar.Type.Body}" Margin="{StaticResource Pulsar.Gap.Right.XS}"/>
                                <TextBlock Text="{lex:Locale Settings.About.NuGetVersioningDescription}" FontSize="{StaticResource Pulsar.Type.Body}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Native & Platform -->
                        <TextBlock Text="{lex:Locale Settings.About.CreditsGroupInterop}" 
                                   FontSize="{StaticResource Pulsar.Type.Caption}" 
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="{StaticResource Pulsar.Thk.T8B4}"/>
                        <StackPanel Margin="{StaticResource Pulsar.Gap.Left.LG}">
                            <StackPanel Orientation="Horizontal" Margin="{StaticResource Pulsar.Gap.Bottom.XXS}">
                                <TextBlock Text="•" Margin="{StaticResource Pulsar.Gap.Right.SM}" FontSize="{StaticResource Pulsar.Type.Body}"/>
                                <TextBlock Text="{lex:Locale Settings.About.CsWin32}" FontWeight="Medium" FontSize="{StaticResource Pulsar.Type.Body}" Margin="{StaticResource Pulsar.Gap.Right.XS}"/>
                                <TextBlock Text="{lex:Locale Settings.About.CsWin32Description}" FontSize="{StaticResource Pulsar.Type.Body}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="•" Margin="{StaticResource Pulsar.Gap.Right.SM}" FontSize="{StaticResource Pulsar.Type.Body}"/>
                                <TextBlock Text="{lex:Locale Settings.About.DrawingCommon}" FontWeight="Medium" FontSize="{StaticResource Pulsar.Type.Body}" Margin="{StaticResource Pulsar.Gap.Right.XS}"/>
                                <TextBlock Text="{lex:Locale Settings.About.DrawingCommonDescription}" FontSize="{StaticResource Pulsar.Type.Body}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ui:CardExpander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
