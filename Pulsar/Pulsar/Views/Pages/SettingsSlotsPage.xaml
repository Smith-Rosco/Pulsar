<Page x:Class="Pulsar.Views.Pages.SettingsSlotsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:converters="clr-namespace:Pulsar.Core.Converters"
      xmlns:controls="clr-namespace:Pulsar.Views.Controls"
      xmlns:tutorial="clr-namespace:Pulsar.Features.Tutorial.Helpers"
      xmlns:lex="clr-namespace:Pulsar.Core.Localization"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="800"
      Title="{lex:Locale Settings.Slots.Title}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Pulsar;component/Styles/ButtonStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Pulsar;component/Styles/SlotStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <converters:StringEmptyToVisibilityConverter x:Key="StringEmptyToVis"/>
            <converters:IsImagePathConverter x:Key="IsImagePath"/>
            <converters:StringPathToImageSourceConverter x:Key="PathToImage"/>
            <converters:HexToBrushConverter x:Key="HexToBrush"/>
            <converters:SlotBrushConverter x:Key="SlotBrushConverter"/>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Unified Page Header: Title + Context Switcher + Profile Actions all in one row -->
        <controls:SettingsPageHeader Grid.Row="0"
                                     Title="{lex:Locale Settings.Slots.Slots}"
                                     Description="{lex:Locale Settings.Slots.Description}">
            <controls:SettingsPageHeader.ActionsContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Context Switcher -->
                    <ComboBox ItemsSource="{Binding AvailableContexts}"
                              SelectedItem="{Binding CurrentContext, Mode=TwoWay}"
                              MinWidth="160"
                              MaxWidth="240"
                              VerticalAlignment="Center"
                              Margin="{StaticResource Pulsar.Gap.Right.MD}">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <controls:SlotOrb Grid.Column="0"
                                                       IconKey="{Binding Icon}"
                                                       Size="20"
                                                       Width="20" Height="20"
                                                       IsTransparent="True"
                                                       ShowActiveGlow="False"
                                                       Margin="{StaticResource Pulsar.Gap.Right.SM}"
                                                       VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DisplayName}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding SlotCount, StringFormat={lex:Locale Settings.Slots.SlotCountFormat}}"
                                               FontSize="{StaticResource Pulsar.Type.Caption}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Margin="{StaticResource Pulsar.Gap.Left.SM}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Divider -->
                    <Rectangle Width="1" Height="18"
                               Fill="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                               Margin="{StaticResource Pulsar.Gap.Right.MD}"
                               VerticalAlignment="Center"/>

                    <!-- Edit Profile -->
                    <ui:Button Style="{StaticResource PulsarIconButtonStyle}"
                               Icon="{ui:SymbolIcon Edit20}"
                               Command="{Binding EditProfileCommand}"
                               Visibility="{Binding CanEditProfile, Converter={StaticResource BoolToVis}}"
                               ToolTip="{lex:Locale Settings.Slots.EditProfile}"
                               Margin="{StaticResource Pulsar.Gap.Right.SM}"/>

                    <!-- Add Profile -->
                    <ui:Button Content="{lex:Locale Settings.Slots.NewProfile}"
                               Icon="{ui:SymbolIcon Add24}"
                               Style="{StaticResource PulsarSecondaryButtonStyle}"
                               ToolTip="{lex:Locale Settings.Slots.NewProfileTooltip}"
                               Command="{Binding AddProfileDialogCommand}"
                               Margin="{StaticResource Pulsar.Gap.Right.SM}"/>

                    <!-- Delete Profile -->
                    <ui:Button Style="{StaticResource PulsarIconButtonStyle}"
                               Icon="{ui:SymbolIcon Delete24}"
                               Command="{Binding DeleteProfileCommand}"
                               ToolTip="{lex:Locale Settings.Slots.DeleteProfileTooltip}"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               Visibility="{Binding CanDeleteProfile, Converter={StaticResource BoolToVis}}"/>

                </StackPanel>
            </controls:SettingsPageHeader.ActionsContent>
        </controls:SettingsPageHeader>

        <!-- Slots Area: Wheel editor + FAB overlay -->
        <Grid Grid.Row="1">

            <!-- Empty State -->
            <controls:EmptyState Icon="DialPadOff24"
                                 Title="{lex:Locale Settings.Slots.NoSlotsConfigured}"
                                 Hint="{lex:Locale Settings.Slots.AddSlotHint}"
                                 ActionText="{lex:Locale Settings.Slots.AddFirstSlot}"
                                 ActionIcon="Add24"
                                 ActionButtonStyle="{StaticResource PulsarPrimaryButtonStyle}"
                                 ActionCommand="{Binding AddSlotDialogCommand}"
                                 Margin="{StaticResource Pulsar.Gap.Bottom.Hero}">
                <controls:EmptyState.Style>
                    <Style TargetType="controls:EmptyState">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentSlots.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentSlots}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:EmptyState.Style>
            </controls:EmptyState>

            <!-- Slot Wheel Editor (replaces the legacy card list) -->
            <controls:SlotWheelEditor x:Name="WheelEditor"
                                      Margin="{StaticResource Pulsar.Gap.Top.SM}"
                                      VerticalAlignment="Center"
                                      EditRequested="WheelEditor_EditRequested"
                                      DeleteRequested="WheelEditor_DeleteRequested"
                                      AddSlotRequested="WheelEditor_AddSlotRequested">
                <controls:SlotWheelEditor.Style>
                    <Style TargetType="controls:SlotWheelEditor">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TotalSlots}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:SlotWheelEditor.Style>
            </controls:SlotWheelEditor>

            <!-- FAB: Add Slot (floating, bottom-right) -->
            <ui:Button x:Name="AddSlotFab"
                       Icon="{ui:SymbolIcon Add24}"
                       Content="{lex:Locale Settings.Slots.AddSlot}"
                       Style="{StaticResource PulsarPrimaryButtonStyle}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Margin="{StaticResource Pulsar.Thk.R24B20}"
                       Command="{Binding AddSlotDialogCommand}"
                       tutorial:TutorialMarker.Id="AddSlotButton"/>

        </Grid>
    </Grid>
</Page>
