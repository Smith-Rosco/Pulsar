<Page x:Class="Pulsar.Views.Pages.SettingsGeneralPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:Pulsar.ViewModels"
      xmlns:models="clr-namespace:Pulsar.Models"
      xmlns:controls="clr-namespace:Pulsar.Views.Controls"
      xmlns:lex="clr-namespace:Pulsar.Core.Localization"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="{lex:Locale Settings.General.Title}">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Pulsar;component/Styles/ButtonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Unified Page Header -->
        <controls:SettingsPageHeader Grid.Row="0"
                                     Title="{lex:Locale Settings.General.Title}"
                                     Description="{lex:Locale Settings.General.Description}">
            <controls:SettingsPageHeader.ActionsContent>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="{lex:Locale Settings.General.OpenLogs}"
                               Icon="{ui:SymbolIcon FolderOpen24}"
                               Command="{Binding OpenLogsFolderCommand}"
                               Style="{StaticResource PulsarSecondaryButtonStyle}"
                               Margin="{StaticResource Pulsar.Gap.Right.SM}"/>
                    <ui:Button Content="{lex:Locale Settings.General.ResetDefaults}"
                               Icon="{ui:SymbolIcon ArrowReset24}"
                               Command="{Binding ResetConfigCommand}"
                               Style="{StaticResource PulsarDangerButtonStyle}"/>
                </StackPanel>
            </controls:SettingsPageHeader.ActionsContent>
        </controls:SettingsPageHeader>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel DataContext="{Binding GeneralSettings}" Margin="{StaticResource Pulsar.Gap.Right.XL}">
                
                <!-- Appearance Section -->
                <ui:CardExpander Icon="Color24" Header="{lex:Locale Settings.General.Appearance}" Margin="{StaticResource Pulsar.Gap.Bottom.MD}" IsExpanded="True">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{lex:Locale Settings.General.Theme}" FontWeight="Medium"/>
                                <TextBlock Text="{lex:Locale Settings.General.ThemeDescription}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="{StaticResource Pulsar.Type.Body}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="150"
                                      SelectedValue="{Binding DataContext.CurrentTheme, RelativeSource={RelativeSource AncestorType=Page}}"
                                      SelectedValuePath="Tag"
                                      AutomationProperties.Name="{lex:Locale Settings.General.Theme}">
                                <ComboBoxItem Tag="Dark">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="WeatherMoon20" FontSize="{StaticResource Pulsar.Type.Subtitle}" Margin="{StaticResource Pulsar.Gap.Right.SM}"/>
                                        <TextBlock Text="{lex:Locale Settings.General.Dark}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="Light">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="WeatherSunny20" FontSize="{StaticResource Pulsar.Type.Subtitle}" Margin="{StaticResource Pulsar.Gap.Right.SM}"/>
                                        <TextBlock Text="{lex:Locale Settings.General.Light}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ComboBoxItem>
                            </ComboBox>
                        </Grid>

                        <Separator Margin="{StaticResource Pulsar.Gap.Vertical.MD}"/>

                        <Grid Margin="{StaticResource Pulsar.Gap.Bottom.MD}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{lex:Locale Settings.Appearance.RendererStyle}" FontWeight="Medium"/>
                                <TextBlock Text="{lex:Locale Settings.Appearance.RendererStyleDescription}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="{StaticResource Pulsar.Type.Body}"
                                           TextWrapping="Wrap"
                                           MaxWidth="420"
                                           Margin="{StaticResource Pulsar.Gap.Top.XS}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="160"
                                      SelectedValue="{Binding DataContext.RendererStyle, RelativeSource={RelativeSource AncestorType=Page}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Tag"
                                      AutomationProperties.Name="{lex:Locale Settings.Appearance.RendererStyle}">
                                <ComboBoxItem Tag="Default">
                                    <TextBlock Text="{lex:Locale Settings.Appearance.RendererStyle.Default}" VerticalAlignment="Center"/>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="ClassicRing">
                                    <TextBlock Text="{lex:Locale Settings.Appearance.RendererStyle.ClassicRing}" VerticalAlignment="Center"/>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="Glassmorphism">
                                    <TextBlock Text="{lex:Locale Settings.Appearance.RendererStyle.Glassmorphism}" VerticalAlignment="Center"/>
                                </ComboBoxItem>
                            </ComboBox>
                        </Grid>

                        <Separator Margin="{StaticResource Pulsar.Gap.Vertical.MD}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{lex:Locale Settings.Appearance.ThemePreset}" FontWeight="Medium"/>
                                <TextBlock Text="{lex:Locale Settings.Appearance.ThemePresetDescription}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="{StaticResource Pulsar.Type.Body}"
                                           TextWrapping="Wrap"
                                           MaxWidth="420"
                                           Margin="{StaticResource Pulsar.Gap.Top.XS}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="160"
                                      SelectedValue="{Binding DataContext.ThemePreset, RelativeSource={RelativeSource AncestorType=Page}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Tag"
                                      AutomationProperties.Name="{lex:Locale Settings.Appearance.ThemePreset}">
                                <ComboBoxItem Tag="System">
                                    <TextBlock Text="{lex:Locale Settings.Appearance.ThemePreset.System}" VerticalAlignment="Center"/>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="Dark">
                                    <TextBlock Text="{lex:Locale Settings.Appearance.ThemePreset.Dark}" VerticalAlignment="Center"/>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="Light">
                                    <TextBlock Text="{lex:Locale Settings.Appearance.ThemePreset.Light}" VerticalAlignment="Center"/>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="MatchaForest">
                                    <TextBlock Text="{lex:Locale Settings.Appearance.ThemePreset.MatchaForest}" VerticalAlignment="Center"/>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="GlacialIce">
                                    <TextBlock Text="{lex:Locale Settings.Appearance.ThemePreset.GlacialIce}" VerticalAlignment="Center"/>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="MorandiMuted">
                                    <TextBlock Text="{lex:Locale Settings.Appearance.ThemePreset.MorandiMuted}" VerticalAlignment="Center"/>
                                </ComboBoxItem>
                            </ComboBox>
                        </Grid>

                        <Separator Margin="{StaticResource Pulsar.Gap.Vertical.MD}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{lex:Locale Settings.General.Language}" FontWeight="Medium"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="140"
                                      ItemsSource="{Binding DataContext.SupportedLanguages, RelativeSource={RelativeSource AncestorType=Page}}"
                                      SelectedItem="{Binding DataContext.SelectedLanguage, RelativeSource={RelativeSource AncestorType=Page}}"
                                      DisplayMemberPath="DisplayName"/>
                        </Grid>
                    </StackPanel>
                </ui:CardExpander>

                <!-- Radial Menu Layout Section -->
                <ui:CardExpander Icon="Apps24" Header="{lex:Locale Settings.General.RadialMenuLayout}" Margin="{StaticResource Pulsar.Gap.Bottom.MD}" IsExpanded="False">
                    <StackPanel>
                        <Grid Margin="{StaticResource Pulsar.Gap.Bottom.MD}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{lex:Locale Settings.General.SlotsPerPage}" FontWeight="Medium"/>
                                <TextBlock Text="{Binding DataContext.SlotsPerPagePreview, RelativeSource={RelativeSource AncestorType=Page}}" 
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                           FontSize="{StaticResource Pulsar.Type.Body}"
                                           Margin="{StaticResource Pulsar.Gap.Top.XS}"/>
                            </StackPanel>
                            <ui:NumberBox Grid.Column="1"
                                          Value="{Binding SlotsPerPage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Minimum="4"
                                          Maximum="12"
                                          SpinButtonPlacementMode="Inline"
                                          Width="120"/>
                        </Grid>
                        
                        <TextBlock Text="{lex:Locale Settings.General.SlotsPerPageDescription}" 
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                   FontSize="{StaticResource Pulsar.Type.Caption}"
                                   Margin="0"/>

                        <Separator Margin="{StaticResource Pulsar.Gap.Vertical.MD}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{lex:Locale Settings.General.QuickSwitchTimeout}" FontWeight="Medium"/>
                                <TextBlock Text="{lex:Locale Settings.General.QuickSwitchTimeoutDescription}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="{StaticResource Pulsar.Type.Body}"
                                           TextWrapping="Wrap"
                                           MaxWidth="420"
                                           Margin="{StaticResource Pulsar.Gap.Top.XS}"/>
                            </StackPanel>
                            <ui:NumberBox Grid.Column="1"
                                          Value="{Binding QuickSwitchTimeoutMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Minimum="80"
                                          Maximum="1500"
                                          SpinButtonPlacementMode="Inline"
                                          Width="120"/>
                        </Grid>
                    </StackPanel>
                </ui:CardExpander>

                <!-- Hotkeys Section -->
                <ui:CardExpander Icon="Keyboard24" Header="{lex:Locale Settings.General.GlobalHotkeys}" Margin="{StaticResource Pulsar.Gap.Bottom.MD}" IsExpanded="True">
                    <StackPanel>
                        <!-- Grid Hotkey -->
                        <Grid Margin="{StaticResource Pulsar.Gap.Bottom.MD}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{lex:Locale Settings.General.ShowMenu}" FontWeight="Medium"/>
                                <TextBlock Text="{lex:Locale Settings.General.ShowMenuDescription}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="{StaticResource Pulsar.Type.Body}"/>
                            </StackPanel>
                            <controls:HotkeyBox Grid.Column="1" Width="200"
                                                 Hotkey="{Binding DataContext.ShowGridHotkey, RelativeSource={RelativeSource AncestorType=Page}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 ValidationResult="{Binding DataContext.ShowGridHotkeyValidation, RelativeSource={RelativeSource AncestorType=Page}, Mode=OneWay}"
                                                 ActionId="ShowGrid"/>
                        </Grid>
                        
                        <Separator Margin="{StaticResource Pulsar.Gap.Vertical.MD}"/>

                        <!-- Switcher Hotkey -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{lex:Locale Settings.General.ShowSwitcher}" FontWeight="Medium"/>
                                <TextBlock Text="{lex:Locale Settings.General.ShowSwitcherDescription}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="{StaticResource Pulsar.Type.Body}"/>
                            </StackPanel>
                            <controls:HotkeyBox Grid.Column="1" Width="200"
                                                 Hotkey="{Binding DataContext.ShowSwitcherHotkey, RelativeSource={RelativeSource AncestorType=Page}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 ValidationResult="{Binding DataContext.ShowSwitcherHotkeyValidation, RelativeSource={RelativeSource AncestorType=Page}, Mode=OneWay}"
                                                 ActionId="ShowSwitcher"/>
                        </Grid>
                    </StackPanel>
                </ui:CardExpander>

                <!-- Right-Drag Gesture Section -->
                <ui:CardExpander Icon="DialPad24" Header="{lex:Locale Settings.General.RightDragSummon}" Margin="{StaticResource Pulsar.Gap.Bottom.MD}" IsExpanded="False">
                    <StackPanel>
                        <Grid Margin="{StaticResource Pulsar.Gap.Bottom.MD}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{lex:Locale Settings.General.RightDragSummonToggle}" FontWeight="Medium"/>
                                <TextBlock Text="{lex:Locale Settings.General.RightDragSummonDescription}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="{StaticResource Pulsar.Type.Body}" TextWrapping="Wrap" MaxWidth="420"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableRightDragSummon, Mode=TwoWay}"/>
                        </Grid>

                        <TextBlock Text="{lex:Locale Settings.General.RightDragModifiersConflict}"
                                   Foreground="{DynamicResource DangerForegroundBrush}"
                                   FontSize="{StaticResource Pulsar.Type.Body}"
                                   TextWrapping="Wrap"
                                   MaxWidth="420"
                                   Margin="{StaticResource Pulsar.Gap.Bottom.MD}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RightDragModifiersConflict}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Summon mode (only when the gesture is enabled) -->
                        <Grid Margin="{StaticResource Pulsar.Gap.Bottom.MD}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{lex:Locale Settings.General.GestureSummonMode}" FontWeight="Medium"/>
                                <TextBlock Text="{lex:Locale Settings.General.GestureSummonModeDescription}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="{StaticResource Pulsar.Type.Body}" TextWrapping="Wrap" MaxWidth="420"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="180"
                                      IsEnabled="{Binding EnableRightDragSummon}"
                                      SelectedValue="{Binding SummonMode, Mode=TwoWay}"
                                      SelectedValuePath="Tag"
                                      AutomationProperties.Name="{lex:Locale Settings.General.GestureSummonMode}">
                                <ComboBoxItem Tag="{x:Static models:GestureSummonMode.Immediate}">
                                    <TextBlock Text="{lex:Locale Settings.General.SummonModeImmediate}" VerticalAlignment="Center"/>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="{x:Static models:GestureSummonMode.OnThreshold}">
                                    <TextBlock Text="{lex:Locale Settings.General.SummonModeOnThreshold}" VerticalAlignment="Center"/>
                                </ComboBoxItem>
                            </ComboBox>
                        </Grid>

                        <!-- Drag threshold (only for OnThreshold mode) -->
                        <Grid Margin="{StaticResource Pulsar.Gap.Bottom.MD}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{lex:Locale Settings.General.GestureDragThreshold}" FontWeight="Medium"/>
                                <TextBlock Text="{lex:Locale Settings.General.GestureDragThresholdDescription}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="{StaticResource Pulsar.Type.Body}" TextWrapping="Wrap" MaxWidth="420"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SummonMode}" Value="{x:Static models:GestureSummonMode.OnThreshold}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Slider Width="140"
                                        Minimum="5"
                                        Maximum="100"
                                        IsSnapToTickEnabled="True"
                                        TickFrequency="1"
                                        Value="{Binding GestureDragThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        IsEnabled="{Binding EnableRightDragSummon}"
                                        VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding GestureDragThreshold, StringFormat={}{0:0}px}"
                                           Margin="{StaticResource Pulsar.Gap.Left.SM}"
                                           VerticalAlignment="Center"
                                           MinWidth="40"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>

                        <Separator Margin="{StaticResource Pulsar.Gap.Vertical.MD}"/>

                        <!-- Switcher modifier -->
                        <Grid Margin="{StaticResource Pulsar.Gap.Bottom.MD}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{lex:Locale Settings.General.RightDragSwitcherModifier}" FontWeight="Medium"/>
                                <TextBlock Text="{lex:Locale Settings.General.RightDragSwitcherModifierDescription}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="{StaticResource Pulsar.Type.Body}" TextWrapping="Wrap" MaxWidth="420"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="140"
                                      IsEnabled="{Binding EnableRightDragSummon}"
                                      SelectedValue="{Binding RightDragSwitcherModifier, Mode=TwoWay}"
                                      SelectedValuePath="Tag"
                                      AutomationProperties.Name="{lex:Locale Settings.General.RightDragSwitcherModifier}">
                                <ComboBoxItem Tag="Alt">
                                    <TextBlock Text="{lex:Locale Settings.General.ModifierAlt}" VerticalAlignment="Center"/>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="Control">
                                    <TextBlock Text="{lex:Locale Settings.General.ModifierCtrl}" VerticalAlignment="Center"/>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="Shift">
                                    <TextBlock Text="{lex:Locale Settings.General.ModifierShift}" VerticalAlignment="Center"/>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="Win">
                                    <TextBlock Text="{lex:Locale Settings.General.ModifierWin}" VerticalAlignment="Center"/>
                                </ComboBoxItem>
                            </ComboBox>
                        </Grid>

                        <Separator Margin="{StaticResource Pulsar.Gap.Vertical.MD}"/>

                        <!-- Action modifier -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{lex:Locale Settings.General.RightDragActionModifier}" FontWeight="Medium"/>
                                <TextBlock Text="{lex:Locale Settings.General.RightDragActionModifierDescription}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="{StaticResource Pulsar.Type.Body}" TextWrapping="Wrap" MaxWidth="420"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="140"
                                      IsEnabled="{Binding EnableRightDragSummon}"
                                      SelectedValue="{Binding RightDragActionModifier, Mode=TwoWay}"
                                      SelectedValuePath="Tag"
                                      AutomationProperties.Name="{lex:Locale Settings.General.RightDragActionModifier}">
                                <ComboBoxItem Tag="Alt">
                                    <TextBlock Text="{lex:Locale Settings.General.ModifierAlt}" VerticalAlignment="Center"/>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="Control">
                                    <TextBlock Text="{lex:Locale Settings.General.ModifierCtrl}" VerticalAlignment="Center"/>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="Shift">
                                    <TextBlock Text="{lex:Locale Settings.General.ModifierShift}" VerticalAlignment="Center"/>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="Win">
                                    <TextBlock Text="{lex:Locale Settings.General.ModifierWin}" VerticalAlignment="Center"/>
                                </ComboBoxItem>
                            </ComboBox>
                        </Grid>

                        <Separator Margin="{StaticResource Pulsar.Gap.Vertical.MD}"/>

                        <!-- Gesture isolation filter -->
                        <StackPanel IsEnabled="{Binding EnableRightDragSummon}">
                            <TextBlock Text="{lex:Locale Settings.Gesture.Title}" FontWeight="SemiBold" Margin="{StaticResource Pulsar.Gap.Bottom.XS}"/>
                            <TextBlock Text="{lex:Locale Settings.Gesture.TitleDescription}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       FontSize="{StaticResource Pulsar.Type.Body}"
                                       TextWrapping="Wrap"
                                       MaxWidth="420"
                                       Margin="{StaticResource Pulsar.Gap.Bottom.MD}"/>

                            <!-- Enable toggle -->
                            <Grid Margin="{StaticResource Pulsar.Gap.Bottom.MD}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{lex:Locale Settings.Gesture.EnableToggle}" FontWeight="Medium"/>
                                    <TextBlock Text="{lex:Locale Settings.Gesture.EnableToggleDescription}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="{StaticResource Pulsar.Type.Body}" TextWrapping="Wrap" MaxWidth="420"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding GestureIsolationEnabled, Mode=TwoWay}"/>
                            </Grid>

                            <!-- Isolation mode -->
                            <Grid Margin="{StaticResource Pulsar.Gap.Bottom.MD}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{lex:Locale Settings.Gesture.Mode}" FontWeight="Medium"/>
                                    <TextBlock Text="{lex:Locale Settings.Gesture.ModeDescription}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="{StaticResource Pulsar.Type.Body}" TextWrapping="Wrap" MaxWidth="420"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" Width="220"
                                          IsEnabled="{Binding GestureIsolationEnabled}"
                                          SelectedValue="{Binding GestureIsolationMode, Mode=TwoWay}"
                                          SelectedValuePath="Tag"
                                          AutomationProperties.Name="{lex:Locale Settings.Gesture.Mode}">
                                    <ComboBoxItem Tag="{x:Static models:GestureIsolationMode.Allowlist}">
                                        <TextBlock Text="{lex:Locale Settings.Gesture.ModeAllowlist}" VerticalAlignment="Center"/>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static models:GestureIsolationMode.Blocklist}">
                                        <TextBlock Text="{lex:Locale Settings.Gesture.ModeBlocklist}" VerticalAlignment="Center"/>
                                    </ComboBoxItem>
                                </ComboBox>
                            </Grid>

                            <!-- Process list editor -->
                            <Grid Margin="{StaticResource Pulsar.Gap.Bottom.MD}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{lex:Locale Settings.Gesture.Processes}" FontWeight="Medium"/>
                                    <TextBlock Text="{lex:Locale Settings.Gesture.ProcessesDescription}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="{StaticResource Pulsar.Type.Body}" TextWrapping="Wrap" MaxWidth="420"/>
                                </StackPanel>
                                <TextBox Grid.Column="1"
                                         Width="220"
                                         MinHeight="90"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         IsEnabled="{Binding GestureIsolationEnabled}"
                                         Text="{Binding GestureIsolationProcessesText, Mode=TwoWay}"
                                         AutomationProperties.Name="{lex:Locale Settings.Gesture.Processes}"/>
                            </Grid>

                            <!-- Fullscreen block toggle -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{lex:Locale Settings.Gesture.BlockFullscreen}" FontWeight="Medium"/>
                                    <TextBlock Text="{lex:Locale Settings.Gesture.BlockFullscreenDescription}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="{StaticResource Pulsar.Type.Body}" TextWrapping="Wrap" MaxWidth="420"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding GestureIsolationBlockFullscreen, Mode=TwoWay}"
                                                 IsEnabled="{Binding GestureIsolationEnabled}"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ui:CardExpander>

                <!-- Cache Management Section -->
                <ui:CardExpander Icon="Database24" Header="{lex:Locale Settings.General.CacheManagement}" Margin="{StaticResource Pulsar.Gap.Bottom.MD}" IsExpanded="False">
                    <StackPanel>
                        <Grid Margin="{StaticResource Pulsar.Gap.Bottom.MD}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{lex:Locale Settings.General.IconCacheStatistics}" FontWeight="Medium"/>
                                <TextBlock Text="{Binding DataContext.CacheStatistics, RelativeSource={RelativeSource AncestorType=Page}}" 
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                           FontSize="{StaticResource Pulsar.Type.Body}"/>
                            </StackPanel>
                            <ui:Button Grid.Column="1" 
                                       Content="{lex:Locale Settings.General.CleanCache}"
                                       Icon="{ui:SymbolIcon Delete24}"
                                       Command="{Binding DataContext.CleanCacheCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                       Style="{StaticResource PulsarSecondaryButtonStyle}"/>
                        </Grid>
                        
                        <TextBlock Text="{lex:Locale Settings.General.CleanCacheDescription}" 
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                   FontSize="{StaticResource Pulsar.Type.Caption}"
                                   Margin="0"/>

                        <Separator Margin="{StaticResource Pulsar.Gap.Vertical.MD}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{lex:Locale Settings.General.ResetTutorial}" FontWeight="Medium"/>
                                <TextBlock Text="{lex:Locale Settings.General.ResetTutorialDescription}" 
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                           FontSize="{StaticResource Pulsar.Type.Body}"/>
                            </StackPanel>
                            <ui:Button Grid.Column="1" 
                                       Content="{lex:Locale Settings.General.ResetTutorial}"
                                       Icon="{ui:SymbolIcon ArrowReset24}"
                                       Command="{Binding DataContext.ResetTutorialCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                       Style="{StaticResource PulsarSecondaryButtonStyle}"/>
                        </Grid>
                    </StackPanel>
                </ui:CardExpander>

                <!-- Logging Section -->
                <ui:CardExpander Icon="Code24" Header="{lex:Locale Settings.General.Logging}" Margin="{StaticResource Pulsar.Gap.Bottom.MD}" IsExpanded="False">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{lex:Locale Settings.General.LogLevel}" FontWeight="Medium"/>
                                <TextBlock Text="{lex:Locale Settings.General.LogLevelDescription}" 
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                           FontSize="{StaticResource Pulsar.Type.Body}" TextWrapping="Wrap" MaxWidth="420"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="160"
                                      SelectedValue="{Binding DataContext.SelectedLogLevel, RelativeSource={RelativeSource AncestorType=Page}, Mode=TwoWay}"
                                      SelectedValuePath="Tag"
                                      AutomationProperties.Name="{lex:Locale Settings.General.LogLevel}">
                                <ComboBoxItem Tag="Verbose">
                                    <TextBlock Text="{lex:Locale Settings.General.LogLevel.Verbose}" VerticalAlignment="Center"/>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="Debug">
                                    <TextBlock Text="{lex:Locale Settings.General.LogLevel.Debug}" VerticalAlignment="Center"/>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="Information">
                                    <TextBlock Text="{lex:Locale Settings.General.LogLevel.Information}" VerticalAlignment="Center"/>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="Warning">
                                    <TextBlock Text="{lex:Locale Settings.General.LogLevel.Warning}" VerticalAlignment="Center"/>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="Error">
                                    <TextBlock Text="{lex:Locale Settings.General.LogLevel.Error}" VerticalAlignment="Center"/>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="Fatal">
                                    <TextBlock Text="{lex:Locale Settings.General.LogLevel.Fatal}" VerticalAlignment="Center"/>
                                </ComboBoxItem>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </ui:CardExpander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
