<Page x:Class="Pulsar.Views.Pages.SettingsGeneralPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:Pulsar.ViewModels"
      xmlns:models="clr-namespace:Pulsar.Models"
      xmlns:controls="clr-namespace:Pulsar.Views.Controls"
      xmlns:lex="clr-namespace:Pulsar.Core.Localization"
      xmlns:helpers="clr-namespace:Pulsar.Helpers"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="800"
      Title="{lex:Locale Settings.General.Title}">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Pulsar;component/Styles/ButtonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Margin="0" helpers:ComboBoxSelectionLeftAlign.EnableLeftAlign="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Unified Page Header -->
        <controls:SettingsPageHeader Grid.Row="0"
                                     Title="{lex:Locale Settings.General.Title}"
                                     Description="{lex:Locale Settings.General.Description}">
            <controls:SettingsPageHeader.ActionsContent>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="{lex:Locale Settings.General.OpenLogs}"
                               Icon="{ui:SymbolIcon FolderOpen24}"
                               Command="{Binding OpenLogsFolderCommand}"
                               Style="{StaticResource PulsarSecondaryButtonStyle}"
                               Margin="{StaticResource Pulsar.Gap.Right.SM}"/>
                    <ui:Button Content="{lex:Locale Settings.General.ResetDefaults}"
                               Icon="{ui:SymbolIcon ArrowReset24}"
                               Command="{Binding ResetConfigCommand}"
                               Style="{StaticResource PulsarDangerButtonStyle}"/>
                </StackPanel>
            </controls:SettingsPageHeader.ActionsContent>
        </controls:SettingsPageHeader>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel DataContext="{Binding GeneralSettings}" Margin="{StaticResource Pulsar.Gap.Right.XL}">

                <!-- Appearance Section（openspec 2026-09-08-dynamic-settings-tabs P1）：
                     主题/渲染器/预设/语言（2026-09-08 用户决策移入）已迁至独立的
                     SettingsAppearancePage，此处保留外观页入口。 -->
                <ui:CardExpander Icon="Color24" Header="{lex:Locale Settings.General.Appearance}" Margin="{StaticResource Pulsar.Gap.Bottom.MD}" IsExpanded="False">
                    <StackPanel>
                        <controls:SettingsRow Title="{lex:Locale SettingsPage.ConfigureDetails}"
                                              Description="{lex:Locale SettingsPage.ConfigureDetailsHint}">
                            <ui:Button Content="{lex:Locale SettingsPage.ConfigureDetails}"
                                       Icon="{ui:SymbolIcon ArrowRight24}"
                                       Click="OpenAppearancePage_Click"
                                       Style="{StaticResource PulsarSecondaryButtonStyle}"
                                       AutomationProperties.AutomationId="Pulsar.Settings.OpenAppearancePage"/>
                        </controls:SettingsRow>
                    </StackPanel>
                </ui:CardExpander>

                <!-- Radial Menu Layout Section -->
                <ui:CardExpander Icon="Apps24" Header="{lex:Locale Settings.General.RadialMenuLayout}" Margin="{StaticResource Pulsar.Gap.Bottom.MD}" IsExpanded="False">
                    <StackPanel>
                        <controls:SettingsRow Title="{lex:Locale Settings.General.SlotsPerPage}"
                                              Description="{Binding DataContext.SlotsPerPagePreview, RelativeSource={RelativeSource AncestorType=Page}}">
                            <ui:NumberBox Value="{Binding SlotsPerPage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Minimum="4"
                                          Maximum="12"
                                          SpinButtonPlacementMode="Inline"
                                          Width="{StaticResource Pulsar.Settings.ControlWidth}"/>
                        </controls:SettingsRow>

                        <TextBlock Text="{lex:Locale Settings.General.SlotsPerPageDescription}"
                                   ToolTip="{lex:Locale Settings.General.SlotsPerPageDescriptionDetail}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                   FontSize="{StaticResource Pulsar.Type.Caption}"
                                   Margin="0,0,0,12"/>

                        <controls:SettingsRow Title="{lex:Locale Settings.General.QuickSwitchTimeout}"
                                              Description="{lex:Locale Settings.General.QuickSwitchTimeoutDescription}"
                                              DescriptionToolTip="{lex:Locale Settings.General.QuickSwitchTimeoutDescriptionDetail}">
                            <ui:NumberBox Value="{Binding QuickSwitchTimeoutMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Minimum="80"
                                          Maximum="1500"
                                          SpinButtonPlacementMode="Inline"
                                          Width="{StaticResource Pulsar.Settings.ControlWidth}"/>
                        </controls:SettingsRow>

                        <!-- [Edge Clamp] 屏幕边缘校正：开关 + 校正后中心离边缘的距离。
                             作用于全部唤起通道（热键 / 右键手势），故与手势开关无关。 -->
                        <controls:SettingsRow Title="{lex:Locale Settings.General.EdgeClamp}"
                                              Description="{lex:Locale Settings.General.EdgeClampDescription}"
                                              DescriptionToolTip="{lex:Locale Settings.General.EdgeClampDescriptionDetail}">
                            <ui:ToggleSwitch IsChecked="{Binding EdgeClampEnabled, Mode=TwoWay}"
                                             AutomationProperties.AutomationId="Pulsar.Settings.EdgeClampToggle"/>
                        </controls:SettingsRow>

                        <controls:SettingsRow Title="{lex:Locale Settings.General.EdgeClampMargin}"
                                              Description="{lex:Locale Settings.General.EdgeClampMarginDescription}"
                                              DescriptionToolTip="{lex:Locale Settings.General.EdgeClampMarginDescriptionDetail}">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding EdgeClampEnabled}">
                                <Slider Width="140"
                                        Minimum="0"
                                        Maximum="600"
                                        IsSnapToTickEnabled="True"
                                        TickFrequency="10"
                                        Value="{Binding EdgeClampMarginDip, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        VerticalAlignment="Center"
                                        AutomationProperties.AutomationId="Pulsar.Settings.EdgeClampMarginSlider"/>
                                <TextBlock Text="{Binding EdgeClampMarginDip, StringFormat={}{0:0}px}"
                                           Margin="{StaticResource Pulsar.Gap.Left.SM}"
                                           VerticalAlignment="Center"
                                           MinWidth="48"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </controls:SettingsRow>
                    </StackPanel>
                </ui:CardExpander>

                <!-- Hotkeys Section -->
                <ui:CardExpander Icon="Keyboard24" Header="{lex:Locale Settings.General.GlobalHotkeys}" Margin="{StaticResource Pulsar.Gap.Bottom.MD}" IsExpanded="True">
                    <StackPanel>
                        <controls:SettingsRow Title="{lex:Locale Settings.General.ShowMenu}"
                                              Description="{lex:Locale Settings.General.ShowMenuDescription}">
                            <controls:HotkeyBox Width="{StaticResource Pulsar.Settings.ControlWidth}"
                                                 Hotkey="{Binding DataContext.ShowGridHotkey, RelativeSource={RelativeSource AncestorType=Page}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 ValidationResult="{Binding DataContext.ShowGridHotkeyValidation, RelativeSource={RelativeSource AncestorType=Page}, Mode=OneWay}"
                                                 ActionId="ShowGrid"/>
                        </controls:SettingsRow>

                        <controls:SettingsRow Title="{lex:Locale Settings.General.ShowSwitcher}"
                                              Description="{lex:Locale Settings.General.ShowSwitcherDescription}">
                            <controls:HotkeyBox Width="{StaticResource Pulsar.Settings.ControlWidth}"
                                                 Hotkey="{Binding DataContext.ShowSwitcherHotkey, RelativeSource={RelativeSource AncestorType=Page}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 ValidationResult="{Binding DataContext.ShowSwitcherHotkeyValidation, RelativeSource={RelativeSource AncestorType=Page}, Mode=OneWay}"
                                                 ActionId="ShowSwitcher"/>
                        </controls:SettingsRow>
                    </StackPanel>
                </ui:CardExpander>

                <!-- Right-Drag Gesture Section（openspec 2026-09-08-dynamic-settings-tabs P0）：
                     完整配置已迁至临时页 SettingsGesturePage（按类型单例、干净离开即回收），
                     卡片回归简单承载：总开关 + 配置详情入口。 -->
                <ui:CardExpander Icon="DialPad24" Header="{lex:Locale Settings.General.RightDragSummon}" Margin="{StaticResource Pulsar.Gap.Bottom.MD}" IsExpanded="False">
                    <StackPanel>
                        <controls:SettingsRow Title="{lex:Locale Settings.General.RightDragSummonToggle}"
                                              Description="{lex:Locale Settings.General.RightDragSummonDescription}"
                                              DescriptionToolTip="{lex:Locale Settings.General.RightDragSummonDescriptionDetail}">
                            <ui:ToggleSwitch IsChecked="{Binding EnableRightDragSummon, Mode=TwoWay}"/>
                        </controls:SettingsRow>

                        <controls:SettingsRow Title="{lex:Locale SettingsPage.ConfigureDetails}"
                                              Description="{lex:Locale SettingsPage.ConfigureDetailsHint}">
                            <ui:Button Content="{lex:Locale SettingsPage.ConfigureDetails}"
                                       Icon="{ui:SymbolIcon ArrowRight24}"
                                       Click="OpenGesturePage_Click"
                                       Style="{StaticResource PulsarSecondaryButtonStyle}"
                                       AutomationProperties.AutomationId="Pulsar.Settings.OpenGesturePage"/>
                        </controls:SettingsRow>
                    </StackPanel>
                </ui:CardExpander>

                <!-- Cache Management Section -->
                <ui:CardExpander Icon="Database24" Header="{lex:Locale Settings.General.CacheManagement}" Margin="{StaticResource Pulsar.Gap.Bottom.MD}" IsExpanded="False">
                    <StackPanel>
                        <controls:SettingsRow Title="{lex:Locale Settings.General.IconCacheStatistics}"
                                              Description="{Binding DataContext.CacheStatistics, RelativeSource={RelativeSource AncestorType=Page}}">
                            <ui:Button Content="{lex:Locale Settings.General.CleanCache}"
                                       Icon="{ui:SymbolIcon Delete24}"
                                       Command="{Binding DataContext.CleanCacheCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                       Style="{StaticResource PulsarSecondaryButtonStyle}"/>
                        </controls:SettingsRow>

                        <TextBlock Text="{lex:Locale Settings.General.CleanCacheDescription}"
                                   ToolTip="{lex:Locale Settings.General.CleanCacheDescriptionDetail}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                   FontSize="{StaticResource Pulsar.Type.Caption}"
                                   Margin="0,0,0,12"/>

                        <controls:SettingsRow Title="{lex:Locale Settings.General.ResetTutorial}"
                                              Description="{lex:Locale Settings.General.ResetTutorialDescription}">
                            <ui:Button Content="{lex:Locale Settings.General.ResetTutorial}"
                                       Icon="{ui:SymbolIcon ArrowReset24}"
                                       Command="{Binding DataContext.ResetTutorialCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                       Style="{StaticResource PulsarSecondaryButtonStyle}"/>
                        </controls:SettingsRow>
                    </StackPanel>
                </ui:CardExpander>

                <!-- Logging Section -->
                <ui:CardExpander Icon="Code24" Header="{lex:Locale Settings.General.Logging}" Margin="{StaticResource Pulsar.Gap.Bottom.MD}" IsExpanded="False">
                    <StackPanel>
                        <controls:SettingsRow Title="{lex:Locale Settings.General.LogLevel}"
                                              Description="{lex:Locale Settings.General.LogLevelDescription}"
                                              DescriptionToolTip="{lex:Locale Settings.General.LogLevelDescriptionDetail}">
                            <ComboBox Width="{StaticResource Pulsar.Settings.ControlWidth}"
                                      SelectedValue="{Binding DataContext.SelectedLogLevel, RelativeSource={RelativeSource AncestorType=Page}, Mode=TwoWay}"
                                      SelectedValuePath="Tag"
                                      AutomationProperties.Name="{lex:Locale Settings.General.LogLevel}">
                                <ComboBoxItem Tag="Verbose">
                                    <TextBlock Text="{lex:Locale Settings.General.LogLevel.Verbose}" VerticalAlignment="Center"/>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="Debug">
                                    <TextBlock Text="{lex:Locale Settings.General.LogLevel.Debug}" VerticalAlignment="Center"/>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="Information">
                                    <TextBlock Text="{lex:Locale Settings.General.LogLevel.Information}" VerticalAlignment="Center"/>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="Warning">
                                    <TextBlock Text="{lex:Locale Settings.General.LogLevel.Warning}" VerticalAlignment="Center"/>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="Error">
                                    <TextBlock Text="{lex:Locale Settings.General.LogLevel.Error}" VerticalAlignment="Center"/>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="Fatal">
                                    <TextBlock Text="{lex:Locale Settings.General.LogLevel.Fatal}" VerticalAlignment="Center"/>
                                </ComboBoxItem>
                            </ComboBox>
                        </controls:SettingsRow>
                    </StackPanel>
                </ui:CardExpander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
