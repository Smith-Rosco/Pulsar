<Page x:Class="Pulsar.Views.Pages.SettingsAnalyticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Pulsar.Views.Controls"
      xmlns:models="clr-namespace:Pulsar.Models"
      xmlns:lex="clr-namespace:Pulsar.Core.Localization"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="{lex:Locale Settings.Analytics.Title}">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Pulsar;component/Styles/ButtonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- 排序表头：轻量可点击文本（替代按钮化表头），列宽与下方卡片度量列对齐 -->
            <Style x:Key="AnalyticsSortHeaderText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource Pulsar.Type.Caption}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="{StaticResource Pulsar.Gap.Right.SM}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorAccentBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:SettingsPageHeader Grid.Row="0"
                                     Title="{lex:Locale Settings.Analytics.Title}"
                                     Description="{lex:Locale Settings.Analytics.Description}"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      AutomationProperties.AutomationId="Pulsar.Settings.Analytics.ScrollViewer">
            <StackPanel Margin="{StaticResource Pulsar.Gap.Right.XL}" MaxWidth="720" HorizontalAlignment="Left">

                <!-- Loading Indicator -->
                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                            HorizontalAlignment="Center" Margin="{StaticResource Pulsar.Gap.Top.Hero}">
                    <ui:ProgressRing IsIndeterminate="True" Width="40" Height="40" HorizontalAlignment="Center"/>
                    <TextBlock Text="{lex:Locale Settings.Analytics.Loading}"
                               FontSize="{StaticResource Pulsar.Type.Body}" Margin="{StaticResource Pulsar.Gap.Top.MD}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- No Data Message -->
                <ui:CardControl Margin="{StaticResource Pulsar.Gap.Bottom.LG}">
                    <ui:CardControl.Style>
                        <Style TargetType="ui:CardControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsLoading}" Value="False"/>
                                        <Condition Binding="{Binding HasData}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:CardControl.Style>
                    <controls:EmptyState Icon="DataPie24"
                                         Title="{lex:Locale Settings.Analytics.NoData}"
                                         AutomationProperties.AutomationId="Pulsar.Settings.Analytics.EmptyState"
                                         Margin="{StaticResource Pulsar.Gap.Vertical.XXL}"/>
                </ui:CardControl>

                <!-- Error State -->
                <ui:CardControl Margin="{StaticResource Pulsar.Gap.Bottom.LG}"
                               Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" Margin="{StaticResource Pulsar.Gap.Vertical.LG}">
                        <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="36"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   FontSize="{StaticResource Pulsar.Type.Body}" Margin="{StaticResource Pulsar.Gap.Top.MD}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="360"/>
                        <ui:Button Content="{lex:Locale Settings.Analytics.Refresh}"
                                   Icon="{ui:SymbolIcon ArrowSync24}"
                                   Command="{Binding RefreshCommand}"
                                   Style="{StaticResource PulsarSecondaryButtonStyle}"
                                   HorizontalAlignment="Center"
                                   Margin="{StaticResource Pulsar.Gap.Top.MD}"/>
                    </StackPanel>
                </ui:CardControl>

                <!-- Summary Dashboard -->
                <Grid Margin="{StaticResource Pulsar.Gap.Bottom.LG}"
                      Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ui:CardControl Grid.Column="0" Padding="{StaticResource Pulsar.Pad.H16V12}" Margin="{StaticResource Pulsar.Gap.Right.SM}">
                        <StackPanel>
                            <TextBlock Text="{Binding TotalOverallExecutions}"
                                       FontSize="{StaticResource Pulsar.Type.Title}" FontWeight="Bold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{lex:Locale Settings.Analytics.SummaryTotalExec}"
                                       FontSize="{StaticResource Pulsar.Type.Caption}"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Margin="{StaticResource Pulsar.Gap.Top.XXS}"/>
                        </StackPanel>
                    </ui:CardControl>

                    <ui:CardControl Grid.Column="1" Padding="{StaticResource Pulsar.Pad.H16V12}" Margin="{StaticResource Pulsar.Gap.Horizontal.XS}">
                        <StackPanel>
                            <TextBlock Text="{Binding ActivePluginCount}"
                                       FontSize="{StaticResource Pulsar.Type.Title}" FontWeight="Bold"
                                       Foreground="{DynamicResource SystemFillColorAccentBrush}"/>
                            <TextBlock Text="{lex:Locale Settings.Analytics.SummaryActivePlugins}"
                                       FontSize="{StaticResource Pulsar.Type.Caption}"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Margin="{StaticResource Pulsar.Gap.Top.XXS}"/>
                        </StackPanel>
                    </ui:CardControl>

                    <ui:CardControl Grid.Column="2" Padding="{StaticResource Pulsar.Pad.H16V12}" Margin="{StaticResource Pulsar.Gap.Horizontal.XS}">
                        <StackPanel>
                            <TextBlock Text="{Binding TotalTodayExecutions}"
                                       FontSize="{StaticResource Pulsar.Type.Title}" FontWeight="Bold"
                                       Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                            <TextBlock Text="{lex:Locale Settings.Analytics.SummaryToday}"
                                       FontSize="{StaticResource Pulsar.Type.Caption}"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Margin="{StaticResource Pulsar.Gap.Top.XXS}"/>
                        </StackPanel>
                    </ui:CardControl>

                    <ui:CardControl Grid.Column="3" Padding="{StaticResource Pulsar.Pad.H16V12}" Margin="{StaticResource Pulsar.Gap.Left.SM}">
                        <StackPanel>
                            <TextBlock Text="{Binding TotalWeekExecutions}"
                                       FontSize="{StaticResource Pulsar.Type.Title}" FontWeight="Bold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{lex:Locale Settings.Analytics.SummaryWeek}"
                                       FontSize="{StaticResource Pulsar.Type.Caption}"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Margin="{StaticResource Pulsar.Gap.Top.XXS}"/>
                        </StackPanel>
                    </ui:CardControl>
                </Grid>

                <!-- Slot Usage Heatmap -->
                <ui:CardControl Margin="{StaticResource Pulsar.Gap.Bottom.LG}"
                                Visibility="{Binding HasHeatmap, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:CardControl.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="DataPie24" Margin="{StaticResource Pulsar.Gap.Right.SM}"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{lex:Locale Settings.Analytics.SlotHeatmap}"
                                       FontWeight="SemiBold" FontSize="{StaticResource Pulsar.Type.Subtitle}"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ItemsControl ItemsSource="{Binding SlotHeatmap}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="{StaticResource Pulsar.Gap.Vertical.XS}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Label}"
                                               FontWeight="Medium"
                                               FontSize="{StaticResource Pulsar.Type.Body}"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                                    <Grid Grid.Column="1" Margin="{StaticResource Pulsar.Gap.Horizontal.MD}">
                                        <Border Height="20"
                                                CornerRadius="{StaticResource Pulsar.Radius.SM}"
                                                Background="{DynamicResource ControlFillColorDisabledBrush}">
                                            <Border Width="{Binding BarWidth, FallbackValue=0}"
                                                    HorizontalAlignment="Left"
                                                    CornerRadius="{StaticResource Pulsar.Radius.SM}"
                                                    Background="{DynamicResource SystemFillColorAccentBrush}"
                                                    MinWidth="4">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TotalExecutions}" Value="0">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Border>
                                    </Grid>

                                    <TextBlock Grid.Column="2"
                                               FontSize="{StaticResource Pulsar.Type.Caption}"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               MinWidth="130"
                                               TextAlignment="Right">
                                        <Run Text="{Binding TotalExecutions, Mode=OneWay}"/>
                                        <Run Text=" "/>
                                        <Run Text="{lex:Locale Settings.Analytics.Executions}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding PluginCount, Mode=OneWay}"/>
                                        <Run Text=" "/>
                                        <Run Text="{lex:Locale Settings.Analytics.Plugins}"/>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ui:CardControl>

                <!-- Hourly Usage Heatmap -->
                <ui:CardControl Margin="{StaticResource Pulsar.Gap.Bottom.LG}"
                                Visibility="{Binding HasHourlyHeatmap, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:CardControl.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="DataTrending24" Margin="{StaticResource Pulsar.Gap.Right.SM}"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{lex:Locale Settings.Analytics.Title}"
                                       FontWeight="SemiBold" FontSize="{StaticResource Pulsar.Type.Subtitle}"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ItemsControl ItemsSource="{Binding HourlyHeatmap}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="{StaticResource Pulsar.Gap.Vertical.XXS}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Label}"
                                               FontSize="{StaticResource Pulsar.Type.Caption}"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                                    <Grid Grid.Column="1" Margin="{StaticResource Pulsar.Gap.Horizontal.SM}">
                                        <Border Height="16"
                                                CornerRadius="{StaticResource Pulsar.Radius.SM}"
                                                Background="{DynamicResource ControlFillColorDisabledBrush}">
                                            <Border Width="{Binding BarWidth, FallbackValue=0}"
                                                    HorizontalAlignment="Left"
                                                    CornerRadius="{StaticResource Pulsar.Radius.SM}"
                                                    Background="{DynamicResource SystemFillColorAccentBrush}"
                                                    MinWidth="2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TotalExecutions}" Value="0">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Border>
                                    </Grid>

                                    <TextBlock Grid.Column="2"
                                               FontSize="{StaticResource Pulsar.Type.Caption}"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               MinWidth="60"
                                               TextAlignment="Right">
                                        <Run Text="{Binding TotalExecutions, Mode=OneWay}"/>
                                        <Run Text=" "/>
                                        <Run Text="{lex:Locale Settings.Analytics.Executions}"/>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ui:CardControl>

                <!-- Filter Row -->
                <Grid Margin="{StaticResource Pulsar.Gap.Bottom.MD}"
                      Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{lex:Locale Settings.Analytics.FilterAllTime}"
                               FontSize="{StaticResource Pulsar.Type.Body}" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="{StaticResource Pulsar.Gap.Right.SM}"/>
                    <ComboBox Grid.Column="1" MinWidth="140"
                              AutomationProperties.AutomationId="Pulsar.Settings.Analytics.FilterCombo"
                              SelectedValuePath="Tag"
                              SelectedValue="{Binding TimeRange}">
                        <ComboBoxItem Content="{lex:Locale Settings.Analytics.FilterAllTime}" Tag="{x:Static models:AnalyticsTimeRange.AllTime}"/>
                        <ComboBoxItem Content="{lex:Locale Settings.Analytics.FilterToday}" Tag="{x:Static models:AnalyticsTimeRange.Today}"/>
                        <ComboBoxItem Content="{lex:Locale Settings.Analytics.FilterThisWeek}" Tag="{x:Static models:AnalyticsTimeRange.ThisWeek}"/>
                        <ComboBoxItem Content="{lex:Locale Settings.Analytics.FilterThisMonth}" Tag="{x:Static models:AnalyticsTimeRange.ThisMonth}"/>
                    </ComboBox>
                </Grid>

                <!-- Sort Column Headers：列宽与卡片度量列（执行次数/成功率/平均时长/最后使用）一一对齐 -->
                <Grid Margin="{StaticResource Pulsar.Thk.L16R16B4}"
                      Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- # 列宽 = 32px 徽章 + Right.LG 边距，与卡片排名徽章列严格对齐 -->
                    <TextBlock Grid.Column="0" Text="#" FontSize="{StaticResource Pulsar.Type.Caption}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" Width="32"
                               Margin="{StaticResource Pulsar.Gap.Right.LG}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{lex:Locale Settings.Analytics.SortByExecutions}"
                               Style="{StaticResource AnalyticsSortHeaderText}">
                        <TextBlock.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SetSortCommand}" CommandParameter="Executions"/>
                        </TextBlock.InputBindings>
                    </TextBlock>
                    <TextBlock Grid.Column="2" Text="{lex:Locale Settings.Analytics.SortBySuccessRate}"
                               Style="{StaticResource AnalyticsSortHeaderText}">
                        <TextBlock.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SetSortCommand}" CommandParameter="SuccessRate"/>
                        </TextBlock.InputBindings>
                    </TextBlock>
                    <TextBlock Grid.Column="3" Text="{lex:Locale Settings.Analytics.SortByDuration}"
                               Style="{StaticResource AnalyticsSortHeaderText}">
                        <TextBlock.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SetSortCommand}" CommandParameter="Duration"/>
                        </TextBlock.InputBindings>
                    </TextBlock>
                    <TextBlock Grid.Column="4" Text="{lex:Locale Settings.Analytics.SortByLastUsed}"
                               Style="{StaticResource AnalyticsSortHeaderText}">
                        <TextBlock.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SetSortCommand}" CommandParameter="LastUsed"/>
                        </TextBlock.InputBindings>
                    </TextBlock>
                </Grid>

                <!-- Usage Stats List -->
                <ItemsControl ItemsSource="{Binding MostUsedPlugins}"
                              Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:CardControl Margin="{StaticResource Pulsar.Gap.Bottom.MD}" Padding="{StaticResource Pulsar.Pad.H16V16}">
                                <ui:CardControl.Header>
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Rank Badge -->
                                    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                            Width="32" Height="32" CornerRadius="{StaticResource Pulsar.Radius.LG}"
                                            Margin="{StaticResource Pulsar.Gap.Right.LG}" VerticalAlignment="Center"
                                            Background="{DynamicResource ControlFillColorDisabledBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource ControlFillColorDisabledBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTopThree}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource SystemFillColorAccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding RankLabel}"
                                                   FontSize="{StaticResource Pulsar.Type.Body}" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTopThree}" Value="True">
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <!-- Plugin Name + Plugin Id（最后使用移至下方度量列，与表头对齐） -->
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="{StaticResource Pulsar.Gap.Bottom.SM}">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold" FontSize="{StaticResource Pulsar.Type.Subtitle}"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Margin="{StaticResource Pulsar.Gap.Left.SM}"
                                                   FontSize="{StaticResource Pulsar.Type.Caption}"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding PluginId, StringFormat='({0})'}"/>
                                    </StackPanel>

                                    <!-- Metrics Row：4 列，与排序表头 4 列（执行次数/成功率/平均时长/最后使用）严格对齐 -->
                                    <UniformGrid Grid.Row="1" Grid.Column="1" Columns="4" Margin="{StaticResource Pulsar.Thk.T8B2}">

                                        <!-- Executions -->
                                        <StackPanel>
                                            <TextBlock Text="{Binding TotalFormatted}"
                                                       FontSize="{StaticResource Pulsar.Type.Title}" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="{lex:Locale Settings.Analytics.Executions}"
                                                       FontSize="{StaticResource Pulsar.Type.Caption}"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        </StackPanel>

                                        <!-- Success Rate -->
                                        <StackPanel>
                                            <TextBlock FontSize="{StaticResource Pulsar.Type.Title}" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SuccessRateColor}" Value="Orange">
                                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorAttentionBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SuccessRateColor}" Value="Red">
                                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <Run Text="{Binding SuccessRate, StringFormat='{}{0:F0}'}"/><Run Text="%"/>
                                            </TextBlock>
                                            <TextBlock Text="{lex:Locale Settings.Analytics.SuccessRate}"
                                                       FontSize="{StaticResource Pulsar.Type.Caption}"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        </StackPanel>

                                        <!-- Avg Duration -->
                                        <StackPanel>
                                            <TextBlock Text="{Binding DurationFormatted}"
                                                       FontSize="{StaticResource Pulsar.Type.Title}" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="{lex:Locale Settings.Analytics.AvgDuration}"
                                                       FontSize="{StaticResource Pulsar.Type.Caption}"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        </StackPanel>

                                        <!-- Last Used -->
                                        <StackPanel>
                                            <TextBlock Text="{Binding LastUsedFormatted}"
                                                       FontSize="{StaticResource Pulsar.Type.Title}" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="{lex:Locale Settings.Analytics.LastUsed}"
                                                       FontSize="{StaticResource Pulsar.Type.Caption}"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        </StackPanel>
                                    </UniformGrid>

                                    <!-- Bottom Row: Slot + Mode Summary + Sparkline -->
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="{StaticResource Pulsar.Gap.Top.SM}">
                                        <TextBlock Text="{Binding SlotBreakdown}"
                                                   FontSize="{StaticResource Pulsar.Type.Caption}"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        <TextBlock Text="{Binding ModeSummary}"
                                                   FontSize="{StaticResource Pulsar.Type.Caption}"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Margin="{StaticResource Pulsar.Gap.Left.MD}"/>
                                        <ItemsControl ItemsSource="{Binding TrendData}" Margin="{StaticResource Pulsar.Gap.Left.LG}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="4" Height="14" CornerRadius="{StaticResource Pulsar.Radius.XS}" Margin="{StaticResource Pulsar.Gap.Horizontal.XXS}"
                                                            Background="{DynamicResource ControlFillColorDisabledBrush}"
                                                            VerticalAlignment="Bottom">
                                                        <Border Width="4"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Bottom"
                                                                CornerRadius="{StaticResource Pulsar.Radius.XS}"
                                                                Background="{DynamicResource SystemFillColorAccentBrush}"
                                                                Height="{Binding BarHeight, FallbackValue=0}">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasData}" Value="False">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                                </ui:CardControl.Header>
                            </ui:CardControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Recommendations Section -->
                <ui:CardControl Margin="{StaticResource Pulsar.Thk.T12B8}"
                                Visibility="{Binding HasRecommendations, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:CardControl.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Lightbulb16" Margin="{StaticResource Pulsar.Gap.Right.SM}"/>
                            <TextBlock Text="{lex:Locale Settings.Analytics.Recommendations}"
                                       FontWeight="SemiBold" FontSize="{StaticResource Pulsar.Type.Subtitle}"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ItemsControl ItemsSource="{Binding Recommendations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="{StaticResource Pulsar.Gap.Vertical.XS}" Padding="{StaticResource Pulsar.Pad.H12V8}" CornerRadius="{StaticResource Pulsar.Radius.MD}"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <ui:SymbolIcon Grid.Column="0" Margin="{StaticResource Pulsar.Gap.Right.MD}" VerticalAlignment="Center">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Symbol" Value="Info24"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorAccentBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                            <Setter Property="Symbol" Value="Warning24"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorAttentionBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                            <Setter Property="Symbol" Value="ErrorCircle24"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding PluginName}"
                                                       FontWeight="SemiBold" FontSize="{StaticResource Pulsar.Type.Body}"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PluginName}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding PluginName}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="{StaticResource Pulsar.Type.Body}"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Message}"
                                                       FontSize="{StaticResource Pulsar.Type.Caption}" Margin="{StaticResource Pulsar.Gap.Top.XXS}"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="{StaticResource Pulsar.Gap.Left.MD}">
                                            <ui:Button Content="{lex:Locale Settings.Analytics.DisablePlugin}"
                                                       Command="{Binding DataContext.DisablePluginCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                       CommandParameter="{Binding PluginId}"
                                                       FontSize="{StaticResource Pulsar.Type.Caption}" Margin="{StaticResource Pulsar.Gap.Horizontal.XS}">
                                                <ui:Button.Style>
                                                    <Style TargetType="ui:Button" BasedOn="{StaticResource PulsarDangerButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ActionCommand}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ActionCommand}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ActionCommand}" Value="ViewLogs">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:Button.Style>
                                            </ui:Button>
                                            <ui:Button Content="{lex:Locale Settings.Analytics.ViewLogs}"
                                                       Command="{Binding DataContext.ViewLogsCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                       CommandParameter="{Binding PluginId}"
                                                       FontSize="{StaticResource Pulsar.Type.Caption}">
                                                <ui:Button.Style>
                                                    <Style TargetType="ui:Button" BasedOn="{StaticResource PulsarSecondaryButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ActionCommand}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ActionCommand}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ActionCommand}" Value="DisablePlugin">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:Button.Style>
                                            </ui:Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ui:CardControl>

                <!-- Action Buttons Row -->
                <StackPanel Orientation="Horizontal" Margin="{StaticResource Pulsar.Thk.T8B24}">
                    <ui:Button Content="{lex:Locale Settings.Analytics.Refresh}"
                               AutomationProperties.AutomationId="Pulsar.Settings.Analytics.RefreshButton"
                               Icon="{ui:SymbolIcon ArrowSync24}"
                               Command="{Binding RefreshCommand}"
                               Style="{StaticResource PulsarSecondaryButtonStyle}"
                               HorizontalAlignment="Left"/>
                    <ui:Button Content="{lex:Locale Settings.Analytics.ExportCsv}"
                               Icon="{ui:SymbolIcon Save24}"
                               Command="{Binding ExportCsvCommand}"
                               Style="{StaticResource PulsarSecondaryButtonStyle}"
                               HorizontalAlignment="Left"
                               Margin="{StaticResource Pulsar.Gap.Left.MD}"
                               IsEnabled="{Binding HasData}"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
