<Window x:Class="Pulsar.Views.RadialMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:controls="clr-namespace:Pulsar.Views.Controls"
        xmlns:converters="clr-namespace:Pulsar.Core.Converters"
        xmlns:vm="clr-namespace:Pulsar.ViewModels"
        xmlns:lex="clr-namespace:Pulsar.Core.Localization"
        mc:Ignorable="d"
    Title="{lex:Locale RadialMenu.Title}"
    Width="500" Height="500"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    Topmost="True"
    ShowInTaskbar="False"
    ResizeMode="NoResize"
    x:Name="RootWindow"
    AutomationProperties.AutomationId="Pulsar.RadialMenuWindow"
    Style="{x:Null}"
    RenderOptions.CacheInvalidationThresholdMinimum="0.5"
    RenderOptions.CacheInvalidationThresholdMaximum="2.0">

    <!-- 已移除窗口级 RenderOptions.BitmapScalingMode="LowQuality"：
         它与 SlotOrb 局部的 HighQuality 冲突，且会让最熟悉的图标边缘发糊
         （Persona 张每天唤起 200 次的抱怨点）。默认继承 Linear，
         图标渲染统一走 SlotOrb 内的高质量路径。 -->

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Pulsar;component/Styles/SlotStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <converters:StringEmptyToVisibilityConverter x:Key="StringEmptyToVisibilityConverter"/>
            <converters:SlotBrushConverter x:Key="SlotBrushConverter"/>
            <sys:Boolean x:Key="FalseValue">False</sys:Boolean>
        </ResourceDictionary>
    </Window.Resources>

    <Canvas x:Name="ViewportRoot" Background="Transparent">
        <!-- [Refactor] Full-screen viewport. The 500x500 MenuCanvas is positioned at
             the clamped cursor point; hit-testing extends to the whole viewport. -->
        <Canvas x:Name="MenuCanvas"
                Background="Transparent"
                Width="500" Height="500"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Canvas.Left="{Binding MenuCanvasLeft}"
                Canvas.Top="{Binding MenuCanvasTop}">

            <!-- [Flick-out cancel] Dim the menu while in the escape state (cancel
                 preview). Gesture-only: IsFlickOutEscaped is never set for hotkey
                 menus, so hotkey summons are unaffected. 200ms fade matches the
                 window's dismiss fade rhythm. -->
            <Canvas.Style>
                <Style TargetType="Canvas">
                    <Setter Property="Opacity" Value="1"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFlickOutEscaped}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.6"
                                                         Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1"
                                                         Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Canvas.Style>

            <ItemsControl ItemsSource="{Binding Slots}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid RenderTransformOrigin="0.5,0.5"
                              Opacity="{Binding CurrentOpacity}">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="{Binding CurrentScale, FallbackValue=1}" ScaleY="{Binding CurrentScale, FallbackValue=1}"/>
                                    <TranslateTransform X="{Binding RenderOffsetX, FallbackValue=0}" Y="{Binding RenderOffsetY, FallbackValue=0}"/>
                                </TransformGroup>
                            </Grid.RenderTransform>

                            <!-- [E2E] AutomationId must live on the SlotOrb (the element
                                 with the custom UIA peer), mirroring the center slot below.
                                 On the wrapper Grid it is invisible to UIA: the peer's
                                 GetAutomationIdCore then falls back to the template root's
                                 x:Name ('OrbRoot'), so ring slots were unlocatable. -->
                            <controls:SlotOrb RenderTransformOrigin="0.5,0.5"
                                               AutomationProperties.AutomationId="{Binding SlotAutomationId}"
                                               IconKey="{Binding IconKey}"
                                               OrbImage="{Binding IconImage}"
                                               Label="{Binding Label}"
                                               IsActive="{Binding IsActive}"
                                               IsRecommended="{Binding IsRecommended}"
                                               Size="{Binding Size}"
                                               IsEnabled="{Binding IsEnabled}"
                                               BadgeCount="{Binding BadgeCount}"
                                               CustomFill="{Binding CustomFillBrush}"
                                               CustomStroke="{Binding CustomStrokeBrush}"
                                               CustomForeground="{Binding CustomForegroundBrush}"/>

                             <!-- 光学对齐负值:抵消圆点视觉溢出,由几何决定,不进间距刻度 -->
                             <Border HorizontalAlignment="Right"
                                     VerticalAlignment="Top"
                                     Margin="0,-6,-6,0"
                                     Style="{StaticResource SlotChipBorderStyle}"
                                     Background="{DynamicResource Theme.Orb.Chip.Background}"
                                     Padding="{StaticResource Pulsar.Pad.H8V2}"
                                     Visibility="{Binding ShowTypeBadge, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                                <TextBlock Text="{Binding TypeBadge}"
                                           Style="{StaticResource SlotValueChipTextStyle}">
                                    <!-- FontSize 跟随 SlotValueChipTextStyle（令牌 11px）；
                                         此前显式覆盖为 9px 属散值，已删除。 -->
                                    <TextBlock.Foreground>
                                        <MultiBinding Converter="{StaticResource SlotBrushConverter}" ConverterParameter="Type">
                                            <Binding Path="TypeToneKey"/>
                                            <Binding RelativeSource="{RelativeSource Self}"/>
                                        </MultiBinding>
                                    </TextBlock.Foreground>
                                </TextBlock>
                             </Border>
                         </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- [New] Center Container for Morphing Effect (Simplified) -->
            <Grid Width="500" Height="500" Canvas.Left="0" Canvas.Top="0">
                
                <!-- Shared Background Container -->
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    
                    <!-- 1. Center Orb Wrapper (Normal State).
                         Scale/opacity/offset are VM-driven so submenu transitions can
                         morph the center node continuously instead of swapping content. -->
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                          RenderTransformOrigin="0.5,0.5"
                          Opacity="{Binding CenterSlot.CurrentOpacity}">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="{Binding CenterSlot.CurrentScale}"
                                                ScaleY="{Binding CenterSlot.CurrentScale}"/>
                                <TranslateTransform X="{Binding CenterSlot.AnimationOffsetX}"
                                                    Y="{Binding CenterSlot.AnimationOffsetY}"/>
                            </TransformGroup>
                        </Grid.RenderTransform>
                        
                        <!-- Normal slot orb (overlay/fallback) -->
                        <controls:SlotOrb 
                            DataContext="{Binding CenterSlot}"
                            AutomationProperties.AutomationId="{Binding SlotAutomationId}"
                            Size="{Binding Size}"
                            IsActive="{Binding IsActive}"
                            IsRecommended="{Binding IsRecommended}"
                            Label="{Binding Label}"
                            IconKey="{Binding IconKey}"
                            OrbImage="{Binding IconImage}"
                            BadgeCount="{Binding BadgeCount}"
                            CustomFill="{Binding CustomFillBrush}"
                            CustomStroke="{Binding CustomStrokeBrush}"
                             CustomForeground="{Binding CustomForegroundBrush}">
                              <controls:SlotOrb.Style>
                                <Style TargetType="controls:SlotOrb">
                                    <!-- Default: Transparent (Preview Visible) -->
                                    <Setter Property="IsTransparent" Value="True"/>
                                    <!-- [New] Hide Content if Preview is Visible -->
                                    <Setter Property="IsContentVisible" Value="False"/>
                                     
                                     <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.HasPreview, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                            <Setter Property="IsTransparent" Value="False"/>
                                            <Setter Property="IsContentVisible" Value="True"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                              </controls:SlotOrb.Style>
                        </controls:SlotOrb>

                        <!-- [New] Center Preview Layers (Fade & Scale) -->
                        <Grid IsHitTestVisible="False">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Opacity" Value="0"/>
                                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.8" ScaleY="0.8"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPreview}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <!-- 回弹缓动（BackEase）推迟终态感知，与肌肉记忆定位冲突，改指数缓动 -->
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1"
                                                                         Duration="{StaticResource Pulsar.Duration.Normal}"
                                                                         EasingFunction="{StaticResource Pulsar.Easing.Standard}"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1"
                                                                         Duration="{StaticResource Pulsar.Duration.Normal}"
                                                                         EasingFunction="{StaticResource Pulsar.Easing.Standard}"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1"
                                                                         Duration="{StaticResource Pulsar.Duration.Normal}"
                                                                         EasingFunction="{StaticResource Pulsar.Easing.Standard}"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0"
                                                                         Duration="{StaticResource Pulsar.Duration.Fast}"
                                                                         EasingFunction="{StaticResource Pulsar.Easing.Standard}"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.8"
                                                                         Duration="{StaticResource Pulsar.Duration.Fast}"
                                                                         EasingFunction="{StaticResource Pulsar.Easing.Standard}"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.8"
                                                                         Duration="{StaticResource Pulsar.Duration.Fast}"
                                                                         EasingFunction="{StaticResource Pulsar.Easing.Standard}"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasLivePreview}" Value="True">
                                            <Setter Property="Opacity" Value="0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Ellipse Width="{Binding CenterSlot.Size, RelativeSource={RelativeSource AncestorType=Window}}"
                                     Height="{Binding CenterSlot.Size, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding CenterPreviewImage}" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                                <Ellipse.Stroke>
                                    <SolidColorBrush Color="White" Opacity="0.2"/>
                                </Ellipse.Stroke>
                                <Ellipse.StrokeThickness>1</Ellipse.StrokeThickness>
                            </Ellipse>
                        </Grid>

                    </Grid>
                </Grid>
            </Grid>

            <!-- [Optimized] Dynamic Title with Hard Shadow (No DropShadowEffect for Performance) -->

            <!-- [New] Halo Dimmer Background (Simulated Frost) -->
            <!-- Placed BEHIND the center orb but visually it serves as a backdrop. 
                 Actually, it should be at ZIndex -1 relative to Slots if we want Slots on top?
                 Currently Slots are drawn first (Z-Order bottom), then Center Container.
                 Wait, ItemsControl (Slots) is defined BEFORE Center Container. So Slots are BELOW Center Container?
                 Yes.
                 To put this BEHIND everything, we should put it as the FIRST child of Canvas. -->

            <!-- [Optimized] Dynamic Title with Hard Shadow (No DropShadowEffect for Performance).
                 A local translucent scrim keeps the white title readable on both light and
                 dark desktop backgrounds after the wheel-level gradient scrim was removed. -->
            <Grid Canvas.Left="0" 
                  Canvas.Top="{Binding TitleTopOffset}" 
                  Width="500"
                  IsHitTestVisible="False">
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Padding="{StaticResource Pulsar.Pad.H12V4}"
                        CornerRadius="{StaticResource Pulsar.Radius.MD}"
                        Background="{DynamicResource Theme.Radial.Title.Scrim}"
                        Visibility="{Binding DynamicTitle, Converter={StaticResource StringEmptyToVisibilityConverter}}">
                    <Grid>
                        <!-- Shadow Layer (Offset 1px) -->
                        <TextBlock Text="{Binding DynamicTitle, NotifyOnTargetUpdated=True}"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource Theme.Radial.Title.Shadow}"
                                   FontSize="{StaticResource Pulsar.Type.Subtitle}"
                                   FontWeight="SemiBold"
                                   Opacity="0.5"
                                   Margin="{StaticResource Pulsar.Thk.L2T2}">
                            <TextBlock.Triggers>
                                <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="0.5"
                                                         Duration="{StaticResource Pulsar.Duration.Fast}"
                                                         EasingFunction="{StaticResource Pulsar.Easing.Standard}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </TextBlock.Triggers>
                        </TextBlock>

                        <!-- Foreground Layer -->
                        <TextBlock Text="{Binding DynamicTitle, NotifyOnTargetUpdated=True}"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource Theme.Radial.Title.Foreground}"
                                   FontSize="{StaticResource Pulsar.Type.Subtitle}"
                                   FontWeight="SemiBold">
                            <TextBlock.Triggers>
                                <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.4" To="1"
                                                         Duration="{StaticResource Pulsar.Duration.Fast}"
                                                         EasingFunction="{StaticResource Pulsar.Easing.Standard}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </TextBlock.Triggers>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>
        </Canvas>
    </Canvas>
</Window>
