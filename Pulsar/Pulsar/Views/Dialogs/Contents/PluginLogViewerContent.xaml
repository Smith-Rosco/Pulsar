<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:lex="clr-namespace:Pulsar.Core.Localization"
             xmlns:controls="clr-namespace:Pulsar.Views.Controls"
             xmlns:converters="clr-namespace:Pulsar.Core.Converters"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="760">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Pulsar;component/Styles/ButtonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:StringEmptyToVisibilityConverter x:Key="StringEmptyToVisibilityConverter"/>
            <converters:LogLevelToColorConverter x:Key="LogLevelToColorConverter"/>
            <converters:UtcToLocalTimeConverter x:Key="UtcToLocalTimeConverter"/>
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisConverter"/>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Filters -->
        <Grid Grid.Row="0" Margin="{StaticResource Pulsar.Gap.Bottom.MD}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding LevelOptions}"
                      SelectedItem="{Binding SelectedLevelOption, Mode=TwoWay}"
                      DisplayMemberPath="Label"
                      Margin="{StaticResource Pulsar.Gap.Right.MD}"/>

            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding TimeRangeOptions}"
                      SelectedItem="{Binding SelectedTimeRangeOption, Mode=TwoWay}"
                      DisplayMemberPath="Label"
                      Margin="{StaticResource Pulsar.Gap.Right.MD}"/>

            <ui:TextBox Grid.Column="2"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="{lex:Locale PluginLogViewer.SearchPlaceholder}"
                        Icon="{ui:SymbolIcon Search24}"
                        Margin="{StaticResource Pulsar.Gap.Right.MD}"/>

            <ui:Button Grid.Column="3"
                       Content="{lex:Locale PluginLogViewer.Export}"
                       Command="{Binding ExportLogsCommand}"
                       Style="{StaticResource PulsarSecondaryButtonStyle}"
                       Icon="{ui:SymbolIcon ArrowDownload24}"/>
        </Grid>

        <!-- Stats -->
        <Grid Grid.Row="1" Margin="{StaticResource Pulsar.Gap.Bottom.MD}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Border Background="{DynamicResource ControlFillColorTertiaryBrush}" CornerRadius="{StaticResource Pulsar.Radius.MD}" Padding="{StaticResource Pulsar.Pad.H12V4}" Margin="{StaticResource Pulsar.Gap.Right.SM}">
                    <TextBlock FontSize="{StaticResource Pulsar.Type.Caption}" Opacity="0.9"><Run Text="{lex:Locale PluginLogViewer.Total}"/><Run Text="{Binding TotalCount, Mode=OneWay}"/></TextBlock>
                </Border>
                <Border Background="{DynamicResource ControlFillColorTertiaryBrush}" CornerRadius="{StaticResource Pulsar.Radius.MD}" Padding="{StaticResource Pulsar.Pad.H12V4}" Margin="{StaticResource Pulsar.Gap.Right.SM}">
                    <TextBlock FontSize="{StaticResource Pulsar.Type.Caption}" Opacity="0.9"><Run Text="{lex:Locale PluginLogViewer.Debug}"/><Run Text="{Binding DebugCount, Mode=OneWay}"/></TextBlock>
                </Border>
                <Border Background="{DynamicResource ControlFillColorTertiaryBrush}" CornerRadius="{StaticResource Pulsar.Radius.MD}" Padding="{StaticResource Pulsar.Pad.H12V4}" Margin="{StaticResource Pulsar.Gap.Right.SM}">
                    <TextBlock FontSize="{StaticResource Pulsar.Type.Caption}" Opacity="0.9"><Run Text="{lex:Locale PluginLogViewer.Info}"/><Run Text="{Binding InfoCount, Mode=OneWay}"/></TextBlock>
                </Border>
                <Border Background="{DynamicResource ControlFillColorTertiaryBrush}" CornerRadius="{StaticResource Pulsar.Radius.MD}" Padding="{StaticResource Pulsar.Pad.H12V4}" Margin="{StaticResource Pulsar.Gap.Right.SM}">
                    <TextBlock FontSize="{StaticResource Pulsar.Type.Caption}" Opacity="0.9"><Run Text="{lex:Locale PluginLogViewer.Warning}"/><Run Text="{Binding WarningCount, Mode=OneWay}"/></TextBlock>
                </Border>
                <Border Background="{DynamicResource ControlFillColorTertiaryBrush}" CornerRadius="{StaticResource Pulsar.Radius.MD}" Padding="{StaticResource Pulsar.Pad.H12V4}" Margin="{StaticResource Pulsar.Gap.Right.SM}">
                    <TextBlock FontSize="{StaticResource Pulsar.Type.Caption}" Opacity="0.9"><Run Text="{lex:Locale PluginLogViewer.Error}"/><Run Text="{Binding ErrorCount, Mode=OneWay}"/></TextBlock>
                </Border>
                <Border Background="{DynamicResource ControlFillColorTertiaryBrush}" CornerRadius="{StaticResource Pulsar.Radius.MD}" Padding="{StaticResource Pulsar.Pad.H12V4}">
                    <TextBlock FontSize="{StaticResource Pulsar.Type.Caption}" Opacity="0.9"><Run Text="{lex:Locale PluginLogViewer.Critical}"/><Run Text="{Binding CriticalCount, Mode=OneWay}"/></TextBlock>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding TimeRangeLabel}" FontSize="{StaticResource Pulsar.Type.Caption}" Opacity="0.7" VerticalAlignment="Center" Margin="{StaticResource Pulsar.Gap.Right.MD}"/>
                <ui:Button Content="{lex:Locale PluginLogViewer.OpenFolder}"
                           Command="{Binding OpenLogFolderCommand}"
                           Style="{StaticResource PulsarSecondaryButtonStyle}"
                           Icon="{ui:SymbolIcon FolderOpen24}"/>
            </StackPanel>
        </Grid>

        <!-- Log list -->
        <Border Grid.Row="2"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource Pulsar.Radius.LG}"
                Padding="{StaticResource Pulsar.Pad.SM}">
            <Grid>
                <ListView ItemsSource="{Binding Logs}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding HasFilteredLogs, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="{StaticResource Pulsar.Pad.SM}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding Timestamp, Converter={StaticResource UtcToLocalTimeConverter}}"
                                           FontSize="{StaticResource Pulsar.Type.Caption}"
                                           Opacity="0.7"
                                           Margin="{StaticResource Pulsar.Gap.Right.MD}"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Level}"
                                           FontSize="{StaticResource Pulsar.Type.Caption}"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"
                                           Margin="{StaticResource Pulsar.Gap.Right.MD}"/>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding Message}"
                                               TextWrapping="Wrap"
                                               FontSize="{StaticResource Pulsar.Type.Body}"/>

                                    <TextBlock Text="{Binding Action, StringFormat=Action: {0}}"
                                               FontSize="{StaticResource Pulsar.Type.Caption}"
                                               Opacity="0.6"
                                               Visibility="{Binding Action, Converter={StaticResource StringEmptyToVisibilityConverter}}"/>

                                    <TextBlock Text="{Binding ExecutionId, StringFormat=ExecId: {0}}"
                                               FontSize="{StaticResource Pulsar.Type.Caption}"
                                               Opacity="0.6"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ExecutionId}"
                                               Visibility="{Binding ExecutionId, Converter={StaticResource StringEmptyToVisibilityConverter}}"/>

                                    <TextBlock Text="{Binding Exception}"
                                               TextWrapping="Wrap"
                                               FontSize="{StaticResource Pulsar.Type.Caption}"
                                               Opacity="0.6"
                                               MaxHeight="140"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Exception}"
                                               Visibility="{Binding Exception, Converter={StaticResource StringEmptyToVisibilityConverter}}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <controls:EmptyState Icon="DocumentText24"
                                     Title="{lex:Locale PluginLogViewer.NoLogs}"
                                     Hint="{lex:Locale PluginLogViewer.ExpandRange}"
                                     Visibility="{Binding HasFilteredLogs, Converter={StaticResource InverseBoolToVisConverter}}"/>

                <Grid Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                      Background="Transparent">
                    <ui:ProgressRing IsIndeterminate="True" Width="36" Height="36"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="{StaticResource Pulsar.Gap.Top.MD}">
            <TextBlock Text="{Binding TruncatedHint}"
                       FontSize="{StaticResource Pulsar.Type.Caption}"
                       Opacity="0.7"
                       VerticalAlignment="Center"
                       Margin="{StaticResource Pulsar.Gap.Right.MD}"
                       Visibility="{Binding TruncatedHint, Converter={StaticResource StringEmptyToVisibilityConverter}}"/>
            <TextBlock Text="{Binding FilteredCount, StringFormat=Showing: {0}}"
                       FontSize="{StaticResource Pulsar.Type.Caption}"
                       Opacity="0.7"
                       VerticalAlignment="Center"
                       Margin="{StaticResource Pulsar.Gap.Right.MD}"/>
            <ui:Button Content="{lex:Locale PluginLogViewer.LoadMore}"
                        Command="{Binding LoadMoreCommand}"
                        IsEnabled="{Binding CanLoadMore}"
                        Style="{StaticResource PulsarSecondaryButtonStyle}"
                        Icon="{ui:SymbolIcon MoreHorizontal24}"/>
        </StackPanel>
    </Grid>
</UserControl>
