<UserControl x:Class="Pulsar.Views.Dialogs.Contents.PluginSettingsDialogContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Pulsar.ViewModels.Settings"
             xmlns:ts="clr-namespace:Pulsar.Views.TemplateSelectors"
             xmlns:converters="clr-namespace:Pulsar.Core.Converters"
              xmlns:lex="clr-namespace:Pulsar.Core.Localization"
              mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="550">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Pulsar;component/Styles/ButtonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:StringEmptyToVisibilityConverter x:Key="StringEmptyToVisibilityConverter"/>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <DataTemplate x:Key="BooleanSettingTemplate" DataType="{x:Type vm:BooleanSettingViewModel}">
            <ui:CardControl Margin="{StaticResource Pulsar.Gap.Vertical.XS}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{Binding Label}" FontWeight="Medium"/>
                        <TextBlock Text="{Binding Description}" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   FontSize="{StaticResource Pulsar.Type.Body}" 
                                   TextWrapping="Wrap"
                                   Visibility="{Binding Description, Converter={StaticResource StringEmptyToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding ValidationMessage}"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   FontSize="{StaticResource Pulsar.Type.Caption}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasValidation, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   Margin="{StaticResource Pulsar.Gap.Top.XXS}"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding BoolValue, Mode=TwoWay}"/>
            </ui:CardControl>
        </DataTemplate>

        <DataTemplate x:Key="StringSettingTemplate" DataType="{x:Type vm:StringSettingViewModel}">
            <ui:CardControl Margin="{StaticResource Pulsar.Gap.Vertical.XS}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{Binding Label}" FontWeight="Medium"/>
                        <TextBlock Text="{Binding Description}" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   FontSize="{StaticResource Pulsar.Type.Body}" 
                                   TextWrapping="Wrap"
                                   Visibility="{Binding Description, Converter={StaticResource StringEmptyToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding ValidationMessage}"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   FontSize="{StaticResource Pulsar.Type.Caption}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasValidation, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   Margin="{StaticResource Pulsar.Gap.Top.XXS}"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:TextBox Text="{Binding StringValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                            Width="220"
                            HorizontalAlignment="Right"/>
            </ui:CardControl>
        </DataTemplate>

        <DataTemplate x:Key="SelectionSettingTemplate" DataType="{x:Type vm:SelectionSettingViewModel}">
             <ui:CardControl Margin="{StaticResource Pulsar.Gap.Vertical.XS}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{Binding Label}" FontWeight="Medium"/>
                        <TextBlock Text="{Binding Description}" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   FontSize="{StaticResource Pulsar.Type.Body}" 
                                   TextWrapping="Wrap"
                                   Visibility="{Binding Description, Converter={StaticResource StringEmptyToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding ValidationMessage}"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   FontSize="{StaticResource Pulsar.Type.Caption}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasValidation, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   Margin="{StaticResource Pulsar.Gap.Top.XXS}"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox ItemsSource="{Binding Options}" 
                          SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                          Width="220"
                          HorizontalAlignment="Right"/>
            </ui:CardControl>
        </DataTemplate>

        <DataTemplate x:Key="PathSettingTemplate" DataType="{x:Type vm:PathSettingViewModel}">
            <ui:CardControl Margin="{StaticResource Pulsar.Gap.Vertical.XS}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{Binding Label}" FontWeight="Medium"/>
                        <TextBlock Text="{Binding Description}" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   FontSize="{StaticResource Pulsar.Type.Body}" 
                                   TextWrapping="Wrap"
                                   Visibility="{Binding Description, Converter={StaticResource StringEmptyToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding ValidationMessage}"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   FontSize="{StaticResource Pulsar.Type.Caption}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasValidation, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   Margin="{StaticResource Pulsar.Gap.Top.XXS}"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Grid.Column="0" 
                                Text="{Binding PathValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="{lex:Locale Dialog.PluginSettings.EnterPathPlaceholder}"
                                HorizontalAlignment="Right"/>
                    <ui:Button Grid.Column="1"
                               Icon="{ui:SymbolIcon FolderOpen24}"
                                ToolTip="{lex:Locale Dialog.PluginSettings.Browse}"
                               Style="{StaticResource PulsarIconButtonStyle}"
                               Margin="{StaticResource Pulsar.Gap.Left.XS}"
                               Tag="{Binding}"
                               Click="BrowsePathButton_Click"/>
                </Grid>
            </ui:CardControl>
        </DataTemplate>

        <DataTemplate x:Key="IntegerSettingTemplate" DataType="{x:Type vm:IntegerSettingViewModel}">
            <ui:CardControl Margin="{StaticResource Pulsar.Gap.Vertical.XS}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{Binding Label}" FontWeight="Medium"/>
                        <TextBlock Text="{Binding Description}" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   FontSize="{StaticResource Pulsar.Type.Body}" 
                                   TextWrapping="Wrap"
                                   Visibility="{Binding Description, Converter={StaticResource StringEmptyToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding ValidationMessage}"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   FontSize="{StaticResource Pulsar.Type.Caption}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasValidation, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   Margin="{StaticResource Pulsar.Gap.Top.XXS}"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:NumberBox Value="{Binding IntValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              SpinButtonPlacementMode="Compact"
                              Width="140"
                              HorizontalAlignment="Right"
                              Minimum="{Binding Definition.MinValue}"
                              Maximum="{Binding Definition.MaxValue}"/>
            </ui:CardControl>
        </DataTemplate>

        <DataTemplate x:Key="SecretSettingTemplate" DataType="{x:Type vm:SecretSettingViewModel}">
            <ui:CardControl Margin="{StaticResource Pulsar.Gap.Vertical.XS}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{Binding Label}" FontWeight="Medium"/>
                        <TextBlock Text="{Binding Description}" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   FontSize="{StaticResource Pulsar.Type.Body}" 
                                   TextWrapping="Wrap"
                                   Visibility="{Binding Description, Converter={StaticResource StringEmptyToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding ValidationMessage}"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   FontSize="{StaticResource Pulsar.Type.Caption}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasValidation, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   Margin="{StaticResource Pulsar.Gap.Top.XXS}"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:PasswordBox Password="{Binding SecretValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Width="220"
                                HorizontalAlignment="Right"
                                PlaceholderText="{lex:Locale Dialog.PluginSettings.EnterSecretPlaceholder}"/>
            </ui:CardControl>
        </DataTemplate>

        <DataTemplate x:Key="MultiSelectSettingTemplate" DataType="{x:Type vm:MultiSelectSettingViewModel}">
            <ui:CardControl Margin="{StaticResource Pulsar.Gap.Vertical.XS}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{Binding Label}" FontWeight="Medium"/>
                        <TextBlock Text="{Binding Description}" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   FontSize="{StaticResource Pulsar.Type.Body}" 
                                   TextWrapping="Wrap"
                                   Visibility="{Binding Description, Converter={StaticResource StringEmptyToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding ValidationMessage}"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   FontSize="{StaticResource Pulsar.Type.Caption}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasValidation, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   Margin="{StaticResource Pulsar.Gap.Top.XXS}"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Vertical" HorizontalAlignment="Right" Width="260">
                    <TextBlock Text="{lex:Locale Dialog.PluginSettings.ClickToggle}" 
                               FontSize="{StaticResource Pulsar.Type.Caption}" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="{StaticResource Pulsar.Gap.Bottom.SM}"/>
                    <ItemsControl ItemsSource="{Binding OptionItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Content="{Binding Name}"
                                              Margin="{StaticResource Pulsar.Thk.T2R4B2}"
                                              Padding="{StaticResource Pulsar.Pad.H8V4}"
                                              FontSize="{StaticResource Pulsar.Type.Caption}"
                                              Cursor="Hand">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorAccentBackground3}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{lex:Locale Dialog.PluginSettings.EnterManually}" 
                               FontSize="{StaticResource Pulsar.Type.Caption}" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="{StaticResource Pulsar.Thk.T8B2}"/>
                    <ui:TextBox Text="{Binding CommaSeparatedValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="{lex:Locale Dialog.PluginSettings.CommaSeparatedPlaceholder}"/>
                </StackPanel>
            </ui:CardControl>
        </DataTemplate>

        <ts:PluginSettingTemplateSelector x:Key="SettingSelector"
                                          BooleanTemplate="{StaticResource BooleanSettingTemplate}"
                                          StringTemplate="{StaticResource StringSettingTemplate}"
                                          SelectionTemplate="{StaticResource SelectionSettingTemplate}"
                                          PathTemplate="{StaticResource PathSettingTemplate}"
                                          IntegerTemplate="{StaticResource IntegerSettingTemplate}"
                                          SecretTemplate="{StaticResource SecretSettingTemplate}"
                                          MultiSelectTemplate="{StaticResource MultiSelectSettingTemplate}"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="{StaticResource Pulsar.Gap.Bottom.LG}">
            <TextBlock Text="{Binding PluginName}" FontSize="{StaticResource Pulsar.Type.Title}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding PluginDescription}" 
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                       TextWrapping="Wrap"
                       Margin="{StaticResource Pulsar.Gap.Top.XS}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Settings}"
                          ItemTemplateSelector="{StaticResource SettingSelector}"/>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="{StaticResource Pulsar.Gap.Top.LG}">
            <ui:Button Content="{lex:Locale Dialog.PluginSettings.WindowInspector}"
                       Style="{StaticResource PulsarSecondaryButtonStyle}"
                       Command="{Binding OpenWindowInspectorCommand}"
                       Visibility="{Binding IsWindowInspectorVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                       Margin="{StaticResource Pulsar.Gap.Right.SM}"/>
            <ui:Button Content="{lex:Locale Dialog.PluginSettings.ResetDefaults}"
                       Style="{StaticResource PulsarSecondaryButtonStyle}"
                       Command="{Binding ResetToDefaultsCommand}"
                       Margin="{StaticResource Pulsar.Gap.Right.SM}"/>
            <ui:Button Content="{lex:Locale Dialog.PluginSettings.Cancel}"
                       Style="{StaticResource PulsarSecondaryButtonStyle}"
                       Command="{Binding CancelCommand}"
                       Margin="{StaticResource Pulsar.Gap.Right.SM}"/>
            <ui:Button Content="{lex:Locale Dialog.PluginSettings.Save}"
                       Style="{StaticResource PulsarPrimaryButtonStyle}"
                       Command="{Binding SaveCommand}"
                       IsEnabled="{Binding CanSave}"/>
        </StackPanel>
    </Grid>
</UserControl>
