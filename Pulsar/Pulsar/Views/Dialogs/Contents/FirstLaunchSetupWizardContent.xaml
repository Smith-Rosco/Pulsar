<UserControl x:Class="Pulsar.Views.Dialogs.Contents.FirstLaunchSetupWizardContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:Pulsar.ViewModels.Dialogs"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             MinWidth="520"
             MinHeight="380"
             d:DataContext="{d:DesignInstance Type=viewmodels:FirstLaunchSetupWizardViewModel}">

    <UserControl.Resources>
        <ResourceDictionary>
            <Style x:Key="FeatureCardStyle" TargetType="Border">
                <Setter Property="Padding" Value="16"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Language picker -->
        <Border Grid.Row="0"
                Padding="{StaticResource Pulsar.Pad.H8V4}"
                CornerRadius="{StaticResource Pulsar.Radius.MD}"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                BorderThickness="1"
                HorizontalAlignment="Right">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🌐" FontSize="{StaticResource Pulsar.Type.Caption}" VerticalAlignment="Center" Margin="{StaticResource Pulsar.Gap.Right.XS}"/>
                <ComboBox ItemsSource="{Binding SupportedLanguages}"
                          SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName"
                          FontSize="{StaticResource Pulsar.Type.Caption}"
                          MinWidth="100"/>
            </StackPanel>
        </Border>

        <!-- Welcome content -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="{StaticResource Pulsar.Gap.Top.XL}">
            <StackPanel>

                <!-- Title -->
                <TextBlock Text="{Binding SetupTitle}"
                           FontSize="{StaticResource Pulsar.Type.Title}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Margin="{StaticResource Pulsar.Gap.Bottom.SM}"/>

                <!-- Description -->
                <TextBlock Text="{Binding Description}"
                           TextWrapping="Wrap"
                           FontSize="{StaticResource Pulsar.Type.Body}"
                           LineHeight="20"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="{StaticResource Pulsar.Gap.Bottom.SM}"/>

                <!-- Usage scenario picker (office-automation scenarios lead, per pillar narrative) -->
                <StackPanel Margin="{StaticResource Pulsar.Gap.Bottom.LG}">
                    <TextBlock Text="{Binding UsageScenarioLabel}"
                               FontSize="{StaticResource Pulsar.Type.Body}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="{StaticResource Pulsar.Gap.Bottom.XS}"/>
                    <ComboBox ItemsSource="{Binding UsageOptions}"
                              SelectedItem="{Binding SelectedUsageOption, Mode=TwoWay}"
                              DisplayMemberPath="Title"
                              MinWidth="260"
                              HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding SelectedUsageOption.Description}"
                               TextWrapping="Wrap"
                               FontSize="{StaticResource Pulsar.Type.Caption}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="{StaticResource Pulsar.Gap.Top.XXS}"/>
                </StackPanel>

                <!-- Feature Intro -->
                <TextBlock Text="{Binding FeatureIntro}"
                           FontSize="{StaticResource Pulsar.Type.Body}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="{StaticResource Pulsar.Gap.Bottom.LG}"/>

                <!-- Feature Cards -->
                <StackPanel>
                    <!-- Switch Mode -->
                    <Border Style="{StaticResource FeatureCardStyle}"
                            Margin="{StaticResource Pulsar.Gap.Bottom.MD}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40"
                                    CornerRadius="{StaticResource Pulsar.Radius.XL}"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                                    BorderThickness="1"
                                    Margin="{StaticResource Pulsar.Gap.Right.LG}">
                                <TextBlock Text="🔄"
                                           FontSize="{StaticResource Pulsar.Type.Title}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FeatureSwitchModeTitle}"
                                           FontSize="{StaticResource Pulsar.Type.Subtitle}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="{Binding FeatureSwitchModeDesc}"
                                           FontSize="{StaticResource Pulsar.Type.Body}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="{StaticResource Pulsar.Gap.Top.XXS}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Command Mode -->
                    <Border Style="{StaticResource FeatureCardStyle}"
                            Margin="{StaticResource Pulsar.Gap.Bottom.LG}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40"
                                    CornerRadius="{StaticResource Pulsar.Radius.XL}"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                                    BorderThickness="1"
                                    Margin="{StaticResource Pulsar.Gap.Right.LG}">
                                <!-- Emoji ⚡ 是彩色位图，与 Fluent 单色矢量图标混用渲染口径不一致，改 SymbolIcon -->
                                <ui:SymbolIcon Symbol="Flash24"
                                               FontSize="{StaticResource Pulsar.Type.Title}"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FeatureCommandModeTitle}"
                                           FontSize="{StaticResource Pulsar.Type.Subtitle}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="{Binding FeatureCommandModeDesc}"
                                           FontSize="{StaticResource Pulsar.Type.Body}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="{StaticResource Pulsar.Gap.Top.XXS}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Footer -->
                <TextBlock Text="{Binding SetupFooter}"
                           TextWrapping="Wrap"
                           FontSize="{StaticResource Pulsar.Type.Body}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
