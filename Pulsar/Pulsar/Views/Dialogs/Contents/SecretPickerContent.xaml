<UserControl x:Class="Pulsar.Views.Dialogs.Contents.SecretPickerContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:lex="clr-namespace:Pulsar.Core.Localization"
             xmlns:controls="clr-namespace:Pulsar.Views.Controls"
             xmlns:dialogs="clr-namespace:Pulsar.ViewModels.Dialogs"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="400"
             d:DataContext="{d:DesignInstance Type=dialogs:SecretPickerViewModel}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Pulsar;component/Styles/ButtonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="{StaticResource Pulsar.Gap.Bottom.MD}">
            <TextBlock Text="{lex:Locale Dialog.SecretPicker.SelectSecret}"
                       FontSize="{StaticResource Pulsar.Type.Subtitle}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="{lex:Locale Dialog.SecretPicker.PickHint}"
                       Margin="{StaticResource Pulsar.Gap.Top.XS}"
                       FontSize="{StaticResource Pulsar.Type.Body}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <ListView ItemsSource="{Binding Secrets}"
                      SelectedItem="{Binding SelectedSecret}"
                      Background="Transparent"
                      BorderThickness="1"
                      BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                      Margin="{StaticResource Pulsar.Gap.Bottom.LG}">
                <ListView.Style>
                    <Style TargetType="ListView">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasNoSecrets}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.Style>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="10"/>
                        <EventSetter Event="MouseDoubleClick" Handler="ListViewItem_MouseDoubleClick"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="{Binding Label}"
                                           FontWeight="SemiBold"
                                           FontSize="{StaticResource Pulsar.Type.Subtitle}"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="{Binding Account}"
                                           Margin="{StaticResource Pulsar.Gap.Top.XS}"
                                           FontSize="{StaticResource Pulsar.Type.Body}"
                                           Opacity="0.75"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Margin="{StaticResource Pulsar.Gap.Left.MD}"
                                       VerticalAlignment="Center"
                                       FontSize="{StaticResource Pulsar.Type.Body}"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="{lex:Locale Dialog.SecretPicker.DoubleClickHint}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <controls:EmptyState Icon="Key24"
                                 Title="{lex:Locale Dialog.SecretPicker.NoSecrets}"
                                 Hint="{lex:Locale Dialog.SecretPicker.CreateHint}"
                                 ActionText="{lex:Locale Dialog.SecretPicker.CreateSecret}"
                                 ActionIcon="Add24"
                                 ActionButtonStyle="{StaticResource PulsarPrimaryButtonStyle}"
                                 ActionCommand="{Binding AddNewCommand}"
                                 HasBorder="True"
                                 Visibility="{Binding HasNoSecrets, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ui:Button Grid.Column="0"
                       Content="{lex:Locale Dialog.SecretPicker.CreateNew}"
                       HorizontalAlignment="Left"
                       Style="{StaticResource PulsarSecondaryButtonStyle}"
                       Command="{Binding AddNewCommand}"/>

            <ui:Button Grid.Column="1"
                       Margin="{StaticResource Pulsar.Gap.Left.MD}"
                       Content="{lex:Locale Dialog.SecretPicker.Edit}"
                       Style="{StaticResource PulsarSecondaryButtonStyle}"
                       Command="{Binding EditCommand}"
                       CommandParameter="{Binding SelectedSecret}"/>

            <ui:Button Grid.Column="2"
                       Margin="{StaticResource Pulsar.Gap.Left.MD}"
                       Content="{lex:Locale Dialog.SecretPicker.Delete}"
                       Style="{StaticResource PulsarDangerButtonStyle}"
                       Command="{Binding DeleteCommand}"
                       CommandParameter="{Binding SelectedSecret}"/>

            <ui:Button Grid.Column="3"
                       Margin="{StaticResource Pulsar.Gap.Left.MD}"
                       Content="{lex:Locale Dialog.SecretPicker.UseSelected}"
                       Style="{StaticResource PulsarPrimaryButtonStyle}"
                       Command="{Binding SelectCommand}"
                       CommandParameter="{Binding SelectedSecret}"/>
        </Grid>

    </Grid>
</UserControl>
