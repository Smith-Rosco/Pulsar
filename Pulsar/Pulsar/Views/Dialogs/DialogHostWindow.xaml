<ui:FluentWindow x:Class="Pulsar.Views.Dialogs.DialogHostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:Pulsar.Views.Dialogs"
        xmlns:viewmodels="clr-namespace:Pulsar.ViewModels"
        xmlns:dialogs="clr-namespace:Pulsar.ViewModels.Dialogs"
        xmlns:contents="clr-namespace:Pulsar.Views.Dialogs.Contents"
        xmlns:enums="clr-namespace:Pulsar.Models.Enums"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="450" Width="600"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Pulsar;component/Styles/ButtonStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Pulsar;component/Themes/DialogTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <Style x:Key="PulsarTertiaryDialogButtonStyle"
                   TargetType="ui:Button"
                   BasedOn="{StaticResource PulsarSecondaryButtonStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding UseDangerStyleForTertiary}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Theme.Destructive}"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Destructive}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>


    <Border Background="{DynamicResource Theme.Window.Background}"
            BorderBrush="{DynamicResource Theme.Border.Brush}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Content -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <ui:TitleBar Title="{Binding Title}"
                         Foreground="{DynamicResource Theme.Window.Foreground}"
                          Grid.Row="0"
                          ShowMaximize="{Binding ShowMaximizeButton, RelativeSource={RelativeSource AncestorType=Window}}"
                          ShowMinimize="{Binding ShowMaximizeButton, RelativeSource={RelativeSource AncestorType=Window}}"/>

            <!-- Content -->
            <ContentPresenter Grid.Row="1"
                              Margin="18,12,18,14"
                              Content="{Binding Content}"/>

            <!-- Footer -->
            <Border Grid.Row="2"
                    Background="{DynamicResource Theme.Control.Background}"
                    Padding="16,10"
                    CornerRadius="0,0,8,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Tertiary Button (e.g., "Don't Save" or "No" in 3-button dialogs) -->
                    <ui:Button Content="{Binding TertiaryButtonText}"
                               Visibility="{Binding IsTertiaryButtonVisible, Converter={StaticResource BoolToVis}}"
                               Command="{Binding CloseCommand}"
                               Style="{StaticResource PulsarTertiaryDialogButtonStyle}"
                               Margin="0,0,10,0">
                        <ui:Button.CommandParameter>
                            <enums:DialogResult>No</enums:DialogResult>
                        </ui:Button.CommandParameter>
                    </ui:Button>

                    <!-- Secondary Button (e.g., "Cancel" or "Back" in wizard mode) -->
                    <ui:Button Content="{Binding SecondaryButtonText}"
                               Visibility="{Binding IsSecondaryButtonVisible, Converter={StaticResource BoolToVis}}"
                               Style="{StaticResource PulsarSecondaryButtonStyle}"
                               Margin="0,0,10,0">
                        <ui:Button.Command>
                            <Binding>
                                <Binding.Path>WizardSecondaryCommand</Binding.Path>
                            </Binding>
                        </ui:Button.Command>
                    </ui:Button>
                    <!-- (non-wizard secondary handled via WizardSecondaryCommand delegating to Close) -->

                    <!-- Primary Button (e.g., "OK"/"Next"/"Confirm" in wizard mode) -->
                    <ui:Button Content="{Binding PrimaryButtonText}"
                               Visibility="{Binding IsPrimaryButtonVisible, Converter={StaticResource BoolToVis}}"
                               Style="{StaticResource PulsarPrimaryButtonStyle}"
                               Command="{Binding WizardPrimaryCommand}"
                               IsDefault="True"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</ui:FluentWindow>
