<ui:FluentWindow x:Class="Pulsar.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:converters="clr-namespace:Pulsar.Core.Converters"
        xmlns:lex="clr-namespace:Pulsar.Core.Localization"
        xmlns:tutorial="clr-namespace:Pulsar.Features.Tutorial.Helpers"
        mc:Ignorable="d"
        Title="{lex:Locale SettingsWindow.Title}" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        tutorial:TutorialMarker.Id="SettingsWindow">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Pulsar;component/Styles/ButtonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:StringEmptyToVisibilityConverter x:Key="StringEmptyToVis"/>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <DropShadowEffect x:Key="DropShadowEffect" BlurRadius="20" ShadowDepth="4" Direction="270" Color="Black" Opacity="0.3"/>

            <!-- 临时页（动态标签页）导航项模板（openspec 2026-09-08-dynamic-settings-tabs）：
                 斜体标题 + hover 关闭钮（贴整个 Tab 最右侧：item HorizontalContentAlignment=Stretch
                 使本 Grid 铺满行宽；文本列 * 截断，按钮列 Auto 靠右，互不遮挡）。
                 关闭钮 Tag 绑定页面 id，供 code-behind 回收；AutomationId 供 E2E 定位。 -->
            <DataTemplate x:Key="TransientNavItemContentTemplate">
                <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding}"
                               FontStyle="Italic"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Margin="0,0,6,0"/>
                    <Button Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Padding="2"
                            Margin="0,0,2,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Tag="{Binding Tag, RelativeSource={RelativeSource AncestorType=ui:NavigationViewItem}}"
                            Click="TransientTabClose_Click"
                            ToolTip="{lex:Locale SettingsWindow.CloseTab}"
                            AutomationProperties.AutomationId="Pulsar.Settings.NavCloseTab">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Opacity" Value="0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ui:NavigationViewItem}}" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <ui:SymbolIcon Symbol="Dismiss16" FontSize="12"/>
                    </Button>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Title="{lex:Locale SettingsWindow.Title}" Grid.Row="0"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="NavPaneGrid" Grid.Column="0">
                <ui:NavigationView x:Name="RootNavigation"
                                   AutomationProperties.AutomationId="Pulsar.Settings.NavView"
                                   PaneDisplayMode="Left"
                                   IsPaneOpen="True"
                                   OpenPaneLength="250"
                                   IsBackButtonVisible="Collapsed"
                                   KeyboardNavigation.DirectionalNavigation="Contained">
                    <ui:NavigationView.Resources>
                        <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="Transparent"/>
                    </ui:NavigationView.Resources>

                    <!-- 保存操作回到侧边栏底部（2026-09-08 用户决策）：
                         UX_REFACTOR_PROPOSAL [P1] 曾将其上移至 TitleBar（c5c3592），
                         经复盘用户偏好原位，现回退至 FooterMenuItems。
                         未保存状态沿用 InfoBadge 小红点，颜色改用 Fluent 令牌
                         SystemFillColorCautionBrush（原为硬编码 #E74856）。 -->
                    <ui:NavigationView.FooterMenuItems>
                        <ui:NavigationViewItem
                            AutomationProperties.AutomationId="Pulsar.Settings.SaveChangesButton"
                            AutomationProperties.Name="{lex:Locale SettingsWindow.SaveChanges}"
                            Content="{lex:Locale SettingsWindow.SaveChanges}"
                            Icon="{ui:SymbolIcon Save24}"
                            Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            ToolTip="{lex:Locale SettingsWindow.SaveChangesTooltip}">
                            <ui:NavigationViewItem.InfoBadge>
                                <ui:InfoBadge>
                                    <ui:InfoBadge.Template>
                                        <ControlTemplate TargetType="ui:InfoBadge">
                                            <Ellipse Width="8" Height="8"
                                                     Fill="{DynamicResource SystemFillColorCautionBrush}"
                                                     Visibility="{Binding DataContext.HasUnsavedChanges, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                        </ControlTemplate>
                                    </ui:InfoBadge.Template>
                                </ui:InfoBadge>
                            </ui:NavigationViewItem.InfoBadge>
                        </ui:NavigationViewItem>
                    </ui:NavigationView.FooterMenuItems>
                </ui:NavigationView>

                <Canvas IsHitTestVisible="False">
                    <Rectangle x:Name="NavIndicator"
                               Width="3"
                               Fill="{DynamicResource AccentFillColorDefaultBrush}"
                               RadiusX="1.5" RadiusY="1.5"
                               IsHitTestVisible="False"
                               Visibility="Collapsed"/>
                </Canvas>
            </Grid>

            <Frame x:Name="RootFrame"
                   Grid.Column="1"
                   Margin="{StaticResource Pulsar.Pad.XXL}"
                   NavigationUIVisibility="Hidden"/>

            <ui:SnackbarPresenter x:Name="MainSnackbarPresenter"
                                  Grid.Column="1"
                                  VerticalAlignment="Bottom"
                                  HorizontalAlignment="Right"
                                  Margin="{StaticResource Pulsar.Thk.R20B20}"/>
        </Grid>
    </Grid>
</ui:FluentWindow>
